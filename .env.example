# Local only. Copy to .env and fill in. Never commit .env or real tokens.

# --- Local admin (npm run admin + npm run dev) ---
ADMIN_PASSWORD=
PUBLIC_ADMIN_URL=http://127.0.0.1:8787
# ADMIN_PORT=8787

# --- Shop waitlist (optional; also set on Pages for production) ---
PUBLIC_FORMSPREE_ID=

# =============================================================================
# Cloudflare Pages → sashabookandbrush → Settings → Variables and secrets
# → Production. Trigger a new deploy after changing these.
# =============================================================================
#
# GitHub (admin saves + Goodreads sync log on Overview)
# ADMIN_GITHUB_TOKEN=
# GITHUB_REPO=GeertClaes/sashabookandbrush
# GITHUB_BRANCH=main
#
# Cloudflare Access (Google login for /admin)
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=
# ADMIN_EMAILS=sasha@gmail.com,you@gmail.com
#
# Overview rebuild status (optional)
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_PAGES_PROJECT=sashabookandbrush
#
# Shop waitlist on the live site (optional)
# PUBLIC_FORMSPREE_ID=
#
# =============================================================================
# Cron Worker secret (not Pages env vars)
#   npx wrangler secret put CLOUDFLARE_PAGES_DEPLOY_HOOK --config workers/rebuild-pages/wrangler.toml
# =============================================================================
# CLOUDFLARE_PAGES_DEPLOY_HOOK=
