{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".astro/**"],
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ]
}