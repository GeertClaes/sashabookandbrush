---
interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<button
  type="button"
  class:list={[
    "rounded-md p-2 transition-colors",
    transparent
      ? "text-cream hover:text-parchment"
      : "text-foreground hover:text-primary",
  ]}
  aria-label="Switch to dark mode"
  data-theme-toggle
>
  <svg
    data-icon-sun
    class="hidden h-5 w-5 dark:block"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.75"
      d="M12 3v1.5M12 19.5V21M4.22 4.22l1.06 1.06M18.72 18.72l1.06 1.06M3 12h1.5M19.5 12H21M4.22 19.78l1.06-1.06M18.72 5.28l1.06-1.06M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"
    ></path>
  </svg>
  <svg
    data-icon-moon
    class="h-5 w-5 dark:hidden"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.75"
      d="M21 14.3A8.5 8.5 0 1110.7 3 6.5 6.5 0 0021 14.3z"
    ></path>
  </svg>
</button>
