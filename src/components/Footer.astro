---
import Logo from "./Logo.astro";
import site from "../data/site.json";
---

<footer class="bg-footer py-12 text-parchment">
  <div class="mx-auto max-w-5xl px-6 md:px-12">
    <div class="mb-8 flex flex-col justify-between gap-8 md:flex-row">
      <div>
        <div class="font-display mb-2 text-xl font-semibold text-cream">
          <Logo />
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-ink-soft">
          Books and art, all in one place.
        </p>
      </div>
      <div class="flex flex-wrap gap-8 text-sm">
        <div class="flex flex-col gap-2">
          {
            site.nav.map((item) => (
              <a href={item.href} class="text-ink-soft transition-colors hover:text-parchment">
                {item.label}
              </a>
            ))
          }
        </div>
        <div class="flex flex-col gap-2">
          <a
            href={site.instagram}
            class="text-ink-soft transition-colors hover:text-parchment"
            rel="noopener noreferrer"
            target="_blank">Instagram</a
          >
          <a
            href={site.bookshop}
            class="text-ink-soft transition-colors hover:text-parchment"
            rel="noopener noreferrer"
            target="_blank">Bookshop.org</a
          >
        </div>
      </div>
    </div>
    <div class="border-t border-footer-border pt-6 text-xs text-ink-soft">
      <p>
        © {new Date().getFullYear()}
        {site.handle}. This site contains affiliate links for books and art supplies — I earn a small
        commission at no extra cost to you.
      </p>
    </div>
  </div>
</footer>
