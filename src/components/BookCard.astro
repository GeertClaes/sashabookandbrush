---
import AffiliateButtons from "./AffiliateButtons.astro";
import CoverImage from "./CoverImage.astro";
import StarRating from "./StarRating.astro";

interface Props {
  title: string;
  author: string;
  cover: string;
  note: string;
  rating: number;
  genre: string;
  bookshop: string;
  amazon: string;
  status?: "read" | "currently-reading";
  dateRead?: string;
  dateAdded?: string;
  variant?: "grid" | "row";
}

const {
  title,
  author,
  cover,
  note,
  rating,
  genre,
  bookshop,
  amazon,
  status = "read",
  dateRead,
  variant = "grid",
} = Astro.props;

const isRow = variant === "row";
const reading = status === "currently-reading";
const genericGenre = genre === "Read" || genre === "Currently reading" || !genre;
const label = reading ? "Currently reading" : genericGenre ? "" : genre;

function formatMonthYear(value?: string) {
  if (!value) return "";
  const [year, month] = value.split("-");
  if (!year || !month) return value;
  const names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${names[Number(month) - 1]} ${year}`;
}

const when = reading ? "Reading now" : dateRead ? `Read ${formatMonthYear(dateRead)}` : "";
---

<article
  class:list={[
    "group overflow-hidden rounded-lg border border-border bg-card transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg",
    isRow && "flex flex-col gap-6 p-5 sm:flex-row",
  ]}
>
  {
    isRow ? (
      <>
        <CoverImage
          cover={cover}
          alt={`${title} by ${author}`}
          class="h-48 w-32 shrink-0 rounded object-cover sm:h-40 sm:w-28"
          width={128}
          height={192}
        />
        <div class="flex min-w-0 flex-col justify-between py-1">
          <div>
            {label && (
              <span class="mb-2 block text-xs font-medium uppercase tracking-widest text-accent">
                {label}
              </span>
            )}
            <h3 class="font-display mb-1 text-xl font-semibold leading-snug text-foreground">
              {title}
            </h3>
            <p class="mb-3 text-sm text-muted-foreground">{author}</p>
            {rating > 0 && <StarRating rating={rating} />}
            {when && <p class="mt-2 text-xs text-muted-foreground">{when}</p>}
            {note && (
              <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed text-foreground">
                {note}
              </p>
            )}
          </div>
          <AffiliateButtons bookshop={bookshop} amazon={amazon} />
        </div>
      </>
    ) : (
      <>
        <div class="aspect-[2/3] overflow-hidden bg-muted">
          <CoverImage
            cover={cover}
            alt={`${title} by ${author}`}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width={300}
            height={450}
            sizes="(min-width: 768px) 25vw, 50vw"
          />
        </div>
        <div class="p-4">
          {label && (
            <span class="mb-1.5 block text-xs font-medium uppercase tracking-widest text-accent">
              {label}
            </span>
          )}
          <h3 class="font-display mb-0.5 text-lg font-semibold leading-snug text-foreground">
            {title}
          </h3>
          <p class="mb-2 text-xs text-muted-foreground">{author}</p>
          {rating > 0 && <StarRating rating={rating} />}
          {note && (
            <p class="mt-3 line-clamp-3 whitespace-pre-wrap text-sm leading-relaxed text-foreground">
              {note}
            </p>
          )}
          <AffiliateButtons bookshop={bookshop} amazon={amazon} />
        </div>
      </>
    )
  }
</article>
