---
import SupplyButtons from "./SupplyButtons.astro";
import SupplyImage from "./SupplyImage.astro";
import { realUrl, taggedAmazon } from "../lib/affiliates";

interface Props {
  title: string;
  brand: string;
  category: string;
  note: string;
  image?: string;
  amazon?: string;
  shop?: string;
  shopLabel?: string;
  slug?: string;
}

const { title, brand, category, note, image = "", amazon, shop, shopLabel, slug } = Astro.props;
const buyHref = taggedAmazon(amazon) || realUrl(amazon) || realUrl(shop);
---

<article class="flex h-full flex-col overflow-hidden rounded-lg border border-border bg-card p-3 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
  {
    image && (
      buyHref ? (
        <a
          href={buyHref}
          rel="sponsored noopener noreferrer"
          target="_blank"
          class="mb-2 block overflow-hidden rounded-md bg-muted"
          data-umami-event="affiliate-click"
          data-umami-event-retailer="amazon"
          data-umami-event-slug={slug || undefined}
        >
          <SupplyImage image={image} alt={title} width={640} height={640} class="aspect-square w-full object-cover" />
        </a>
      ) : (
        <div class="mb-2 overflow-hidden rounded-md bg-muted">
          <SupplyImage image={image} alt={title} width={640} height={640} class="aspect-square w-full object-cover" />
        </div>
      )
    )
  }
  <span class="mb-1 block text-[10px] font-medium tracking-widest text-accent uppercase">
    {category}
  </span>
  <h3 class="font-display mb-0.5 text-sm font-semibold leading-snug text-foreground">{title}</h3>
  {brand && <p class="mb-2 text-xs text-muted-foreground">{brand}</p>}
  {note && <p class="text-xs leading-relaxed text-foreground">{note}</p>}
  <SupplyButtons amazon={amazon} shop={shop} shopLabel={shopLabel} title={title} slug={slug} />
</article>
