---
import { Image } from "astro:assets";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import { coverModule } from "../lib/covers";

interface Props {
  cover: string;
  alt: string;
  class?: string;
  width: number;
  height: number;
  sizes?: string;
}

const { cover, alt, class: className = "", width, height, sizes = `${width}px` } = Astro.props;
const image = coverModule(cover);
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      width={width}
      height={height}
      sizes={sizes}
      class={className}
    />
  ) : (
    <MediaPlaceholder kind="book" class={className} label={alt} width={width} height={height} />
  )
}
