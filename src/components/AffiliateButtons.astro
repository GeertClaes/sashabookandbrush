---
import { realUrl } from "../lib/affiliates";

interface Props {
  bookshop?: string;
  amazon?: string;
  title?: string;
  slug?: string;
  tone?: "light" | "dark";
  hideHint?: boolean;
}

const {
  bookshop = "",
  amazon = "",
  title = "",
  slug = "",
  tone = "light",
  hideHint = false,
} = Astro.props;

const shopUrl = realUrl(bookshop);
const amazonUrl = realUrl(amazon);
const hasLinks = Boolean(shopUrl || amazonUrl);
const pair = Boolean(shopUrl && amazonUrl);
const dark = tone === "dark";
const affiliateRel = "sponsored noopener noreferrer";
const bookshopLabel = title ? `Buy ${title} on Bookshop.org` : "Buy on Bookshop.org";
const amazonLabel = title ? `Buy ${title} on Amazon` : "Buy on Amazon";
const chip =
  "inline-flex min-w-0 items-center justify-center gap-1 rounded-md px-2 py-1.5 text-[11px] font-medium leading-none transition-opacity hover:opacity-90";
---

{
  hasLinks && (
    <div class="space-y-1.5">
      <div class:list={[pair ? "grid grid-cols-2 gap-1.5" : "flex"]}>
        {shopUrl && (
          <a
            href={shopUrl}
            rel={affiliateRel}
            aria-label={bookshopLabel}
            data-umami-event="affiliate-click"
            data-umami-event-retailer="bookshop"
            data-umami-event-slug={slug || undefined}
            class:list={[
              chip,
              dark
                ? "border border-cream/70 bg-cream text-secondary"
                : "bg-secondary text-secondary-foreground",
            ]}
          >
            Bookshop
          </a>
        )}
        {amazonUrl && (
          <a
            href={amazonUrl}
            rel={affiliateRel}
            aria-label={amazonLabel}
            data-umami-event="affiliate-click"
            data-umami-event-retailer="amazon"
            data-umami-event-slug={slug || undefined}
            class:list={[chip, dark ? "bg-accent text-cream" : "bg-accent text-primary-foreground"]}
          >
            Amazon
          </a>
        )}
      </div>
      {!hideHint && (
        <p class:list={["text-[11px] leading-snug", dark ? "text-sage" : "text-muted-foreground"]}>
          Affiliate links. I earn a small commission at no extra cost to you.
        </p>
      )}
    </div>
  )
}
