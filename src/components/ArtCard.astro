---
import ArtImage from "./ArtImage.astro";
import { realUrl } from "../lib/affiliates";
import site from "../data/site.json";

interface Props {
  title: string;
  medium: string;
  image?: string;
  note: string;
  available?: boolean;
  shop?: string;
  shopLabel?: string;
}

const { title, medium, image, note, available = false, shop = "", shopLabel = "" } = Astro.props;
const shopUrl = realUrl(shop);
const forSale = Boolean(available);
const saleHref = forSale ? shopUrl || site.instagram : "";
const saleLabel = shopLabel || (shopUrl ? "Buy" : "Available — DM me");
---

<article class="group overflow-hidden rounded-lg border border-border bg-card transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
  <div class="aspect-[4/5] overflow-hidden bg-muted">
    {
      image ? (
        <ArtImage
          image={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          width={600}
          height={750}
        />
      ) : (
        <ArtImage
          image=""
          alt={`${title} — photo coming soon`}
          class="h-full w-full transition-transform duration-500 group-hover:scale-105"
          width={400}
          height={500}
        />
      )
    }
  </div>
  <div class="p-4">
    <span class="mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium tracking-widest uppercase">
      <span class="text-accent">{medium}</span>
      {forSale && <span class="text-primary">For sale</span>}
    </span>
    <h3 class="font-display mb-2 text-lg font-semibold leading-snug text-foreground">{title}</h3>
    {note && <p class="text-sm leading-relaxed text-muted-foreground">{note}</p>}
    {
      saleHref && (
        <a
          href={saleHref}
          rel="noopener noreferrer"
          target="_blank"
          class="mt-3 inline-flex items-center justify-center rounded-md bg-secondary px-3 py-1.5 text-[11px] font-medium leading-none text-secondary-foreground transition-opacity hover:opacity-90"
        >
          {saleLabel}
        </a>
      )
    }
  </div>
</article>
