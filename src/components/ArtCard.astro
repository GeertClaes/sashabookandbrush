---
interface Props {
  title: string;
  medium: string;
  image?: string;
  note: string;
}

const { title, medium, image, note } = Astro.props;
---

<article class="group overflow-hidden rounded-lg border border-border bg-card transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
  {
    image ? (
      <div class="aspect-[4/5] overflow-hidden bg-muted">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          width="600"
          height="750"
        />
      </div>
    ) : (
      <div class="aspect-[4/5] bg-muted" aria-hidden="true"></div>
    )
  }
  <div class="p-4">
    <span class="mb-1.5 block text-xs font-medium tracking-widest text-accent uppercase">
      {medium}
    </span>
    <h3 class="font-display mb-2 text-lg font-semibold leading-snug text-foreground">{title}</h3>
    <p class="text-sm leading-relaxed text-muted-foreground">{note}</p>
  </div>
</article>
