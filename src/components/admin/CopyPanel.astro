---
// Pages tab: static markup only (the editor fields are rendered client-side
// into data-copy-root by renderCopyEditor()).
---

<div data-panel="copy" id="panel-copy" role="tabpanel" aria-labelledby="tab-copy" class="hidden space-y-6">
  <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
    Home, About, and Work with me. Open a section to edit it. Navigation, the home photo, and the reading challenge stay as they are.
  </p>
  <div data-copy-root class="space-y-6"></div>
  <button type="button" data-copy-save class="rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
    Save pages
  </button>
</div>
