---
import { realUrl, taggedAmazon } from "../lib/affiliates";

interface Props {
  amazon?: string;
  shop?: string;
  shopLabel?: string;
  title?: string;
  slug?: string;
}

const { amazon = "", shop = "", shopLabel = "Shop", title = "", slug = "" } = Astro.props;
const amazonUrl = taggedAmazon(amazon) || realUrl(amazon);
const shopUrl = realUrl(shop);
const hasLinks = Boolean(amazonUrl || shopUrl);
const affiliateRel = "sponsored noopener noreferrer";
const amazonLabel = title ? `Buy ${title} on Amazon` : undefined;
const shopAria = title ? `Buy ${title} at ${shopLabel}` : undefined;
---

{
  hasLinks && (
    <div class="mt-2 space-y-1.5">
      <div class:list={[amazonUrl && shopUrl ? "grid grid-cols-2 gap-1.5" : "flex"]}>
        {amazonUrl && (
          <a
            href={amazonUrl}
            rel={affiliateRel}
            aria-label={amazonLabel}
            data-umami-event="affiliate-click"
            data-umami-event-retailer="amazon"
            data-umami-event-slug={slug || undefined}
            class="inline-flex min-w-0 items-center justify-center rounded-md bg-secondary px-2 py-1.5 text-[11px] font-medium leading-none text-secondary-foreground transition-opacity hover:opacity-90"
          >
            Amazon
          </a>
        )}
        {shopUrl && (
          <a
            href={shopUrl}
            rel={affiliateRel}
            aria-label={shopAria}
            data-umami-event="affiliate-click"
            data-umami-event-retailer="other"
            data-umami-event-slug={slug || undefined}
            class="inline-flex min-w-0 items-center justify-center rounded-md border border-border px-2 py-1.5 text-[11px] font-medium leading-none text-muted-foreground transition-colors hover:border-primary hover:text-primary"
          >
            {shopLabel}
          </a>
        )}
      </div>
      <p class="text-[11px] leading-snug text-muted-foreground">
        Affiliate links. I earn a small commission at no extra cost to you.
      </p>
    </div>
  )
}
