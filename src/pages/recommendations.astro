---
import BookCard from "../components/BookCard.astro";
import site from "../data/site.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const books = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
const genres = ["All", ...new Set(books.map((book) => book.data.genre))];
const total = books.length;
---

<BaseLayout
  title="Recommendations"
  description={site.recommendations.lede}
>
  <div class="min-h-screen bg-background">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-12">
      <div class="mb-8">
        <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">
          {site.recommendations.eyebrow}
        </p>
        <h1 class="font-display mb-4 text-3xl font-semibold leading-tight text-foreground sm:text-4xl md:text-5xl">
          {site.recommendations.headline}
        </h1>
        <p class="max-w-xl leading-relaxed text-muted-foreground">
          {site.recommendations.lede}
        </p>
      </div>

      <div
        class="sticky top-16 z-30 mb-8 border-b border-border bg-background/95 py-4 backdrop-blur-sm"
        data-library-controls
      >
        <label class="relative block">
          <span class="sr-only">Search books by title, author, or note</span>
          <svg
            class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-muted-foreground"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"></path>
          </svg>
          <input
            id="book-search"
            type="search"
            placeholder="Search titles, authors, or a vibe…"
            autocomplete="off"
            class="min-w-0 w-full rounded-lg border border-border bg-card py-2.5 pr-10 pl-10 text-sm text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-ring focus:outline-none"
          />
        </label>

        <div
          class="mt-4 flex flex-wrap gap-2"
          data-genre-filters
          role="group"
          aria-label="Filter by genre"
        >
          {
            genres.map((genre, index) => (
              <button
                type="button"
                data-genre={genre}
                aria-pressed={index === 0 ? "true" : "false"}
                class:list={[
                  "rounded-full px-4 py-1.5 text-sm font-medium transition-all",
                  index === 0
                    ? "bg-primary text-primary-foreground"
                    : "border border-border text-muted-foreground hover:border-foreground hover:text-foreground",
                ]}
              >
                {genre}
              </button>
            ))
          }
        </div>

        <p class="mt-3 text-xs text-muted-foreground" data-result-count>
          {total} {total === 1 ? "book" : "books"}
        </p>
      </div>

      <div class="grid gap-4" data-book-list>
        {
          books.map((book) => (
            <div
              data-book-genre={book.data.genre}
              data-book-search={`${book.data.title} ${book.data.author} ${book.data.genre} ${book.data.note}`.toLowerCase()}
            >
              <BookCard {...book.data} variant="row" />
            </div>
          ))
        }
      </div>

      <p data-empty class="hidden py-20 text-center text-muted-foreground">
        Nothing matches that search. Try another title, author, or genre.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#book-search");
  const filters = document.querySelectorAll<HTMLButtonElement>("[data-genre-filters] [data-genre]");
  const cards = document.querySelectorAll<HTMLElement>("[data-book-search]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const total = cards.length;
  const activeClasses = ["bg-primary", "text-primary-foreground"];
  const idleClasses = [
    "border",
    "border-border",
    "text-muted-foreground",
    "hover:border-foreground",
    "hover:text-foreground",
  ];

  let genre = "All";

  function apply() {
    const query = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const genreMatch = genre === "All" || card.dataset.bookGenre === genre;
      const textMatch = !query || (card.dataset.bookSearch ?? "").includes(query);
      const show = genreMatch && textMatch;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    });

    empty?.classList.toggle("hidden", visible > 0);

    if (count) {
      if (visible === total && !query && genre === "All") {
        count.textContent = `${total} ${total === 1 ? "book" : "books"}`;
      } else {
        count.textContent = `Showing ${visible} of ${total}`;
      }
    }

    filters.forEach((button) => {
      const on = button.dataset.genre === genre;
      button.setAttribute("aria-pressed", String(on));
      activeClasses.forEach((cls) => button.classList.toggle(cls, on));
      idleClasses.forEach((cls) => button.classList.toggle(cls, !on));
    });
  }

  search?.addEventListener("input", apply);
  filters.forEach((button) => {
    button.addEventListener("click", () => {
      genre = button.dataset.genre ?? "All";
      apply();
    });
  });
</script>
