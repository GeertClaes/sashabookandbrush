---
import BookCard from "../components/BookCard.astro";
import CoverWall from "../components/CoverWall.astro";
import live from "../data/goodreads-live.json";
import site from "../data/site.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { bookHref } from "../lib/books";
import { liveProgress, liveReadingStatus } from "../lib/live";
import { groupSeries } from "../lib/series";
import { getCollection } from "astro:content";

const books = (await getCollection("books"))
  .map((book) => {
    const status = liveReadingStatus(live, book.data.title, book.data.goodreadsId, book.data.status);
    if (status === book.data.status) return book;
    return { ...book, data: { ...book.data, status } };
  })
  .sort((a, b) => {
    if (a.data.status !== b.data.status) {
      return a.data.status === "currently-reading" ? -1 : 1;
    }
    if (a.data.status === "currently-reading") {
      const left = liveProgress(live, a.data.title, a.data.goodreadsId);
      const right = liveProgress(live, b.data.title, b.data.goodreadsId);
      const leftProgress = typeof left === "number" ? left : -1;
      const rightProgress = typeof right === "number" ? right : -1;
      if (leftProgress !== rightProgress) return rightProgress - leftProgress;
    }
    const aDate = a.data.status === "currently-reading" ? a.data.dateAdded : a.data.dateRead || a.data.dateAdded;
    const bDate = b.data.status === "currently-reading" ? b.data.dateAdded : b.data.dateRead || b.data.dateAdded;
    return (bDate || "").localeCompare(aDate || "");
  });
const fiveStars = books.filter((book) => book.data.rating === 5);
const seriesGroups = groupSeries(books, 3);
const years = [...new Set(books.map((book) => book.data.dateRead?.slice(0, 4)).filter(Boolean) as string[])].sort(
  (a, b) => b.localeCompare(a),
);
const shelves = [
  { id: "currently-reading", label: "Now" },
  { id: "read", label: "Read" },
];
const genreChips = [
  ...(books.some((book) => book.data.genre === "Read") ? ["Other"] : []),
  ...[...new Set(
    books
      .map((book) => book.data.genre)
      .filter((genre) => genre && genre !== "Currently reading" && genre !== "Read"),
  )].sort((a, b) => a.localeCompare(b)),
];
const total = books.length;
const selectClass =
  "min-w-0 rounded-lg border border-border bg-card px-2.5 py-2 text-sm text-foreground focus:ring-2 focus:ring-ring focus:outline-none";
const sorts = [
  { id: "reading", label: "Reading first" },
  { id: "read-desc", label: "Recently read" },
  { id: "read-asc", label: "Oldest read" },
  { id: "added-desc", label: "Just added" },
  { id: "rating-desc", label: "Top rated" },
  { id: "title-asc", label: "Title" },
  { id: "author-asc", label: "Author" },
  { id: "year-desc", label: "Newest published" },
  { id: "pages-desc", label: "Longest" },
];
---

<BaseLayout
  title="Recommendations"
  description={site.recommendations.lede}
>
  <div class="min-h-screen bg-background">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-12">
      <div class="mb-8">
        <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">
          {site.recommendations.eyebrow}
        </p>
        <h1 class="font-display mb-4 text-3xl font-semibold leading-tight text-foreground sm:text-4xl md:text-5xl">
          {site.recommendations.headline}
        </h1>
        <p class="max-w-xl leading-relaxed text-muted-foreground">
          {site.recommendations.lede}
        </p>
      </div>

      <div
        class="mb-6 flex border-b border-border sm:mb-10"
        role="tablist"
        aria-label="Library views"
      >
        <button
          type="button"
          role="tab"
          id="tab-stars"
          aria-controls="panel-stars"
          aria-selected="true"
          aria-label={`Five stars, ${fiveStars.length} books`}
          data-view="stars"
          class="relative -mb-px flex min-w-0 flex-1 items-center justify-center gap-2 border-b-2 border-primary px-2 pb-3 font-display text-lg text-foreground sm:flex-none sm:justify-start sm:pr-8 sm:pl-0"
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.6l2.7 5.6 6.2.9-4.5 4.3 1.1 6.1L12 16.7 6.5 19.5l1.1-6.1L3.1 9.1l6.2-.9L12 2.6z"></path>
          </svg>
          <span class="hidden sm:inline">Five stars</span>
          <span class="hidden font-sans text-xs font-normal text-muted-foreground sm:inline">{fiveStars.length}</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-library"
          aria-controls="panel-library"
          aria-selected="false"
          aria-label={`Library, ${total} books`}
          data-view="library"
          class="relative -mb-px flex min-w-0 flex-1 items-center justify-center gap-2 border-b-2 border-transparent px-2 pb-3 font-display text-lg text-muted-foreground hover:text-foreground sm:flex-none sm:justify-start sm:pr-8 sm:pl-0"
        >
          <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 016.5 22H20V2H6.5A2.5 2.5 0 004 4.5v15z"
            ></path>
          </svg>
          <span class="hidden sm:inline">Library</span>
          <span class="hidden font-sans text-xs font-normal text-muted-foreground sm:inline">{total}</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-series"
          aria-controls="panel-series"
          aria-selected="false"
          aria-label={`Series, ${seriesGroups.length} series`}
          data-view="series"
          class="relative -mb-px flex min-w-0 flex-1 items-center justify-center gap-2 border-b-2 border-transparent px-2 pb-3 font-display text-lg text-muted-foreground hover:text-foreground sm:flex-none sm:justify-start sm:pr-8 sm:pl-0"
        >
          <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M6 7V6a2 2 0 012-2h8a2 2 0 012 2v1M6 7a2 2 0 00-2 2v9a2 2 0 002 2h12a2 2 0 002-2V9a2 2 0 00-2-2M6 7h12"
            ></path>
          </svg>
          <span class="hidden sm:inline">Series</span>
          <span class="hidden font-sans text-xs font-normal text-muted-foreground sm:inline">{seriesGroups.length}</span>
        </button>
      </div>

      <div id="panel-series" role="tabpanel" aria-labelledby="tab-series" data-view-panel="series" hidden>
        <h2 class="font-display mb-3 text-2xl font-semibold text-foreground sm:hidden">Series</h2>
        {
          seriesGroups.length > 0 ? (
            <div class="space-y-10">
              <p class="max-w-xl text-sm text-muted-foreground">
                Series with at least three books on the shelf, in reading order.
              </p>
              {seriesGroups.map((group) => (
                <div>
                  <div class="mb-3 flex items-baseline justify-between gap-3">
                    <h2 class="font-display text-lg font-semibold text-foreground">{group.name}</h2>
                    <p class="text-xs text-muted-foreground">{group.books.length} on the site</p>
                  </div>
                  <CoverWall books={group.books} />
                </div>
              ))}
            </div>
          ) : (
            <p class="py-16 text-center text-muted-foreground">No series stacks yet.</p>
          )
        }
      </div>

      <div id="panel-stars" role="tabpanel" aria-labelledby="tab-stars" data-view-panel="stars">
        <h2 class="font-display mb-3 text-2xl font-semibold text-foreground sm:hidden">Five stars</h2>
        {
          fiveStars.length > 0 ? (
            <div>
              <p class="mb-6 max-w-xl text-sm text-muted-foreground">
                The ones that earned the full set. Tap a cover for the book — and a copy, if I have a
                note.
              </p>
              <CoverWall books={fiveStars} />
            </div>
          ) : (
            <p class="py-16 text-center text-muted-foreground">No five-star reads yet.</p>
          )
        }
      </div>

      <div id="panel-library" role="tabpanel" aria-labelledby="tab-library" data-view-panel="library" hidden>
      <h2 class="font-display mb-3 text-2xl font-semibold text-foreground sm:hidden">Library</h2>
      <div
        class="z-30 mb-8 border-b border-border bg-background/95 py-3 backdrop-blur-sm md:sticky md:top-16"
        data-library-controls
      >
        <div class="flex flex-col gap-2 lg:flex-row lg:items-center">
          <label class="relative min-w-0 flex-1">
            <span class="sr-only">Search books by title, author, or note</span>
            <svg
              class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-muted-foreground"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"></path>
            </svg>
            <input
              id="book-search"
              type="search"
              placeholder="Search titles, authors, or a vibe…"
              autocomplete="off"
              class="min-w-0 w-full rounded-lg border border-border bg-card py-2 pr-3 pl-10 text-sm text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-ring focus:outline-none"
            />
          </label>
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              data-filter-group="note"
              data-filter-value="1"
              aria-pressed="false"
              class="shrink-0 rounded-full border border-border bg-card px-3 py-2 text-xs font-medium text-foreground transition-colors hover:border-primary"
            >
              With a note
            </button>
            <label>
              <span class="sr-only">Sort books</span>
              <select id="book-sort" class:list={[selectClass, "w-full sm:w-44"]}>
                {sorts.map((item) => <option value={item.id}>{item.label}</option>)}
              </select>
            </label>
            <label>
              <span class="sr-only">Year read</span>
              <select id="book-year" class:list={[selectClass, "w-full sm:w-36"]}>
                <option value="all">Any year</option>
                {years.map((year) => <option value={year}>Read in {year}</option>)}
              </select>
            </label>
          </div>
        </div>

        <div class="mt-3 grid gap-2 md:grid-cols-[auto_auto_minmax(0,1fr)]">
          <fieldset class="w-full rounded-lg border border-border px-3 pt-1 pb-2.5 md:w-fit">
            <legend class="px-1 text-[10px] font-medium tracking-widest text-accent uppercase">Shelf</legend>
            <div class="flex flex-wrap gap-1.5" role="group" aria-label="Shelf">
              {
                shelves.map((item) => (
                  <button
                    type="button"
                    data-filter-group="shelf"
                    data-filter-value={item.id}
                    aria-pressed="false"
                    class="shrink-0 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-foreground transition-colors hover:border-primary"
                  >
                    {item.label}
                  </button>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="w-full rounded-lg border border-border px-3 pt-1 pb-2.5 md:w-fit">
            <legend class="px-1 text-[10px] font-medium tracking-widest text-accent uppercase">Rating</legend>
            <div class="flex flex-wrap gap-1.5" role="group" aria-label="Rating">
              {
                [5, 4, 3, 2, 1].map((stars) => (
                  <button
                    type="button"
                    data-filter-group="rating"
                    data-filter-value={String(stars)}
                    aria-pressed="false"
                    class="shrink-0 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-foreground transition-colors hover:border-primary"
                  >
                    <span class="sr-only">{stars} {stars === 1 ? "star" : "stars"}</span>
                    <span aria-hidden="true">{stars} ★</span>
                  </button>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="min-w-0 rounded-lg border border-border px-3 pt-1 pb-2.5">
            <legend class="px-1 text-[10px] font-medium tracking-widest text-accent uppercase">Genre</legend>
            <div class="flex flex-wrap gap-1.5" role="group" aria-label="Genre">
              {
                genreChips.map((genre) => (
                  <button
                    type="button"
                    data-filter-group="genre"
                    data-filter-value={genre === "Other" ? "Read" : genre}
                    aria-pressed="false"
                    class="shrink-0 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-foreground transition-colors hover:border-primary"
                  >
                    {genre}
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>

        <p class="mt-2 text-xs text-muted-foreground" data-result-count>
          {total} {total === 1 ? "book" : "books"}
        </p>
      </div>

      <div class="grid grid-cols-2 items-stretch gap-4 md:grid-cols-3 lg:grid-cols-4" data-book-list>
        {
          books.map((book) => {
            const progress = liveProgress(live, book.data.title, book.data.goodreadsId);
            return (
              <div
                class="h-full min-w-0"
                data-book-genre={book.data.genre}
                data-book-status={book.data.status}
                data-has-note={book.data.note ? "1" : "0"}
                data-sort-read={book.data.dateRead || ""}
                data-sort-added={book.data.dateAdded || ""}
                data-sort-title={book.data.title.toLowerCase()}
                data-sort-author={book.data.author.toLowerCase()}
                data-sort-rating={String(book.data.rating)}
                data-sort-year={String(book.data.yearPublished || book.data.originalYear || "")}
                data-sort-pages={String(book.data.pages || "")}
                data-sort-progress={progress === null ? "" : String(progress)}
                data-read-year={book.data.dateRead?.slice(0, 4) || ""}
                data-book-search={`${book.data.title} ${book.data.author} ${book.data.genre} ${book.data.note} ${book.data.isbn || ""} ${book.data.publisher || ""}`.toLowerCase()}
              >
                <BookCard {...book.data} href={bookHref(book.id)} progress={progress} />
              </div>
            );
          })
        }
      </div>

      <p data-empty class="hidden py-20 text-center text-muted-foreground">
        Nothing matches that search. Try another title, author, or genre.
      </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#book-search");
  const controls = document.querySelector<HTMLElement>("[data-library-controls]");
  const list = document.querySelector<HTMLElement>("[data-book-list]");
  const cards = document.querySelectorAll<HTMLElement>("[data-book-search]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-view]");
  const panels = document.querySelectorAll<HTMLElement>("[data-view-panel]");
  const total = cards.length;
  const views = new Set(["library", "series", "stars"]);
  const sortControl = document.querySelector<HTMLSelectElement>("#book-sort");
  const yearControl = document.querySelector<HTMLSelectElement>("#book-year");
  const filters = {
    shelf: "",
    rating: "",
    genre: "",
    year: "all",
    note: false,
  };

  function setView(view: string) {
    const next = views.has(view) ? view : "stars";
    tabs.forEach((tab) => {
      const on = tab.dataset.view === next;
      tab.setAttribute("aria-selected", on ? "true" : "false");
      tab.classList.toggle("border-primary", on);
      tab.classList.toggle("text-foreground", on);
      tab.classList.toggle("border-transparent", !on);
      tab.classList.toggle("text-muted-foreground", !on);
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.viewPanel !== next;
    });
    const url = new URL(window.location.href);
    if (next === "stars") url.searchParams.delete("view");
    else url.searchParams.set("view", next);
    history.replaceState(null, "", url);
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => setView(tab.dataset.view || "stars"));
  });

  function compareDate(a: string, b: string, oldest = false) {
    if (!a && !b) return 0;
    if (!a) return 1;
    if (!b) return -1;
    return oldest ? a.localeCompare(b) : b.localeCompare(a);
  }

  function progressOf(card: HTMLElement) {
    const raw = card.dataset.sortProgress;
    if (!raw) return -1;
    const value = Number(raw);
    return Number.isFinite(value) ? value : -1;
  }

  function paintGroup(group: string, value: string) {
    document.querySelectorAll<HTMLButtonElement>(`[data-filter-group="${group}"]`).forEach((button) => {
      const on = button.dataset.filterValue === value;
      button.setAttribute("aria-pressed", on ? "true" : "false");
      button.classList.toggle("border-primary", on);
      button.classList.toggle("bg-primary", on);
      button.classList.toggle("text-primary-foreground", on);
      button.classList.toggle("border-border", !on);
      button.classList.toggle("bg-card", !on);
      button.classList.toggle("text-foreground", !on);
      button.classList.toggle("hover:border-primary", !on);
    });
  }

  function sortCards() {
    if (!list) return;
    const mode = sortControl?.value ?? "reading";
    const items = [...list.children] as HTMLElement[];
    items.sort((left, right) => {
      if (mode === "reading") {
        const leftReading = left.dataset.bookStatus === "currently-reading" ? 0 : 1;
        const rightReading = right.dataset.bookStatus === "currently-reading" ? 0 : 1;
        if (leftReading !== rightReading) return leftReading - rightReading;
        const byProgress = progressOf(right) - progressOf(left);
        if (byProgress) return byProgress;
        return compareDate(left.dataset.sortAdded ?? "", right.dataset.sortAdded ?? "");
      }
      if (mode === "read-desc") return compareDate(left.dataset.sortRead ?? "", right.dataset.sortRead ?? "");
      if (mode === "read-asc") return compareDate(left.dataset.sortRead ?? "", right.dataset.sortRead ?? "", true);
      if (mode === "added-desc") return compareDate(left.dataset.sortAdded ?? "", right.dataset.sortAdded ?? "");
      if (mode === "rating-desc") return Number(right.dataset.sortRating) - Number(left.dataset.sortRating);
      if (mode === "title-asc") return (left.dataset.sortTitle ?? "").localeCompare(right.dataset.sortTitle ?? "");
      if (mode === "author-asc") return (left.dataset.sortAuthor ?? "").localeCompare(right.dataset.sortAuthor ?? "");
      if (mode === "year-desc") return compareDate(left.dataset.sortYear ?? "", right.dataset.sortYear ?? "");
      if (mode === "pages-desc") return Number(right.dataset.sortPages || 0) - Number(left.dataset.sortPages || 0);
      return 0;
    });
    items.forEach((item) => list.appendChild(item));
  }

  function apply() {
    const query = (search?.value ?? "").trim().toLowerCase();
    const shelfValue = filters.shelf;
    const ratingValue = filters.rating;
    const genreValue = filters.genre;
    const yearValue = filters.year;
    let visible = 0;

    cards.forEach((card) => {
      const shelfMatch = !shelfValue || card.dataset.bookStatus === shelfValue;
      const genreMatch = !genreValue || card.dataset.bookGenre === genreValue;
      const yearMatch = yearValue === "all" || card.dataset.readYear === yearValue;
      const noteMatch = !filters.note || card.dataset.hasNote === "1";
      const stars = Number(card.dataset.sortRating || 0);
      const ratingMatch = !ratingValue || stars === Number(ratingValue);
      const textMatch = !query || (card.dataset.bookSearch ?? "").includes(query);
      const show = shelfMatch && genreMatch && ratingMatch && noteMatch && textMatch && yearMatch;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    });

    empty?.classList.toggle("hidden", visible > 0);

    if (count) {
      const idle =
        visible === total &&
        !query &&
        !shelfValue &&
        !ratingValue &&
        !genreValue &&
        !filters.note &&
        yearValue === "all";
      count.textContent = idle
        ? `${total} ${total === 1 ? "book" : "books"}`
        : `Showing ${visible} of ${total}`;
    }
  }

  search?.addEventListener("input", apply);
  sortControl?.addEventListener("change", sortCards);
  yearControl?.addEventListener("change", () => {
    filters.year = yearControl.value || "all";
    apply();
  });
  controls?.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-filter-group]");
    if (!button) return;
    const group = button.dataset.filterGroup;
    const value = button.dataset.filterValue || "";
    if (group === "note") {
      filters.note = !filters.note;
      paintGroup("note", filters.note ? "1" : "");
      apply();
      return;
    }
    if (group !== "shelf" && group !== "rating" && group !== "genre") return;
    filters[group] = filters[group] === value ? "" : value;
    paintGroup(group, filters[group]);
    apply();
  });

  const params = new URLSearchParams(window.location.search);
  const yearParam = params.get("year");
  const viewParam = params.get("view");
  if (yearParam && /^\d{4}$/.test(yearParam) && yearControl?.querySelector(`option[value="${yearParam}"]`)) {
    yearControl.value = yearParam;
    filters.year = yearParam;
    apply();
  }
  sortCards();
  setView(yearParam ? "library" : viewParam || "stars");
</script>
