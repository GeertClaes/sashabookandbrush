---
import site from "../data/site.json";
import BaseLayout from "../layouts/BaseLayout.astro";

const { about, facts, readingChallenge, instagram, handle } = site;
const percent = Math.round((readingChallenge.read / readingChallenge.goal) * 100);
---

<BaseLayout
  title="About"
  description="Meet Sasha of @sashabookandbrush — romantasy, paintings, an Aussie in Wales, and a cat named Dobby."
>
  <div class="min-h-screen bg-background">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-12">
      <div class="grid items-start gap-12 md:grid-cols-5">
        <div class="md:col-span-2">
          <div class="sticky top-28">
            <div class="mb-4 aspect-[3/4] overflow-hidden rounded-lg bg-muted">
              <img
                src={about.image}
                alt={about.imageAlt}
                class="h-full w-full object-cover dark:hidden"
                width="600"
                height="800"
              />
              <img
                src={about.imageDark}
                alt={about.imageAlt}
                class="hidden h-full w-full object-cover dark:block"
                width="600"
                height="800"
              />
            </div>
            <a
              href={instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-primary"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
              {handle}
            </a>
          </div>
        </div>

        <div class="md:col-span-3">
          <p class="mb-4 text-xs font-medium tracking-widest text-accent uppercase">{about.eyebrow}</p>
          <h1 class="font-display mb-6 text-3xl font-semibold leading-tight text-foreground sm:text-4xl md:text-5xl">
            {about.headline}<br />
            <em class="font-light italic">{about.headlineItalic}</em>
          </h1>

          <div class="max-w-none space-y-4 leading-relaxed text-foreground">
            {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div class="mt-10 rounded-lg border border-border bg-card p-5">
            <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">
              {readingChallenge.year} Reading Challenge
            </p>
            <div class="mb-3 flex items-end gap-3">
              <span class="font-display text-4xl font-semibold text-foreground">
                {readingChallenge.read}
              </span>
              <span class="pb-1 text-sm text-muted-foreground">of {readingChallenge.goal} books</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted">
              <div class="h-full rounded-full bg-secondary" style={`width: ${percent}%`}></div>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">{percent}% — tracked on Goodreads</p>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3">
            {
              facts.map((fact) => (
                <div class="rounded-lg border border-border bg-card p-4">
                  <p class="mb-1 text-xs font-medium tracking-widest text-accent uppercase">
                    {fact.label}
                  </p>
                  <p class="text-sm font-medium text-foreground">{fact.value}</p>
                </div>
              ))
            }
          </div>

          <div class="mt-8">
            <a
              href={instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded border border-border px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              Follow on Instagram →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
