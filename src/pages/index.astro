---
import AffiliateButtons from "../components/AffiliateButtons.astro";
import ArtCard from "../components/ArtCard.astro";
import BookCard from "../components/BookCard.astro";
import CoverImage from "../components/CoverImage.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import SupplyCard from "../components/SupplyCard.astro";
import live from "../data/goodreads-live.json";
import site from "../data/site.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { affiliateLinks } from "../lib/affiliates";
import { bookHref } from "../lib/books";
import { findLocalForLive, liveProgress } from "../lib/live";
import { getCollection } from "astro:content";

const books = await getCollection("books");

const featured = books
  .filter((book) => book.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

function liveIsbn(item: { isbn?: string }, local?: (typeof books)[number]) {
  const raw = String(item.isbn || "").replace(/[^\dXx]/g, "");
  return {
    isbn: local?.data.isbn || (raw.length === 13 ? raw : ""),
    isbn10: local?.data.isbn10 || (raw.length === 10 ? raw : ""),
    bookshop: local?.data.bookshop,
    amazon: local?.data.amazon,
  };
}

const currentlyReading = (live.currentlyReading || []).map((item) => {
  const local = findLocalForLive(item, books);
  const progress = liveProgress(live, item.title, item.goodreadsId);
  return {
    title: item.title,
    author: item.author,
    href: local ? bookHref(local.id) : `https://www.goodreads.com/book/show/${item.goodreadsId}`,
    local: Boolean(local),
    cover: local?.data.cover || "",
    remoteCover: item.image || "",
    slug: local?.id || "",
    progress,
    buy: affiliateLinks(liveIsbn(item, local)),
  };
}).sort((a, b) => {
  const left = typeof a.progress === "number" ? a.progress : -1;
  const right = typeof b.progress === "number" ? b.progress : -1;
  return right - left;
});

const upNext = (live.upNext || []).slice(0, 8).map((item) => {
  const local = findLocalForLive(item, books);
  return {
    title: item.title,
    author: item.author,
    href: local ? bookHref(local.id) : `https://www.goodreads.com/book/show/${item.goodreadsId}`,
    cover: local?.data.cover || "",
    remoteCover: item.image || "",
    local: Boolean(local),
  };
});

const featuredArt = (await getCollection("art"))
  .filter((piece) => piece.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const featuredSupplies = (await getCollection("supplies"))
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const readingHref = currentlyReading.length > 0 ? "#currently-reading" : "/recommendations";
const readingLabel = currentlyReading.length > 0 ? "What I'm reading →" : "Browse books →";
---

<BaseLayout transparentHeader>
  <section class="relative flex min-h-[85vh] items-center overflow-hidden">
    <img
      src={site.hero.image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center dark:hidden"
      width="1600"
      height="900"
    />
    <img
      src={site.hero.imageDark}
      alt=""
      class="absolute inset-0 hidden h-full w-full object-cover object-center dark:block"
      width="1600"
      height="900"
    />
    <div class="absolute inset-0 bg-hero-overlay/60 dark:bg-hero-overlay/40"></div>
    <div class="relative z-10 mx-auto max-w-5xl px-6 py-32 md:px-12">
      {
        site.hero.eyebrow && (
          <p class="mb-6 text-sm font-medium tracking-[0.25em] text-accent uppercase">{site.hero.eyebrow}</p>
        )
      }
      <h1 class="font-display mb-6 max-w-2xl text-4xl leading-[1.05] font-semibold text-cream sm:text-5xl md:text-7xl">
        {site.hero.headline}
        {
          site.hero.headlineItalic && (
            <>
              <br />
              <em class="font-light italic">{site.hero.headlineItalic}</em>
            </>
          )
        }
      </h1>
      <p class="mb-10 max-w-lg text-lg leading-relaxed whitespace-pre-line text-parchment">
        {site.hero.lede}
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href={readingHref}
          class="rounded bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
        >
          {readingLabel}
        </a>
        <a
          href="/art"
          class="rounded border border-parchment/50 px-6 py-3 text-sm font-medium text-parchment transition-colors hover:border-parchment"
        >
          See the art
        </a>
      </div>
    </div>
  </section>

  {
    currentlyReading.length > 0 && (
      <section id="currently-reading" class="scroll-mt-20 bg-secondary py-16">
        <div class="mx-auto max-w-5xl px-6 md:px-12">
          <div class="mb-3 flex items-center gap-3">
            <span class="h-2 w-2 animate-pulse rounded-full bg-sage"></span>
            <p class="text-sm font-medium tracking-widest text-sage uppercase">
              Currently reading
              {currentlyReading.length > 1 ? ` · ${currentlyReading.length} books` : ""}
            </p>
          </div>
          <p class="mb-8 text-[11px] leading-snug text-sage">
            Affiliate links. I earn a small commission at no extra cost to you.
          </p>
          <div class="grid grid-cols-2 items-stretch gap-5 sm:grid-cols-3 xl:grid-cols-5">
            {currentlyReading.map((book) => (
              <article class="flex min-w-0 flex-col">
                <a
                  href={book.href}
                  class="group min-w-0"
                  rel={book.local ? undefined : "noopener noreferrer"}
                  target={book.local ? undefined : "_blank"}
                >
                  {book.cover ? (
                    <CoverImage
                      cover={book.cover}
                      alt={`${book.title} by ${book.author}`}
                      class="mb-3 aspect-2/3 w-full rounded object-cover shadow-xl transition-transform duration-300 group-hover:-translate-y-0.5"
                      width={180}
                      height={270}
                      sizes="(min-width: 1280px) 12vw, (min-width: 640px) 22vw, 45vw"
                    />
                  ) : book.remoteCover ? (
                    <img
                      src={book.remoteCover}
                      alt={`${book.title} by ${book.author}`}
                      class="mb-3 aspect-2/3 w-full rounded object-cover shadow-xl transition-transform duration-300 group-hover:-translate-y-0.5"
                      width="180"
                      height="270"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <MediaPlaceholder
                      kind="book"
                      class="mb-3 aspect-2/3 w-full rounded shadow-xl"
                      width={180}
                      height={270}
                    />
                  )}
                  <h2 class="font-display line-clamp-2 text-base font-semibold leading-snug text-cream">
                    {book.title}
                  </h2>
                  <p class="mt-1 line-clamp-1 text-sm text-sage">{book.author}</p>
                  {typeof book.progress === "number" && (
                    <div class="mt-3">
                      <div class="h-1.5 overflow-hidden rounded-full bg-cream/20">
                        <div class="h-full rounded-full bg-sage" style={`width: ${book.progress}%`}></div>
                      </div>
                      <p class="mt-1 text-xs text-sage">{book.progress}%</p>
                    </div>
                  )}
                </a>
                <div class="mt-auto pt-3">
                  <AffiliateButtons
                    bookshop={book.buy.bookshop}
                    amazon={book.buy.amazon}
                    slug={book.slug}
                    title={book.title}
                    tone="dark"
                    hideHint
                  />
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    upNext.length > 0 && (
      <section class="bg-secondary/80 py-12">
        <div class="mx-auto max-w-5xl px-6 md:px-12">
          <div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
            <div>
              <p class="mb-2 text-xs font-medium tracking-widest text-sage uppercase">Up next</p>
              <h2 class="font-display text-2xl font-semibold text-cream">Recently added to the TBR</h2>
            </div>
            <a
              href={site.goodreads.tbr}
              class="text-sm font-medium text-sage underline-offset-4 hover:underline"
              rel="noopener noreferrer"
              target="_blank"
            >
              Full TBR on Goodreads →
            </a>
          </div>
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-8">
            {upNext.map((book) => (
              <li>
                <a href={book.href} class="group block min-w-0" rel={book.local ? undefined : "noopener noreferrer"} target={book.local ? undefined : "_blank"}>
                  {book.cover ? (
                    <CoverImage
                      cover={book.cover}
                      alt=""
                      class="mb-2 aspect-2/3 w-full rounded object-cover shadow-md"
                      width={120}
                      height={180}
                    />
                  ) : book.remoteCover ? (
                    <img
                      src={book.remoteCover}
                      alt=""
                      class="mb-2 aspect-2/3 w-full rounded object-cover shadow-md"
                      width="120"
                      height="180"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <MediaPlaceholder
                      kind="book"
                      class="mb-2 aspect-2/3 w-full rounded shadow-md"
                      width={120}
                      height={180}
                    />
                  )}
                  <p class="font-display line-clamp-2 text-sm font-semibold leading-snug text-cream">{book.title}</p>
                  <p class="mt-1 line-clamp-1 text-xs text-sage">{book.author}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="bg-background py-20">
    <div class="mx-auto max-w-5xl px-6 md:px-12">
      <div class="mb-12 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">Recent favourites</p>
          <h2 class="font-display text-3xl font-semibold leading-tight text-foreground md:text-4xl">
            Reads I'm recommending<br /><em class="font-light italic">right now</em>
          </h2>
          <p class="mt-3 text-[11px] leading-snug text-muted-foreground">
            Affiliate links. I earn a small commission at no extra cost to you.
          </p>
        </div>
        <a
          href="/recommendations"
          class="self-start text-sm font-medium text-primary underline-offset-4 transition-all hover:underline md:self-auto"
        >
          Browse all →
        </a>
      </div>
      <div class="grid grid-cols-2 items-stretch gap-5 md:grid-cols-4">
        {
          featured.map((book) => (
            <BookCard {...book.data} href={bookHref(book.id)} slug={book.id} showBuy />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-muted py-20">
    <div class="mx-auto max-w-5xl px-6 md:px-12">
      <div class="mb-12 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">
            {site.art.homeEyebrow}
          </p>
          <h2 class="font-display text-3xl font-semibold leading-tight text-foreground md:text-4xl">
            {site.art.homeHeadline}<br />
            <em class="font-light italic">{site.art.homeHeadlineItalic}</em>
          </h2>
        </div>
        <a
          href="/art"
          class="self-start text-sm font-medium text-primary underline-offset-4 transition-all hover:underline md:self-auto"
        >
          All art →
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          featuredArt.map((piece) => (
            <ArtCard {...piece.data} />
          ))
        }
      </div>
      <div class="mt-12">
        <div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <h3 class="font-display text-2xl font-semibold text-foreground">
              {site.art.suppliesHeadline}
            </h3>
            <p class="mt-2 text-[11px] leading-snug text-muted-foreground">
              Affiliate links. I earn a small commission at no extra cost to you.
            </p>
          </div>
          <a
            href="/art#supplies"
            class="text-sm font-medium text-primary underline-offset-4 hover:underline"
          >
            Full kit →
          </a>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {
            featuredSupplies.map((item) => (
              <div class="h-full">
                <SupplyCard {...item.data} slug={item.id} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-14">
    <div class="mx-auto flex max-w-5xl flex-col justify-between gap-6 px-6 md:flex-row md:items-center md:px-12">
      <div>
        <h3 class="font-display mb-1 text-2xl font-semibold text-foreground">
          Thinking about collaborating?
        </h3>
        <p class="text-sm text-muted-foreground">
          The best way to reach me is Instagram.
        </p>
      </div>
      <a
        href="/work"
        class="shrink-0 rounded bg-primary px-6 py-3 text-sm font-medium whitespace-nowrap text-primary-foreground transition-opacity hover:opacity-90"
      >
        Work with me →
      </a>
    </div>
  </section>
</BaseLayout>
