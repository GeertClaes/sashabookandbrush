---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ImageMetadata } from "astro";
import { editableCopy } from "../../functions/admin/api/_lib/site-copy.js";
import site from "../data/site.json";
import { affiliateLinks, realUrl } from "../lib/affiliates";
import { coverModule } from "../lib/covers";
import { getCollection } from "astro:content";
import OverviewPanel from "../components/admin/OverviewPanel.astro";
import BookPanel from "../components/admin/BookPanel.astro";
import ArtPanel from "../components/admin/ArtPanel.astro";
import SupplyPanel from "../components/admin/SupplyPanel.astro";
import CopyPanel from "../components/admin/CopyPanel.astro";

const artImages = import.meta.glob<{ default: ImageMetadata }>("../assets/art/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const supplyImages = import.meta.glob<{ default: ImageMetadata }>("../assets/supplies/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const artImageUrl = (imagePath: string) => {
  const filename = (imagePath || "").split("/").pop() || "";
  const match = filename ? Object.entries(artImages).find(([key]) => key.endsWith(`/${filename}`)) : undefined;
  return match?.[1].default.src || "";
};
const supplyImageUrl = (imagePath: string) => {
  const filename = (imagePath || "").split("/").pop() || "";
  const match = filename ? Object.entries(supplyImages).find(([key]) => key.endsWith(`/${filename}`)) : undefined;
  return match?.[1].default.src || "";
};

const isDev = import.meta.env.DEV;
const api = isDev ? import.meta.env.PUBLIC_ADMIN_URL || "http://127.0.0.1:8787" : "";
const books = (await getCollection("books"))
  .map((book) => ({
    slug: book.id,
    title: book.data.title,
    author: book.data.author,
    note: book.data.note || "",
    featured: Boolean(book.data.featured),
    cover: book.data.cover || "",
    coverUrl: coverModule(book.data.cover)?.src || "",
    genre: book.data.genre || "",
    bookshop: book.data.bookshop === "#" ? "" : book.data.bookshop || "",
    amazon: book.data.amazon === "#" ? "" : book.data.amazon || "",
    isbn: book.data.isbn || "",
    isbn10: book.data.isbn10 || "",
    goodreadsId: book.data.goodreadsId || "",
    rating: book.data.rating || 0,
    status: book.data.status || "read",
    dateRead: book.data.dateRead || "",
    dateAdded: book.data.dateAdded || "",
    pages: book.data.pages || 0,
    yearPublished: book.data.yearPublished || 0,
    originalYear: book.data.originalYear || 0,
    publisher: book.data.publisher || "",
    readCount: book.data.readCount || 0,
    order: book.data.order || 0,
    buy: affiliateLinks(book.data),
  }))
  .toSorted((a, b) => a.title.localeCompare(b.title));
const art = (await getCollection("art"))
  .map((piece) => ({
    slug: piece.id,
    title: piece.data.title,
    medium: piece.data.medium,
    note: piece.data.note || "",
    featured: Boolean(piece.data.featured),
    image: piece.data.image || "",
    imageUrl: artImageUrl(piece.data.image || ""),
    order: piece.data.order || 0,
    available: Boolean(piece.data.available),
    shop: piece.data.shop || "",
    shopLabel: piece.data.shopLabel || "",
  }))
  .toSorted((a, b) => a.order - b.order || a.title.localeCompare(b.title));
const supplies = (await getCollection("supplies"))
  .map((item) => ({
    slug: item.id,
    title: item.data.title,
    brand: item.data.brand,
    category: item.data.category,
    note: item.data.note || "",
    amazon: realUrl(item.data.amazon),
    shop: item.data.shop || "",
    shopLabel: item.data.shopLabel || "",
    image: item.data.image || "",
    imageUrl: supplyImageUrl(item.data.image || ""),
    featured: Boolean(item.data.featured),
    order: item.data.order || 0,
  }))
  .toSorted((a, b) => a.order - b.order || a.title.localeCompare(b.title));

function todoItem(count: number, singular: string, plural: string, tab: string, queue = "") {
  return { count, label: count === 1 ? singular : plural, tab, queue };
}
const todos = [
  todoItem(
    books.filter((book) => book.rating === 5 && !book.note.trim()).length,
    "five-star book has no note",
    "five-star books have no note",
    "book",
    "five-star-no-note",
  ),
  todoItem(
    books.filter((book) => !book.isbn && !book.isbn10).length,
    "book has no ISBN",
    "books have no ISBN",
    "book",
    "missing-isbn",
  ),
  todoItem(
    supplies.filter((item) => !item.amazon).length,
    "tool has no Amazon link",
    "tools have no Amazon link",
    "supply",
  ),
  todoItem(
    art.filter((piece) => !piece.image).length,
    "painting has no photo",
    "paintings have no photo",
    "art",
  ),
  todoItem(
    art.filter((piece) => !piece.note.trim()).length,
    "painting has an empty note",
    "paintings have an empty note",
    "art",
  ),
].filter((item) => item.count > 0);
const affiliateConfig = {
  amazonTag: site.affiliates?.amazonTag || "",
  bookshopUkId: site.affiliates?.bookshopUkId || "",
  siteOrigin: "https://sashabookandbrush.com",
};
const pageCopy = editableCopy(site);
---

<BaseLayout
  title="Library editor"
  description="Private editor for books, art, and tools."
  noindex={true}
>
  <div class="min-h-screen bg-background">
    <div class="mx-auto max-w-6xl px-6 py-12 md:px-12 md:py-16">
      <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">Private</p>
      <h1 class="font-display mb-3 text-3xl font-semibold text-foreground">Studio editor</h1>
      <p class="mb-6 max-w-xl text-sm leading-relaxed text-muted-foreground">
        Notes, covers, paintings, and tools. Ratings stay on Goodreads.
        {
          isDev && (
            <>
              {" "}
              Locally, also run <code class="text-foreground">npm run admin</code>.
            </>
          )
        }
      </p>

      {
        isDev && (
          <form data-login class="mb-10 hidden rounded-xl border border-border bg-card p-5">
            <label class="block text-sm font-medium text-foreground">
              Password
              <input
                type="password"
                name="password"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2"
              />
            </label>
            <button type="submit" class="mt-4 rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
              Sign in
            </button>
          </form>
        )
      }

      <div
        data-editor-bar
        class="sticky top-16 z-30 -mx-6 mb-8 bg-background/95 px-6 backdrop-blur-sm md:-mx-12 md:px-12"
      >
        <p
          data-status
          role="status"
          aria-live="polite"
          class="py-2 text-sm text-muted-foreground"
        >
          Checking the editor…
        </p>
        <div
          data-tabs
          role="tablist"
          aria-label="Editor"
          class="hidden overflow-x-auto border-b border-border scrollbar-none"
        >
          <button type="button" role="tab" id="tab-overview" data-tab="overview" aria-selected="true" aria-controls="panel-overview" class="shrink-0 border-b-2 border-accent px-4 py-3 text-sm text-foreground">Overview</button>
          <button type="button" role="tab" id="tab-book" data-tab="book" aria-selected="false" aria-controls="panel-book" class="shrink-0 border-b-2 border-transparent px-4 py-3 text-sm text-muted-foreground">Books</button>
          <button type="button" role="tab" id="tab-art" data-tab="art" aria-selected="false" aria-controls="panel-art" class="shrink-0 border-b-2 border-transparent px-4 py-3 text-sm text-muted-foreground">Art</button>
          <button type="button" role="tab" id="tab-supply" data-tab="supply" aria-selected="false" aria-controls="panel-supply" class="shrink-0 border-b-2 border-transparent px-4 py-3 text-sm text-muted-foreground">Tools</button>
          <button type="button" role="tab" id="tab-copy" data-tab="copy" aria-selected="false" aria-controls="panel-copy" class="shrink-0 border-b-2 border-transparent px-4 py-3 text-sm text-muted-foreground">Pages</button>
        </div>
      </div>

      <div data-app class="hidden">
        <OverviewPanel todos={todos} />
        <BookPanel />
        <ArtPanel />
        <SupplyPanel />
        <CopyPanel />
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="page-copy" set:html={JSON.stringify(pageCopy).replace(/</g, "\\u003c")} />
  <script is:inline type="application/json" id="book-catalog" set:html={JSON.stringify(books).replace(/</g, "\\u003c")} />
  <script is:inline type="application/json" id="art-catalog" set:html={JSON.stringify(art).replace(/</g, "\\u003c")} />
  <script is:inline type="application/json" id="supply-catalog" set:html={JSON.stringify(supplies).replace(/</g, "\\u003c")} />
  <script is:inline type="application/json" id="affiliate-config" set:html={JSON.stringify(affiliateConfig).replace(/</g, "\\u003c")} />
  <script is:inline type="application/json" id="admin-config" set:html={JSON.stringify({ api, isDev }).replace(/</g, "\\u003c")} />

  <script>
  // @ts-nocheck -- This page's DOM-wiring script predates strict typing and
  // mixes untyped editor state with direct Element property access. See the
  // README's Tooling section for the plan to retype it incrementally as
  // pieces get extracted into src/lib/*.
  import { latestMark, mergeTimelineEvents, syncOutcome } from "../lib/sync-timeline.js";
  import { escapeHtml, formatWhen, toBase64 } from "../lib/admin-format.js";
  import { activityLog, saveSteps, syncSteps } from "../lib/admin-timeline-ui.js";
  import { tagAmazonUrl } from "../lib/affiliates";
  import {
    COPY_MAX,
    cardRow,
    copySection,
    copySubhead,
    labelledField,
    listBlock,
    paragraphRow,
    readCopy,
  } from "../lib/admin-copy-ui.js";

  const { api, isDev } = JSON.parse(document.getElementById("admin-config")?.textContent || "{}");
  const status = document.querySelector("[data-status]");
  const login = document.querySelector("[data-login]");
  const app = document.querySelector("[data-app]");
  const results = document.querySelector("[data-results]");
  const bookEditor = document.querySelector("[data-book-editor]");
  const artEditor = document.querySelector("[data-art-editor]");
  const artList = document.querySelector("[data-art-list]");
  const supplyEditor = document.querySelector("[data-supply-editor]");
  const supplyList = document.querySelector("[data-supply-list]");
  const books = JSON.parse(document.getElementById("book-catalog")?.textContent || "[]");
  const artPieces = JSON.parse(document.getElementById("art-catalog")?.textContent || "[]");
  const supplies = JSON.parse(document.getElementById("supply-catalog")?.textContent || "[]");
  let currentBook = null;
  let currentArt = null;
  let currentSupply = null;
  let previewUrls = { book: "", art: "", supply: "", about: "" };
  let activityTimer = 0;
  let activityChain = Promise.resolve(null);
  let syncPending = false;
  let syncPendingAt = "";
  let syncWatchMark = 0;
  let showAllActivity = false;
  let lastActivity = null;
  let currentTab = "overview";
  let currentQueue = "currently-reading";
  let bookSnapshot = "";
  let saving = false;
  let saveWatch = 0;
  let syncWatch = 0;
  let featuredBaseline = [];
  const QUEUES = ["currently-reading", "featured", "five-star-no-note", "no-note", "missing-isbn"];
  const TABS = ["overview", "book", "art", "supply", "copy"];
  const MAX_NOTE = 8000;
  const pageCopy = JSON.parse(document.getElementById("page-copy")?.textContent || "{}");
  let copySnapshot = "";

  function onCopyClick(event) {
    const add = event.target.closest("[data-copy-add]");
    const remove = event.target.closest("[data-copy-remove]");
    if (add) {
      const name = add.dataset.copyAdd;
      const list = add.closest("[data-copy-block]")?.querySelector("[data-copy-list]");
      if (!list) return;
      if (list.children.length >= COPY_MAX.items) {
        setBanner("error", "That's as many as this page can hold.");
        return;
      }
      list.append(name === "paragraphs" ? paragraphRow("") : cardRow(name, { title: "", desc: "" }));
      return;
    }
    if (!remove) return;
    const card = remove.closest("[data-copy-item]");
    if (remove.dataset.copyRemove === "paragraphs" && card?.parentElement?.children.length <= 1) {
      setBanner("error", "About needs at least one paragraph.");
      return;
    }
    card?.remove();
  }

  function copyState() {
    const root = document.querySelector("[data-copy-root]");
    if (!root || !root.childElementCount) return "";
    return JSON.stringify(readCopy());
  }

  function aboutPhotoPending() {
    return Boolean(document.querySelector("[data-about-image]")?.files?.[0]);
  }

  function isCopyDirty() {
    return Boolean(copySnapshot) && (copyState() !== copySnapshot || aboutPhotoPending());
  }

  function renderCopyEditor() {
    const root = document.querySelector("[data-copy-root]");
    if (!root || root.childElementCount) {
      if (!copySnapshot) copySnapshot = copyState();
      return;
    }
    const hero = pageCopy.hero || {};
    const about = pageCopy.about || {};
    const work = pageCopy.work || {};
    const credentials = pageCopy.credentials || {};

    const home = copySection(
      "Home",
      "The big words on the first screen. The buttons stay as they are.",
      "home",
      copyPageLink,
    );
    home.append(
      labelledField("Small line above the title", hero.eyebrow, { path: "hero.eyebrow" }),
      labelledField("Headline", hero.headline, { path: "hero.headline" }),
      labelledField("Italic line", hero.headlineItalic, { path: "hero.headlineItalic" }),
      labelledField("Intro", hero.lede, { path: "hero.lede", long: true, max: COPY_MAX.medium, rows: 4 }),
    );

    const aboutSection = copySection(
      "About",
      "The portrait and the bio. Each box is its own paragraph. Fact chips stay as they are.",
      "about",
      copyPageLink,
    );
    aboutSection.append(
      aboutPhotoControl(about),
      labelledField("Small line above the title", about.eyebrow, { path: "about.eyebrow" }),
      labelledField("Headline", about.headline, { path: "about.headline" }),
      labelledField("Italic line", about.headlineItalic, { path: "about.headlineItalic" }),
      listBlock("paragraphs", "Add paragraph", about.paragraphs?.length ? about.paragraphs : [""], (value) => paragraphRow(value)),
    );

    const workSection = copySection(
      "Work with me",
      "The words on Work with me. The Instagram buttons stay as they are.",
      "work",
      copyPageLink,
    );
    workSection.append(
      labelledField("Short summary", pageCopy.workIntro || "", {
        path: "workIntro",
        long: true,
        max: COPY_MAX.medium,
        rows: 3,
        hint: "Used for search and link previews. It does not show as a heading on the page.",
      }),
      labelledField("Small line above the title", work.eyebrow, { path: "work.eyebrow" }),
      labelledField("Headline", work.headline, { path: "work.headline" }),
      labelledField("Italic line", work.headlineItalic, { path: "work.headlineItalic" }),
      labelledField("Intro", work.lede, { path: "work.lede", long: true, max: COPY_MAX.long, rows: 4 }),
      labelledField("Second paragraph", work.note, { path: "work.note", long: true, max: COPY_MAX.long, rows: 4 }),
      labelledField("Line under the photo", work.photoCaption, { path: "work.photoCaption", long: true, max: COPY_MAX.medium, rows: 2 }),
      copySubhead("What I like making"),
      labelledField("Small line", work.offersEyebrow, { path: "work.offersEyebrow" }),
      labelledField("Heading", work.offersHeadline, { path: "work.offersHeadline" }),
      labelledField("Intro", work.offersLede, { path: "work.offersLede", long: true, max: COPY_MAX.long, rows: 3 }),
      listBlock("offers", "Add offer", pageCopy.offers || [], (item) => cardRow("offers", item)),
      copySubhead("Ways it can look"),
      labelledField("Small line", work.packagesEyebrow, { path: "work.packagesEyebrow" }),
      labelledField("Heading", work.packagesHeadline, { path: "work.packagesHeadline" }),
      labelledField("Intro", work.packagesLede, { path: "work.packagesLede", long: true, max: COPY_MAX.long, rows: 3 }),
      listBlock("packages", "Add a way of working", pageCopy.packages || [], (item) => cardRow("packages", item)),
      labelledField("Note under those cards", work.pricesNote, { path: "work.pricesNote", long: true, max: COPY_MAX.medium, rows: 2 }),
      copySubhead("Also"),
      labelledField("Small heading", credentials.title, { path: "credentials.title" }),
      labelledField("Text", credentials.org, { path: "credentials.org", long: true, max: COPY_MAX.long, rows: 3 }),
      copySubhead("Closing"),
      labelledField("Heading", work.closeHeadline, { path: "work.closeHeadline" }),
      labelledField("Paragraph", work.closeLede, { path: "work.closeLede", long: true, max: COPY_MAX.long, rows: 4 }),
    );

    root.append(home, aboutSection, workSection);
    root.addEventListener("click", onCopyClick);
    bindDrop("about");
    const samePhoto = about.image && about.image === about.imageDark;
    resetDrop(
      "about",
      about.image || "",
      samePhoto
        ? "Drop a new photo to replace it."
        : "Drop a new photo to replace the light and dark portraits.",
    );
    copySnapshot = copyState();
  }

  function aboutPhotoControl(about) {
    const wrap = document.createElement("div");
    wrap.className = "mb-4";
    const heading = document.createElement("p");
    heading.className = "mb-2 text-sm font-medium text-foreground";
    heading.textContent = "Photo";
    const drop = document.createElement("button");
    drop.type = "button";
    drop.dataset.aboutDrop = "";
    drop.className =
      "mb-2 flex min-h-40 w-full flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-border bg-background px-4 py-6 text-center text-sm text-muted-foreground hover:border-primary";
    const preview = document.createElement("img");
    preview.dataset.aboutPreview = "";
    preview.alt = "";
    preview.className = "hidden max-h-72 rounded object-cover shadow";
    const label = document.createElement("span");
    label.dataset.aboutDropLabel = "";
    label.textContent = "Drop a photo here, or click to choose. Large phone photos are resized.";
    drop.append(preview, label);
    const input = document.createElement("input");
    input.type = "file";
    input.dataset.aboutImage = "";
    input.accept = "image/jpeg,image/png,image/webp,image/heic,image/heif";
    input.className = "hidden";
    const hint = document.createElement("p");
    hint.className = "mt-2 text-xs font-normal text-muted-foreground";
    hint.textContent =
      "This portrait is on About and on Work with me. A new photo is used in light and dark. The home photo stays as it is.";
    const alt = labelledField("Photo description", about.imageAlt, {
      path: "about.imageAlt",
      hint: "A short line for someone who cannot see the photo.",
    });
    alt.classList.remove("mb-4");
    wrap.append(heading, drop, input, hint, alt);
    return wrap;
  }

  function setBanner(kind, message) {
    if (!status) return;
    status.className =
      "py-2 text-sm " +
      (kind === "error" ? "text-accent" : kind === "busy" || kind === "ok" ? "text-foreground" : "text-muted-foreground");
    status.innerHTML = message;
  }

  function wait(ms) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  async function watchRebuild(label) {
    const id = ++saveWatch;
    for (let i = 0; i < 18; i++) {
      await wait(i === 0 ? 4000 : 8000);
      if (id !== saveWatch) return;
      try {
        const data = await call("/activity");
        renderActivity(data);
        const site = data.site || {};
        if (site.building) {
          setBanner(
            "busy",
            saveSteps({
              title: `Saved ${escapeHtml(label)}`,
              editor: "done",
              editorDetail: "This editor already has your edits.",
              github: "done",
              githubDetail: "Committed.",
              live: "busy",
              liveDetail: "Cloudflare is rebuilding. The public site still shows the old version until this finishes (usually about a minute).",
            }),
          );
          continue;
        }
        if (site.state === "failed") {
          setBanner(
            "error",
            saveSteps({
              title: `Saved ${escapeHtml(label)} to GitHub, but the rebuild failed.`,
              editor: "done",
              editorDetail: "This editor already has your edits.",
              github: "done",
              githubDetail: "Committed.",
              live: "error",
              liveDetail: "Try Save again, or check Cloudflare Pages.",
            }),
          );
          return;
        }
        if (site.live || site.deploymentsAvailable === false) {
          setBanner(
            "ok",
            saveSteps({
              title: `Saved ${escapeHtml(label)}`,
              editor: "done",
              editorDetail: "This editor already has your edits.",
              github: "done",
              githubDetail: "Committed.",
              live: site.deploymentsAvailable === false ? "busy" : "done",
              liveDetail:
                site.deploymentsAvailable === false
                  ? "GitHub has it. Refresh the public page in about a minute."
                  : "Live. Refresh the public page to see the change.",
            }),
          );
          if (site.live) return;
        }
      } catch {
        // Keep waiting — activity is best-effort.
      }
    }
    if (id !== saveWatch) return;
    setBanner(
      "ok",
      saveSteps({
        title: `Saved ${escapeHtml(label)} to GitHub`,
        editor: "done",
        editorDetail: "This editor already has your edits.",
        github: "done",
        githubDetail: "Committed.",
        live: "busy",
        liveDetail: "Cloudflare can take a couple of minutes. Refresh the public page shortly.",
      }),
    );
  }

  async function withSave(button, idleLabel, work) {
    if (saving) {
      setBanner("busy", "Already saving — wait for GitHub to finish this one.");
      return;
    }
    saving = true;
    if (button) {
      button.disabled = true;
      button.textContent = "Saving…";
    }
    setBanner(
      "busy",
      saveSteps({
        title: isDev ? "Saving on this computer…" : "Saving to GitHub… this can take a few seconds.",
        editor: "busy",
        editorDetail: "Writing your changes.",
        github: isDev ? "wait" : "busy",
        githubDetail: isDev ? "Skipped on this computer." : "Committing to the repository.",
        live: "wait",
        liveDetail: isDev
          ? "The public site on this computer updates after you refresh."
          : "Cloudflare rebuilds the live site after GitHub — usually about a minute.",
      }),
    );
    try {
      const result = await work();
      const label = result?.label || "changes";
      if (isDev) {
        setBanner(
          "ok",
          saveSteps({
            title: `Saved ${escapeHtml(label)}`,
            editor: "done",
            editorDetail: "Saved.",
            github: "wait",
            githubDetail: "Skipped on this computer.",
            live: "wait",
            liveDetail: result?.hint || "Refresh the site on this computer to see it.",
          }),
        );
      } else {
        setBanner(
          "ok",
          saveSteps({
            title: `Saved ${escapeHtml(label)} to GitHub`,
            editor: "done",
            editorDetail: "This editor already has your edits.",
            github: "done",
            githubDetail: "Committed.",
            live: "busy",
            liveDetail: "Cloudflare is rebuilding the live site — usually about a minute.",
          }),
        );
        watchRebuild(label);
      }
      loadActivity();
    } catch (error) {
      setBanner("error", error instanceof Error ? error.message : "Save failed.");
    } finally {
      saving = false;
      if (button) {
        button.disabled = false;
        button.textContent = idleLabel;
      }
    }
  }

  function renderActivity(data) {
    lastActivity = data;
    const logEl = document.querySelector("[data-activity-log]");
    const more = document.querySelector("[data-activity-more]");
    const sync = data.sync || {};
    if (logEl) {
      const events = mergeTimelineEvents(data, {
        active: syncPending,
        watchMark: syncWatchMark,
        at: syncPendingAt,
      });
      const limit = showAllActivity ? 20 : 3;
      if (!events.length) {
        logEl.innerHTML = `<li class="col-span-3 text-muted-foreground">No admin or sync events recorded yet.</li>`;
      } else {
        logEl.innerHTML = activityLog(events.slice(0, limit), sync, showAllActivity);
      }
      if (more) {
        const hiddenCount = Math.min(events.length, 20) - 3;
        more.classList.toggle("hidden", hiddenCount <= 0 || showAllActivity);
        more.textContent = hiddenCount > 0 ? `Show all (${Math.min(events.length, 20)})` : "Show all";
      }
    }
  }

  function loadActivity(options = {}) {
    const run = activityChain.then(() => fetchActivity(options));
    activityChain = run.then(
      (data) => data,
      () => null,
    );
    return run;
  }

  async function fetchActivity(options = {}) {
    const manual = Boolean(options.manual);
    const button = document.querySelector("[data-activity-refresh]");
    const checkedEl = document.querySelector("[data-activity-checked]");
    if (manual && button) {
      button.disabled = true;
      button.textContent = "Refreshing…";
    }
    try {
      const data = await call("/activity");
      renderActivity(data);
      if (checkedEl) {
        const checked = `Checked ${formatWhen(new Date().toISOString())}`;
        checkedEl.textContent = data.site?.deploymentsError ? `${checked} · Cloudflare: ${data.site.deploymentsError}` : checked;
        checkedEl.className = "mb-4 text-xs " + (data.site?.deploymentsError ? "text-accent" : "text-muted-foreground");
      }
      if (activityTimer) window.clearInterval(activityTimer);
      activityTimer = window.setInterval(() => loadActivity(), data.site?.building ? 15000 : 60000);
      return data;
    } catch (error) {
      if (checkedEl) {
        checkedEl.textContent = error instanceof Error ? error.message : "Could not load activity.";
        checkedEl.className = "mb-4 text-xs text-accent";
      }
      return lastActivity;
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = "Refresh";
      }
    }
  }

  // Tracks a manual sync through both of its phases: the GitHub Action fetching
  // and committing the shelf, then (if it committed) Cloudflare rebuilding the
  // public site. Keeps rendering step pills the whole way instead of stopping
  // once GitHub is merely detected.
  async function watchSyncProgress(previousMark) {
    const id = ++syncWatch;
    const githubDeadline = Date.now() + (isDev ? 0 : 120000);
    let data = await loadActivity({ manual: true });
    while (!isDev && id === syncWatch && Date.now() < githubDeadline && latestMark(data) <= previousMark) {
      setBanner(
        "busy",
        syncSteps({
          title: "Syncing with Goodreads…",
          request: "done",
          requestDetail: "Sent.",
          github: "busy",
          githubDetail: "Fetching the shelf. This usually takes under a minute.",
          live: "wait",
          liveDetail: "Waiting for GitHub to finish.",
        }),
      );
      await wait(4000);
      data = await loadActivity({ manual: true });
    }
    if (id !== syncWatch) return data;
    renderActivity(data);

    if (latestMark(data) <= previousMark) {
      setBanner(
        "ok",
        syncSteps({
          title: "Sync is still running",
          request: "done",
          requestDetail: "Sent.",
          github: "busy",
          githubDetail: "Taking longer than usual. Recent will update here as soon as it finishes.",
          live: "wait",
          liveDetail: "Waiting for GitHub to finish.",
        }),
      );
      return data;
    }

    if (data?.sync?.ok === false) {
      setBanner(
        "error",
        syncSteps({
          title: "Goodreads sync had a problem",
          request: "done",
          requestDetail: "Sent.",
          github: "error",
          githubDetail: "See Details for what GitHub reported.",
          live: "wait",
          liveDetail: "The previous shelf was kept, so nothing will rebuild.",
        }),
      );
      return data;
    }

    const title = syncOutcome(data);
    const rebuildDeadline = Date.now() + (isDev ? 0 : 150000);
    while (!isDev && id === syncWatch && Date.now() < rebuildDeadline) {
      const site = data.site || {};
      if (site.live || site.deploymentsAvailable === false) {
        setBanner(
          "ok",
          syncSteps({
            title,
            request: "done",
            requestDetail: "Sent.",
            github: "done",
            githubDetail: "Shelf checked.",
            live: site.deploymentsAvailable === false ? "busy" : "done",
            liveDetail:
              site.deploymentsAvailable === false
                ? "GitHub has it. Refresh the public page in about a minute."
                : "Live. Refresh the public page to see the change.",
          }),
        );
        return data;
      }
      if (site.state === "failed") {
        setBanner(
          "error",
          syncSteps({
            title,
            request: "done",
            requestDetail: "Sent.",
            github: "done",
            githubDetail: "Shelf checked.",
            live: "error",
            liveDetail: "GitHub has the shelf, but the rebuild failed. Check Cloudflare Pages.",
          }),
        );
        return data;
      }
      setBanner(
        "busy",
        syncSteps({
          title,
          request: "done",
          requestDetail: "Sent.",
          github: "done",
          githubDetail: "Shelf checked.",
          live: "busy",
          liveDetail: "Cloudflare is rebuilding. The public site still shows the old version until this finishes (usually about a minute).",
        }),
      );
      await wait(4000);
      data = await loadActivity({ manual: true });
      renderActivity(data);
    }
    if (id !== syncWatch) return data;
    setBanner(
      "ok",
      syncSteps({
        title,
        request: "done",
        requestDetail: "Sent.",
        github: "done",
        githubDetail: "Shelf checked.",
        live: "busy",
        liveDetail: "Cloudflare can take a couple of minutes. Refresh the public page shortly.",
      }),
    );
    return data;
  }

  async function blobToJpeg(file, maxBytes = 2 * 1024 * 1024) {
    let bitmap;
    try {
      bitmap = await createImageBitmap(file);
    } catch {
      const name = `${file.type} ${file.name}`.toLowerCase();
      throw new Error(
        name.includes("heic") || name.includes("heif")
          ? "This iPhone photo is HEIC. Save it as JPG, or try Safari."
          : "Use a JPG, PNG, or WebP photo.",
      );
    }
    const maxEdge = 2000;
    const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.max(1, Math.round(bitmap.width * scale));
    canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    canvas.getContext("2d").drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close?.();
    let quality = 0.88;
    let blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", quality));
    while (blob && blob.size > maxBytes && quality > 0.5) {
      quality -= 0.08;
      blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", quality));
    }
    if (!blob || blob.size > maxBytes) throw new Error("Photo is still too large after shrinking (2 MB max).");
    return blob;
  }

  async function preparePhoto(file) {
    const ext = `.${(file.name.split(".").pop() || "jpg").toLowerCase()}`;
    const allowed = new Set([".jpg", ".jpeg", ".png", ".webp"]);
    const blob = file.size <= 2 * 1024 * 1024 && allowed.has(ext) ? file : await blobToJpeg(file);
    const filename = blob === file ? file.name : "photo.jpg";
    return { filename, contentBase64: toBase64(await blob.arrayBuffer()) };
  }

  function displayUrl(value) {
    return value && value !== "#" ? value : "";
  }

  function firstHttpUrl(value) {
    const text = String(value || "")
      .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, "")
      .trim();
    if (!text || text === "#") return "";
    const http = text.match(/https?:\/\/[^\s<>"')\]]+/i);
    if (http) return http[0].replace(/[.,);]+$/g, "");
    const amazon = text.match(/(?:www\.)?amazon\.(?:co\.uk|com)\/[^\s<>"')\]]+/i);
    if (amazon) return `https://${amazon[0]}`.replace(/[.,);]+$/g, "");
    const short = text.match(/(?:amzn\.(?:eu|to|asia)|a\.co)\/[^\s<>"')\]]+/i);
    if (short) return `https://${short[0]}`.replace(/[.,);]+$/g, "");
    return "";
  }

  function taggedAmazon(value) {
    const raw = firstHttpUrl(value);
    if (!raw) return "";
    const tag = JSON.parse(document.getElementById("affiliate-config")?.textContent || "{}").amazonTag || "";
    return tagAmazonUrl(raw, tag);
  }

  function updateAmazonPreview() {
    const el = document.querySelector("[data-supply-amazon-preview]");
    if (!el) return;
    const raw = document.querySelector("[data-supply-amazon]")?.value || "";
    const cleaned = taggedAmazon(raw);
    const pasted = String(raw)
      .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, "")
      .trim();
    if (!pasted || pasted === "#") {
      el.textContent = "Paste the product page address — a long Amazon link is fine. We tidy it and add your tag on save.";
      el.classList.remove("text-accent");
      return;
    }
    if (!cleaned) {
      el.textContent = "That doesn't look like an Amazon link yet.";
      el.classList.add("text-accent");
      return;
    }
    el.textContent = `Will save as ${cleaned}`;
    el.classList.remove("text-accent");
  }

  async function call(path, options = {}) {
    const response = await fetch(`${api}/admin/api${path}`, {
      credentials: "include",
      cache: "no-store",
      headers: { "Content-Type": "application/json", ...options.headers },
      ...options,
    });
    const type = response.headers.get("content-type") || "";
    if (!type.includes("json")) {
      throw new Error(
        response.status === 404
          ? "The editor API is not deployed. Confirm the Pages project includes the functions/ folder, then retry the deploy."
          : "Cloudflare Access is still blocking /admin/api. Path must be /admin* and you must be signed in.",
      );
    }
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
    return data;
  }

  function showApp(email) {
    login?.classList.add("hidden");
    app?.classList.remove("hidden");
    featuredBaseline = books.filter((book) => book.featured).map((book) => book.slug);
    renderArtList();
    renderSupplyList();
    renderFeaturedBoard();
    renderCopyEditor();
    const tabs = document.querySelector("[data-tabs]");
    tabs?.classList.remove("hidden");
    tabs?.classList.add("flex");
    if (status) {
      if (email && email !== "local") {
        status.textContent = `Signed in as ${email}. Saves go live after the site rebuilds (usually a minute).`;
      } else if (isDev) {
        status.textContent = "Editor is connected on this computer.";
      } else {
        status.textContent = "Editor is connected. Saves go live after the site rebuilds (usually a minute).";
      }
    }
    loadActivity();
    applyUrlState();
  }

  function defaultQueue() {
    return books.some((book) => book.status === "currently-reading") ? "currently-reading" : "five-star-no-note";
  }

  function syncUrl() {
    const params = new URLSearchParams();
    params.set("tab", currentTab);
    if (currentTab === "book") params.set("queue", currentQueue);
    if (currentTab === "book" && currentBook?.slug) params.set("slug", currentBook.slug);
    if (currentTab === "art" && currentArt?.slug && !currentArt.create) params.set("slug", currentArt.slug);
    if (currentTab === "supply" && currentSupply?.slug && !currentSupply.create) params.set("slug", currentSupply.slug);
    const next = `${window.location.pathname}?${params.toString()}`;
    if (`${window.location.pathname}${window.location.search}` !== next) {
      history.replaceState(null, "", next);
    }
  }

  function applyUrlState() {
    const params = new URLSearchParams(window.location.search);
    let tab = params.get("tab") || "";
    const queue = params.get("queue") || "";
    const slug = params.get("slug") || "";
    if (!TABS.includes(tab)) {
      tab = slug || queue ? "book" : "overview";
    }
    currentTab = tab;
    currentQueue = QUEUES.includes(queue) ? queue : defaultQueue();
    paintTab(currentTab);
    if (currentTab === "book") {
      paintQueue();
      renderQueue();
      if (slug) {
        const book = books.find((item) => item.slug === slug);
        if (book) fillBook(book, { skipUrl: true });
        else if (status) status.textContent = "That book is not on the site.";
      }
    } else if (currentTab === "art" && slug) {
      const piece = artPieces.find((item) => item.slug === slug);
      if (piece) fillArt({ ...piece, create: false });
      else if (status) status.textContent = "That painting is not on the site.";
    } else if (currentTab === "supply" && slug) {
      const item = supplies.find((entry) => entry.slug === slug);
      if (item) fillSupply({ ...item, create: false });
      else if (status) status.textContent = "That tool is not on the site.";
    }
    syncUrl();
  }

  function paintTab(kind) {
    currentTab = kind;
    document.querySelectorAll("[data-tab]").forEach((button) => {
      const on = button.dataset.tab === kind;
      button.setAttribute("aria-selected", on ? "true" : "false");
      button.classList.toggle("border-accent", on);
      button.classList.toggle("text-foreground", on);
      button.classList.toggle("border-transparent", !on);
      button.classList.toggle("text-muted-foreground", !on);
    });
    document.querySelectorAll("[data-panel]").forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.panel !== kind);
    });
  }

  function setTab(kind) {
    if (kind !== currentTab && !confirmLeave()) return;
    if (kind !== "book") {
      currentBook = null;
      bookEditor?.classList.add("hidden");
    }
    paintTab(kind);
    if (kind === "book") {
      paintQueue();
      renderQueue();
      document.querySelector("[data-book-empty]")?.classList.toggle("hidden", Boolean(currentBook));
    }
    if (kind === "art") document.querySelector("[data-art-empty]")?.classList.toggle("hidden", Boolean(currentArt));
    if (kind === "supply") document.querySelector("[data-supply-empty]")?.classList.toggle("hidden", Boolean(currentSupply));
    syncUrl();
  }

  function confirmLeave() {
    if (!isBookDirty() && !isCopyDirty()) return true;
    return window.confirm("Discard unsaved changes?");
  }

  function bookFormState() {
    return JSON.stringify({
      title: document.querySelector("[data-book-title]")?.value || "",
      author: document.querySelector("[data-book-author]")?.value || "",
      genre: document.querySelector("[data-book-genre]")?.value || "",
      note: document.querySelector("[data-book-note]")?.value || "",
      featured: Boolean(document.querySelector("[data-book-featured]")?.checked),
      isbn: document.querySelector("[data-book-isbn]")?.value || "",
      isbn10: document.querySelector("[data-book-isbn10]")?.value || "",
      bookshop: document.querySelector("[data-book-bookshop]")?.value || "",
      amazon: document.querySelector("[data-book-amazon]")?.value || "",
      cover: document.querySelector("[data-book-cover]")?.files?.[0]?.name || "",
    });
  }

  function isBookDirty() {
    return Boolean(currentBook) && !bookEditor?.classList.contains("hidden") && bookFormState() !== bookSnapshot;
  }

  function previewBuy({ isbn, isbn10, bookshop, amazon }) {
    const asUrl = (value) => {
      const raw = String(value || "").trim();
      if (!raw || raw === "#") return "";
      return /^https?:\/\//i.test(raw) ? raw : "";
    };
    const cleanIsbn = (value) => String(value || "").replace(/[^\dXx]/g, "");
    const cfg = JSON.parse(document.getElementById("affiliate-config")?.textContent || "{}");
    const isbn13 = cleanIsbn(isbn);
    const isbn10c = cleanIsbn(isbn10);
    const shop =
      asUrl(bookshop) ||
      (cfg.bookshopUkId && isbn13 ? `https://uk.bookshop.org/a/${cfg.bookshopUkId}/${isbn13}` : "");
    const asin = isbn10c || isbn13;
    const amazonUrl =
      taggedAmazon(amazon) ||
      (cfg.amazonTag && asin
        ? `https://www.amazon.co.uk/dp/${asin}/ref=nosim?tag=${encodeURIComponent(cfg.amazonTag)}`
        : "");
    return { bookshop: shop, amazon: amazonUrl };
  }

  function updateBuyPreview() {
    const el = document.querySelector("[data-book-buy]");
    if (!el) return;
    const buy = previewBuy({
      isbn: document.querySelector("[data-book-isbn]")?.value,
      isbn10: document.querySelector("[data-book-isbn10]")?.value,
      bookshop: document.querySelector("[data-book-bookshop]")?.value,
      amazon: document.querySelector("[data-book-amazon]")?.value,
    });
    const parts = [];
    if (buy.bookshop) {
      parts.push(
        `<a class="text-primary underline-offset-4 hover:underline" href="${escapeHtml(buy.bookshop)}" target="_blank" rel="sponsored noopener noreferrer">Bookshop.org</a>`,
      );
    }
    if (buy.amazon) {
      parts.push(
        `<a class="text-primary underline-offset-4 hover:underline" href="${escapeHtml(buy.amazon)}" target="_blank" rel="sponsored noopener noreferrer">Amazon</a>`,
      );
    }
    el.innerHTML = parts.length ? parts.join(" · ") : "Add an ISBN or a full URL to generate buy links.";
  }

  function updateNoteCount() {
    const el = document.querySelector("[data-book-note-count]");
    const n = (document.querySelector("[data-book-note]")?.value || "").length;
    if (!el) return;
    el.textContent = `${n} / ${MAX_NOTE}`;
    el.classList.toggle("text-accent", n > MAX_NOTE);
    el.classList.toggle("text-muted-foreground", n <= MAX_NOTE);
  }

  function siteOrigin() {
    const cfg = JSON.parse(document.getElementById("affiliate-config")?.textContent || "{}");
    return String(cfg.siteOrigin || "https://sashabookandbrush.com").replace(/\/$/, "");
  }

  function copyText(label, value) {
    const text = String(value || "").trim();
    if (!text) {
      if (status) status.textContent = `No ${label} to copy yet.`;
      return;
    }
    navigator.clipboard.writeText(text).then(
      () => {
        if (status) status.textContent = `Copied ${label}`;
      },
      () => {
        if (status) status.textContent = "Could not copy — long-press the link instead.";
      },
    );
  }

  // Passed into copySection() as its "Copy link" click callback.
  function copyPageLink(copyName) {
    const origin = siteOrigin();
    if (copyName === "home") copyText("Home link", origin);
    else if (copyName === "about") copyText("About link", `${origin}/about`);
    else if (copyName === "work") copyText("Work with me link", `${origin}/work`);
  }

  function copyChip(label, value) {
    if (!value) return "";
    return `<button type="button" class="rounded border border-border px-2.5 py-1 text-xs text-foreground hover:border-primary" data-copy-value="${escapeHtml(value)}" data-copy-label="${escapeHtml(label)}">${escapeHtml(label)}</button>`;
  }

  function nextFeaturedOrder() {
    const max = books.reduce((high, book) => {
      if (!book.featured) return high;
      return Math.max(high, Number(book.order) || 0);
    }, 0);
    return max + 1;
  }

  function searchQuery() {
    return (document.querySelector("[data-search]")?.value || "").trim().toLowerCase();
  }

  function queueCount(id) {
    if (id === "currently-reading") return books.filter((book) => book.status === "currently-reading").length;
    if (id === "featured") return books.filter((book) => book.featured).length;
    if (id === "five-star-no-note") return books.filter((book) => book.rating === 5 && !String(book.note || "").trim()).length;
    if (id === "no-note") return books.filter((book) => !String(book.note || "").trim()).length;
    if (id === "missing-isbn") return books.filter((book) => !book.isbn && !book.isbn10).length;
    return 0;
  }

  function queueBooks() {
    const q = searchQuery();
    if (q.length >= 2) {
      return books.filter((book) => `${book.title} ${book.author} ${book.slug}`.toLowerCase().includes(q));
    }
    if (currentQueue === "currently-reading") return books.filter((book) => book.status === "currently-reading");
    if (currentQueue === "featured") {
      return books.filter((book) => book.featured).toSorted((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
    }
    if (currentQueue === "five-star-no-note") {
      return books.filter((book) => book.rating === 5 && !String(book.note || "").trim());
    }
    if (currentQueue === "no-note") return books.filter((book) => !String(book.note || "").trim());
    if (currentQueue === "missing-isbn") return books.filter((book) => !book.isbn && !book.isbn10);
    return [];
  }

  function bookRow(book) {
    const selected = currentBook?.slug === book.slug;
    const badges = [];
    if (book.rating > 0) badges.push(`${book.rating}★`);
    badges.push(String(book.note || "").trim() ? "Note" : "No note");
    if (book.featured) badges.push("Home");
    if (!book.isbn && !book.isbn10) badges.push("No ISBN");
    const badgeHtml = badges
      .map((label) => {
        const accent = label === "No note" || label === "No ISBN";
        return `<span class="${accent ? "text-accent" : "text-muted-foreground"}">${escapeHtml(label)}</span>`;
      })
      .join(" · ");
    const cover = book.coverUrl
      ? `<img src="${escapeHtml(book.coverUrl)}" alt="" class="h-14 w-9 shrink-0 rounded object-cover bg-muted" />`
      : `<span class="h-14 w-9 shrink-0 rounded bg-muted"></span>`;
    const ring = selected ? "border-primary bg-muted" : "border-border hover:border-primary";
    return `<li><button type="button" class="flex w-full items-start gap-3 rounded-lg border px-2 py-2 text-left ${ring}" data-slug="${escapeHtml(book.slug)}">${cover}<span class="min-w-0 flex-1"><span class="font-medium text-foreground">${escapeHtml(book.title)}</span><span class="mt-0.5 block text-xs text-muted-foreground">${escapeHtml(book.author)}</span><span class="mt-1 block text-xs">${badgeHtml}</span></span></button></li>`;
  }

  function paintQueue() {
    document.querySelectorAll("[data-queue]").forEach((button) => {
      const on = button.dataset.queue === currentQueue && searchQuery().length < 2;
      button.setAttribute("aria-selected", on ? "true" : "false");
      button.classList.toggle("border-accent", on);
      button.classList.toggle("text-foreground", on);
      button.classList.toggle("border-transparent", !on);
      button.classList.toggle("text-muted-foreground", !on);
    });
    document.querySelectorAll("[data-queue-n]").forEach((el) => {
      el.textContent = String(queueCount(el.getAttribute("data-queue-n") || ""));
    });
  }

  function renderQueue() {
    if (!results) return;
    paintQueue();
    const matches = queueBooks();
    const q = searchQuery();
    const searching = q.length >= 2;
    const cap = searching || currentQueue === "no-note" ? 40 : matches.length;
    const shown = matches.slice(0, cap);
    const count = document.querySelector("[data-queue-count]");
    if (count) {
      if (searching) {
        count.textContent =
          shown.length < matches.length
            ? `${shown.length} of ${matches.length} matches`
            : `${matches.length} match${matches.length === 1 ? "" : "es"}`;
      } else {
        count.textContent =
          shown.length < matches.length
            ? `Showing ${shown.length} of ${matches.length}`
            : `${matches.length} book${matches.length === 1 ? "" : "s"}`;
      }
    }
    results.innerHTML = shown.length
      ? shown.map(bookRow).join("")
      : `<li class="px-1 py-6 text-center text-muted-foreground">${searching ? "No titles match." : "Nothing in this list."}</li>`;
    updateNextButton();
  }

  function setQueue(queue) {
    if (!confirmLeave()) return;
    currentQueue = QUEUES.includes(queue) ? queue : defaultQueue();
    const search = document.querySelector("[data-search]");
    if (search) search.value = "";
    currentBook = null;
    bookEditor?.classList.add("hidden");
    document.querySelector("[data-book-empty]")?.classList.remove("hidden");
    renderQueue();
    syncUrl();
  }

  function nextInQueue() {
    if (!currentBook) return null;
    const list = queueBooks();
    const index = list.findIndex((book) => book.slug === currentBook.slug);
    if (index < 0) return list[0] || null;
    return list[index + 1] || null;
  }

  function updateNextButton() {
    const button = document.querySelector("[data-book-next]");
    if (!button) return;
    const next = nextInQueue();
    button.classList.toggle("hidden", !next);
    if (next) button.textContent = "Next →";
  }

  function featuredList() {
    return books
      .filter((book) => book.featured)
      .toSorted((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
  }

  function renderFeaturedBoard() {
    const list = document.querySelector("[data-featured-board]");
    const count = document.querySelector("[data-featured-count]");
    const featured = featuredList();
    if (count) {
      count.textContent =
        featured.length > 8
          ? `Featured ${featured.length} / target 6–8 — maybe rotate one off before adding.`
          : `Featured ${featured.length} / target 6–8`;
    }
    if (!list) return;
    if (!featured.length) {
      list.innerHTML = `<li class="text-muted-foreground">No featured books yet.</li>`;
      return;
    }
    list.innerHTML = featured
      .map((book, index) => {
        const cover = book.coverUrl
          ? `<img src="${escapeHtml(book.coverUrl)}" alt="" class="h-10 w-7 shrink-0 rounded object-cover bg-muted" />`
          : `<span class="h-10 w-7 shrink-0 rounded bg-muted"></span>`;
        return `<li class="flex items-center gap-2 rounded-lg border border-border px-2 py-1.5" data-featured-slug="${escapeHtml(book.slug)}">${cover}<span class="w-4 text-xs text-muted-foreground">${index + 1}</span><button type="button" class="min-w-0 flex-1 truncate text-left text-sm font-medium text-foreground" data-featured-open>${escapeHtml(book.title)}</button><button type="button" class="rounded border border-border px-2 py-1 text-xs" data-featured-up ${index === 0 ? "disabled" : ""}>↑</button><button type="button" class="rounded border border-border px-2 py-1 text-xs" data-featured-down ${index === featured.length - 1 ? "disabled" : ""}>↓</button><button type="button" class="rounded border border-border px-2 py-1 text-xs" data-featured-off>Remove</button></li>`;
      })
