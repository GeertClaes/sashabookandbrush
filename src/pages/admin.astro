  <script define:vars={{ api, isDev }}>
  const status = document.querySelector("[data-status]");
  const login = document.querySelector("[data-login]");
  const app = document.querySelector("[data-app]");
  const results = document.querySelector("[data-results]");
  const bookEditor = document.querySelector("[data-book-editor]");
  const artEditor = document.querySelector("[data-art-editor]");
  const artList = document.querySelector("[data-art-list]");
  const supplyEditor = document.querySelector("[data-supply-editor]");
  const supplyList = document.querySelector("[data-supply-list]");
  const books = JSON.parse(document.getElementById("book-catalog")?.textContent || "[]");
  const artPieces = JSON.parse(document.getElementById("art-catalog")?.textContent || "[]");
  const supplies = JSON.parse(document.getElementById("supply-catalog")?.textContent || "[]");
  let currentBook = null;
  let currentArt = null;
  let currentSupply = null;
  let previewUrls = { book: "", art: "", supply: "" };
  let activityTimer = 0;
  let activityLoading = false;
  let currentTab = "overview";
  let currentQueue = "currently-reading";
  let bookSnapshot = "";
  let saving = false;
  let saveWatch = 0;
  let featuredBaseline = [];
  const QUEUES = ["currently-reading", "featured", "five-star-no-note", "no-note", "missing-isbn"];
  const TABS = ["overview", "book", "art", "supply"];
  const MAX_NOTE = 8000;

  function setBanner(kind, message) {
    if (!status) return;
    status.className =
      "sticky top-16 z-40 mb-6 rounded-lg bg-background/95 px-3 py-2 text-sm backdrop-blur-sm " +
      (kind === "error"
        ? "border border-accent text-accent"
        : kind === "busy"
          ? "border border-primary text-foreground"
          : kind === "ok"
            ? "border border-primary text-foreground"
            : "border border-transparent text-muted-foreground");
    status.innerHTML = message;
  }

  function saveSteps({ title, editor, github, live, hint }) {
    const pill = (state, label) => {
      const cls =
        state === "done"
          ? "text-foreground"
          : state === "busy"
            ? "text-primary"
            : state === "error"
              ? "text-accent"
              : "text-muted-foreground";
      const mark = state === "done" ? "✓" : state === "busy" ? "…" : state === "error" ? "!" : "·";
      return `<span class="${cls}">${mark} ${label}</span>`;
    };
    return `<p class="font-medium">${title}</p><p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs">${pill(editor, "This editor")}${pill(github, "GitHub")}${pill(live, "Live site")}</p>${hint ? `<p class="mt-1 text-xs text-muted-foreground">${hint}</p>` : ""}`;
  }

  function wait(ms) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  async function watchRebuild(label) {
    const id = ++saveWatch;
    for (let i = 0; i < 18; i++) {
      await wait(i === 0 ? 4000 : 8000);
      if (id !== saveWatch) return;
      try {
        const data = await call("/activity");
        renderActivity(data);
        const site = data.site || {};
        if (site.building) {
          setBanner(
            "busy",
            saveSteps({
              title: `Saved ${escapeHtml(label)}`,
              editor: "done",
              github: "done",
              live: "busy",
              hint: "Cloudflare is rebuilding. The public site still shows the old version until this finishes (usually about a minute).",
            }),
          );
          continue;
        }
        if (site.state === "failed") {
          setBanner(
            "error",
            saveSteps({
              title: `Saved ${escapeHtml(label)} to GitHub, but the rebuild failed.`,
              editor: "done",
              github: "done",
              live: "error",
              hint: "Try Save again, or check Cloudflare Pages.",
            }),
          );
          return;
        }
        if (site.live || site.deploymentsAvailable === false) {
          setBanner(
            "ok",
            saveSteps({
              title: `Saved ${escapeHtml(label)}`,
              editor: "done",
              github: "done",
              live: site.deploymentsAvailable === false ? "busy" : "done",
              hint:
                site.deploymentsAvailable === false
                  ? "GitHub has it. Refresh the public page in about a minute."
                  : "Live. Refresh the public page to see the change.",
            }),
          );
          if (site.live) return;
        }
      } catch {
        // Keep waiting — activity is best-effort.
      }
    }
    if (id !== saveWatch) return;
    setBanner(
      "ok",
      saveSteps({
        title: `Saved ${escapeHtml(label)} to GitHub`,
        editor: "done",
        github: "done",
        live: "busy",
        hint: "Cloudflare can take a couple of minutes. Refresh the public page shortly.",
      }),
    );
  }

  async function withSave(button, idleLabel, work) {
    if (saving) {
      setBanner("busy", "Already saving — wait for GitHub to finish this one.");
      return;
    }
    saving = true;
    if (button) {
      button.disabled = true;
      button.textContent = "Saving…";
    }
    setBanner(
      "busy",
      saveSteps({
        title: isDev ? "Saving on this computer…" : "Saving to GitHub… this can take a few seconds.",
        editor: "busy",
        github: isDev ? "wait" : "busy",
        live: "wait",
        hint: isDev ? "The public site on this computer updates after you refresh." : "Then Cloudflare rebuilds the live site — usually about a minute.",
      }),
    );
    try {
      const result = await work();
      const label = result?.label || "changes";
      if (isDev) {
        setBanner(
          "ok",
          saveSteps({
            title: `Saved ${escapeHtml(label)}`,
            editor: "done",
            github: "wait",
            live: "wait",
            hint: result?.hint || "Refresh the site on this computer to see it.",
          }),
        );
      } else {
        setBanner(
          "ok",
          saveSteps({
            title: `Saved ${escapeHtml(label)} to GitHub`,
            editor: "done",
            github: "done",
            live: "busy",
            hint: "Cloudflare is rebuilding the live site — usually about a minute. This editor already has your edits.",
          }),
        );
        watchRebuild(label);
      }
      loadActivity();
    } catch (error) {
      setBanner("error", error instanceof Error ? error.message : "Save failed.");
    } finally {
      saving = false;
      if (button) {
        button.disabled = false;
        button.textContent = idleLabel;
      }
    }
  }

  function formatWhen(value) {
    if (!value) return "not yet";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleString("en-GB", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "Europe/London",
    });
  }

  function renderActivity(data) {
    const siteEl = document.querySelector("[data-activity-site]");
    const syncEl = document.querySelector("[data-activity-sync]");
    const logEl = document.querySelector("[data-activity-log]");
    const site = data.site || {};
    const sync = data.sync || {};
    if (siteEl) {
      if (site.deploymentsAvailable === false && !site.deploymentsError) {
        siteEl.textContent =
          "Saves are stored immediately. The public site usually updates within a minute after Cloudflare rebuilds. You do not need extra tokens for that.";
      } else {
        const when = site.at ? ` · ${formatWhen(site.at)}` : "";
        const trigger = site.trigger ? ` · ${site.trigger}` : "";
        siteEl.textContent = `${site.label || "Rebuild status unknown"}${when}${trigger}`;
      }
    }
    if (syncEl) {
      const reading = (sync.reading || [])
        .map((book) => {
          const pct = typeof book.progress === "number" ? ` (${book.progress}%)` : "";
          return escapeHtml(`${book.title}${pct}`);
        })
        .join("<br>");
      const changes = (sync.changes || []).map((item) => escapeHtml(item)).join("<br>");
      const tone = sync.ok ? "text-foreground" : "text-accent";
      const headline = sync.ok ? "Goodreads sync succeeded" : "Goodreads sync had a problem";
      const extra = sync.warning || sync.error || "";
      syncEl.innerHTML = `
        <p class="${tone} font-medium">${headline}</p>
        <p class="mt-1 text-xs text-muted-foreground">${escapeHtml(formatWhen(sync.at))} · ${escapeHtml(String(sync.readingCount || 0))} currently reading · ${escapeHtml(String(sync.upNextCount || 0))} up next</p>
        ${extra ? `<p class="mt-2 text-muted-foreground">${escapeHtml(extra)}</p>` : ""}
        ${reading ? `<p class="mt-3 text-muted-foreground"><span class="text-foreground">Now reading</span><br>${reading}</p>` : ""}
        ${changes ? `<p class="mt-3 text-muted-foreground"><span class="text-foreground">Changes</span><br>${changes}</p>` : `<p class="mt-3 text-muted-foreground">No currently-reading changes in that sync.</p>`}
        ${site.deploymentsError ? `<p class="mt-3 text-xs text-muted-foreground">${escapeHtml(site.deploymentsError)}</p>` : ""}
      `;
    }
    if (logEl) {
      const events = data.events || [];
      if (!events.length) {
        logEl.innerHTML = `<li class="text-muted-foreground">No admin or sync events recorded yet.</li>`;
      } else {
        logEl.innerHTML = events
          .slice(0, 20)
          .map((event) => {
            const mark = event.ok === false ? "Failed" : event.type === "goodreads" ? "Goodreads" : "Editor";
            return `<li class="rounded-lg border border-border px-3 py-2"><p class="font-medium text-foreground">${escapeHtml(event.title)}</p><p class="mt-0.5 text-xs text-muted-foreground">${escapeHtml(mark)} · ${escapeHtml(formatWhen(event.at))}${event.by ? ` · ${escapeHtml(event.by)}` : ""}</p>${event.detail ? `<p class="mt-1 text-muted-foreground">${escapeHtml(event.detail)}</p>` : ""}</li>`;
          })
          .join("");
      }
    }
  }

  async function loadActivity(options = {}) {
    if (activityLoading) return;
    activityLoading = true;
    const manual = Boolean(options.manual);
    const button = document.querySelector("[data-activity-refresh]");
    const checkedEl = document.querySelector("[data-activity-checked]");
    if (manual && button) {
      button.disabled = true;
      button.textContent = "Refreshing…";
    }
    try {
      const data = await call("/activity");
      renderActivity(data);
      if (checkedEl) checkedEl.textContent = `Checked ${formatWhen(new Date().toISOString())}`;
      if (activityTimer) window.clearInterval(activityTimer);
      activityTimer = window.setInterval(() => loadActivity(), data.site?.building ? 15000 : 60000);
    } catch (error) {
      const siteEl = document.querySelector("[data-activity-site]");
      if (siteEl) siteEl.textContent = error instanceof Error ? error.message : "Could not load activity.";
      if (checkedEl) checkedEl.textContent = "";
    } finally {
      activityLoading = false;
      if (button) {
        button.disabled = false;
        button.textContent = "Refresh";
      }
    }
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/"/g, "&quot;");
  }

  function toBase64(buffer) {
    const bytes = new Uint8Array(buffer);
    let binary = "";
    const chunk = 0x8000;
    for (let i = 0; i < bytes.length; i += chunk) {
      binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
    }
    return btoa(binary);
  }

  async function blobToJpeg(file, maxBytes = 2 * 1024 * 1024) {
    let bitmap;
    try {
      bitmap = await createImageBitmap(file);
    } catch {
      const name = `${file.type} ${file.name}`.toLowerCase();
      throw new Error(
        name.includes("heic") || name.includes("heif")
          ? "This iPhone photo is HEIC. Save it as JPG, or try Safari."
          : "Use a JPG, PNG, or WebP photo.",
      );
    }
    const maxEdge = 2000;
    const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.max(1, Math.round(bitmap.width * scale));
    canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    canvas.getContext("2d").drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close?.();
    let quality = 0.88;
    let blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", quality));
    while (blob && blob.size > maxBytes && quality > 0.5) {
      quality -= 0.08;
      blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", quality));
    }
    if (!blob || blob.size > maxBytes) throw new Error("Photo is still too large after shrinking (2 MB max).");
    return blob;
  }

  async function preparePhoto(file) {
    const ext = `.${(file.name.split(".").pop() || "jpg").toLowerCase()}`;
    const allowed = new Set([".jpg", ".jpeg", ".png", ".webp"]);
    const blob = file.size <= 2 * 1024 * 1024 && allowed.has(ext) ? file : await blobToJpeg(file);
    const filename = blob === file ? file.name : "photo.jpg";
    return { filename, contentBase64: toBase64(await blob.arrayBuffer()) };
  }

  function displayUrl(value) {
    return value && value !== "#" ? value : "";
  }

  function firstHttpUrl(value) {
    const text = String(value || "")
      .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, "")
      .trim();
    if (!text || text === "#") return "";
    const http = text.match(/https?:\/\/[^\s<>"')\]]+/i);
    if (http) return http[0].replace(/[.,);]+$/g, "");
    const amazon = text.match(/(?:www\.)?amazon\.(?:co\.uk|com)\/[^\s<>"')\]]+/i);
    if (amazon) return `https://${amazon[0]}`.replace(/[.,);]+$/g, "");
    const short = text.match(/(?:amzn\.(?:eu|to|asia)|a\.co)\/[^\s<>"')\]]+/i);
    if (short) return `https://${short[0]}`.replace(/[.,);]+$/g, "");
    return "";
  }

  function taggedAmazon(value) {
    const raw = firstHttpUrl(value);
    if (!raw) return "";
    const tag = JSON.parse(document.getElementById("affiliate-config")?.textContent || "{}").amazonTag || "";
    if (!tag) return raw;
    let url;
    try {
      url = new URL(raw);
    } catch {
      return raw;
    }
    const host = url.hostname.replace(/^www\./i, "").toLowerCase();
    if (host !== "amazon.co.uk" && host !== "amazon.com") return raw;
    const match = url.pathname.match(/\/(?:dp|gp\/product|gp\/aw\/d)\/([A-Z0-9]{10})/i);
    if (match) {
      const domain = host === "amazon.com" ? "www.amazon.com" : "www.amazon.co.uk";
      return `https://${domain}/dp/${match[1]}/ref=nosim?tag=${encodeURIComponent(tag)}`;
    }
    url.searchParams.set("tag", tag);
    return url.toString();
  }

  function updateAmazonPreview() {
    const el = document.querySelector("[data-supply-amazon-preview]");
    if (!el) return;
    const raw = document.querySelector("[data-supply-amazon]")?.value || "";
    const cleaned = taggedAmazon(raw);
    const pasted = String(raw)
      .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, "")
      .trim();
    if (!pasted || pasted === "#") {
      el.textContent = "Paste the product page address — a long Amazon link is fine. We tidy it and add your tag on save.";
      el.classList.remove("text-accent");
      return;
    }
    if (!cleaned) {
      el.textContent = "That doesn't look like an Amazon link yet.";
      el.classList.add("text-accent");
      return;
    }
    el.textContent = `Will save as ${cleaned}`;
    el.classList.remove("text-accent");
  }

  async function call(path, options = {}) {
    const response = await fetch(`${api}/admin/api${path}`, {
      credentials: "include",
      cache: "no-store",
      headers: { "Content-Type": "application/json", ...(options.headers || {}) },
      ...options,
    });
    const type = response.headers.get("content-type") || "";
    if (!type.includes("json")) {
      throw new Error(
        response.status === 404
          ? "The editor API is not deployed. Confirm the Pages project includes the functions/ folder, then retry the deploy."
          : "Cloudflare Access is still blocking /admin/api. Path must be /admin* and you must be signed in.",
      );
    }
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
    return data;
  }

  function showApp(email) {
    login?.classList.add("hidden");
    app?.classList.remove("hidden");
    featuredBaseline = books.filter((book) => book.featured).map((book) => book.slug);
    renderArtList();
    renderSupplyList();
    renderFeaturedBoard();
    renderInstagram();
    if (status) {
      if (email && email !== "local") {
        status.textContent = `Signed in as ${email}. Saves go live after the site rebuilds (usually a minute).`;
      } else if (isDev) {
        status.textContent = "Editor is connected on this computer.";
      } else {
        status.textContent = "Editor is connected. Saves go live after the site rebuilds (usually a minute).";
      }
    }
    loadActivity();
    applyUrlState();
  }

  function defaultQueue() {
    return books.some((book) => book.status === "currently-reading") ? "currently-reading" : "five-star-no-note";
  }

  function syncUrl() {
    const params = new URLSearchParams();
    params.set("tab", currentTab);
    if (currentTab === "book") params.set("queue", currentQueue);
    if (currentTab === "book" && currentBook?.slug) params.set("slug", currentBook.slug);
    if (currentTab === "art" && currentArt?.slug && !currentArt.create) params.set("slug", currentArt.slug);
    if (currentTab === "supply" && currentSupply?.slug && !currentSupply.create) params.set("slug", currentSupply.slug);
    const next = `${window.location.pathname}?${params.toString()}`;
    if (`${window.location.pathname}${window.location.search}` !== next) {
      history.replaceState(null, "", next);
    }
  }

  function applyUrlState() {
    const params = new URLSearchParams(window.location.search);
    let tab = params.get("tab") || "";
    const queue = params.get("queue") || "";
    const slug = params.get("slug") || "";
    if (!TABS.includes(tab)) {
      tab = slug || queue ? "book" : "overview";
    }
    currentTab = tab;
    currentQueue = QUEUES.includes(queue) ? queue : defaultQueue();
    paintTab(currentTab);
    if (currentTab === "book") {
      paintQueue();
      renderQueue();
      if (slug) {
        const book = books.find((item) => item.slug === slug);
        if (book) fillBook(book, { skipUrl: true });
        else if (status) status.textContent = "That book is not on the site.";
      }
    } else if (currentTab === "art" && slug) {
      const piece = artPieces.find((item) => item.slug === slug);
      if (piece) fillArt({ ...piece, create: false });
      else if (status) status.textContent = "That painting is not on the site.";
    } else if (currentTab === "supply" && slug) {
      const item = supplies.find((entry) => entry.slug === slug);
      if (item) fillSupply({ ...item, create: false });
      else if (status) status.textContent = "That tool is not on the site.";
    }
    syncUrl();
  }

  function paintTab(kind) {
    currentTab = kind;
    document.querySelectorAll("[data-tab]").forEach((button) => {
      const on = button.dataset.tab === kind;
      button.classList.toggle("bg-primary", on);
      button.classList.toggle("text-primary-foreground", on);
      button.classList.toggle("border", !on);
      button.classList.toggle("border-border", !on);
      button.classList.toggle("rounded-full", true);
    });
    document.querySelectorAll("[data-panel]").forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.panel !== kind);
    });
  }

  function setTab(kind) {
    if (kind !== currentTab && !confirmLeave()) return;
    if (kind !== "book") {
      currentBook = null;
      bookEditor?.classList.add("hidden");
    }
    paintTab(kind);
    if (kind === "book") {
      paintQueue();
      renderQueue();
      document.querySelector("[data-book-empty]")?.classList.toggle("hidden", Boolean(currentBook));
    }
    if (kind === "art") document.querySelector("[data-art-empty]")?.classList.toggle("hidden", Boolean(currentArt));
    if (kind === "supply") document.querySelector("[data-supply-empty]")?.classList.toggle("hidden", Boolean(currentSupply));
    syncUrl();
  }

  function confirmLeave() {
    if (!isBookDirty()) return true;
    return window.confirm("Discard unsaved changes?");
  }

  function bookFormState() {
    return JSON.stringify({
      title: document.querySelector("[data-book-title]")?.value || "",
      author: document.querySelector("[data-book-author]")?.value || "",
      genre: document.querySelector("[data-book-genre]")?.value || "",
      note: document.querySelector("[data-book-note]")?.value || "",
      featured: Boolean(document.querySelector("[data-book-featured]")?.checked),
      isbn: document.querySelector("[data-book-isbn]")?.value || "",
      isbn10: document.querySelector("[data-book-isbn10]")?.value || "",
      bookshop: document.querySelector("[data-book-bookshop]")?.value || "",
      amazon: document.querySelector("[data-book-amazon]")?.value || "",
      cover: document.querySelector("[data-book-cover]")?.files?.[0]?.name || "",
    });
  }

  function isBookDirty() {
    return Boolean(currentBook) && !bookEditor?.classList.contains("hidden") && bookFormState() !== bookSnapshot;
  }

  function previewBuy({ isbn, isbn10, bookshop, amazon }) {
    const asUrl = (value) => {
      const raw = String(value || "").trim();
      if (!raw || raw === "#") return "";
      return /^https?:\/\//i.test(raw) ? raw : "";
    };
    const cleanIsbn = (value) => String(value || "").replace(/[^\dXx]/g, "");
    const cfg = JSON.parse(document.getElementById("affiliate-config")?.textContent || "{}");
    const isbn13 = cleanIsbn(isbn);
    const isbn10c = cleanIsbn(isbn10);
    const shop =
      asUrl(bookshop) ||
      (cfg.bookshopUkId && isbn13 ? `https://uk.bookshop.org/a/${cfg.bookshopUkId}/${isbn13}` : "");
    const asin = isbn10c || isbn13;
    const amazonUrl =
      taggedAmazon(amazon) ||
      (cfg.amazonTag && asin
        ? `https://www.amazon.co.uk/dp/${asin}/ref=nosim?tag=${encodeURIComponent(cfg.amazonTag)}`
        : "");
    return { bookshop: shop, amazon: amazonUrl };
  }

  function updateBuyPreview() {
    const el = document.querySelector("[data-book-buy]");
    if (!el) return;
    const buy = previewBuy({
      isbn: document.querySelector("[data-book-isbn]")?.value,
      isbn10: document.querySelector("[data-book-isbn10]")?.value,
      bookshop: document.querySelector("[data-book-bookshop]")?.value,
      amazon: document.querySelector("[data-book-amazon]")?.value,
    });
    const parts = [];
    if (buy.bookshop) {
      parts.push(
        `<a class="text-primary underline-offset-4 hover:underline" href="${escapeHtml(buy.bookshop)}" target="_blank" rel="sponsored noopener noreferrer">Bookshop.org</a>`,
      );
    }
    if (buy.amazon) {
      parts.push(
        `<a class="text-primary underline-offset-4 hover:underline" href="${escapeHtml(buy.amazon)}" target="_blank" rel="sponsored noopener noreferrer">Amazon</a>`,
      );
    }
    el.innerHTML = parts.length ? parts.join(" · ") : "Add an ISBN or a full URL to generate buy links.";
  }

  function updateNoteCount() {
    const el = document.querySelector("[data-book-note-count]");
    const n = (document.querySelector("[data-book-note]")?.value || "").length;
    if (!el) return;
    el.textContent = `${n} / ${MAX_NOTE}`;
    el.classList.toggle("text-accent", n > MAX_NOTE);
    el.classList.toggle("text-muted-foreground", n <= MAX_NOTE);
  }

  function siteOrigin() {
    const cfg = JSON.parse(document.getElementById("affiliate-config")?.textContent || "{}");
    return String(cfg.siteOrigin || "https://sashabookandbrush.com").replace(/\/$/, "");
  }

  function copyText(label, value) {
    const text = String(value || "").trim();
    if (!text) {
      if (status) status.textContent = `No ${label} to copy yet.`;
      return;
    }
    navigator.clipboard.writeText(text).then(
      () => {
        if (status) status.textContent = `Copied ${label}`;
      },
      () => {
        if (status) status.textContent = "Could not copy — long-press the link instead.";
      },
    );
  }

  function copyChip(label, value) {
    if (!value) return "";
    return `<button type="button" class="rounded border border-border px-2.5 py-1 text-xs text-foreground hover:border-primary" data-copy-value="${escapeHtml(value)}" data-copy-label="${escapeHtml(label)}">${escapeHtml(label)}</button>`;
  }

  function renderInstagram() {
    const origin = siteOrigin();
    const pages = document.querySelector("[data-ig-pages]");
    const reading = document.querySelector("[data-ig-reading]");
    if (pages) {
      const links = [
        ["Home", origin],
        ["Currently reading", `${origin}/#currently-reading`],
        ["Books", `${origin}/recommendations`],
        ["Art", `${origin}/art`],
        ["Tools", `${origin}/art#supplies`],
        ["Work with me", `${origin}/work`],
      ];
      pages.innerHTML = links.map(([label, href]) => copyChip(label, href)).join("");
    }
    if (!reading) return;
    const current = books.filter((book) => book.status === "currently-reading");
    if (!current.length) {
      reading.innerHTML = `<p class="text-sm text-muted-foreground">No currently-reading titles on the site.</p>`;
      return;
    }
    reading.innerHTML = `<p class="mb-2 text-xs font-medium tracking-widest text-accent uppercase">Reading now</p>${current
      .map((book) => {
        const buy = previewBuy(book);
        const page = `${origin}/books/${book.slug}`;
        return `<div class="flex flex-wrap items-center gap-2 rounded-lg border border-border px-3 py-2"><span class="min-w-0 flex-1 text-sm font-medium text-foreground">${escapeHtml(book.title)}</span>${copyChip("Page", page)}${copyChip("Bookshop", buy.bookshop)}${copyChip("Amazon", buy.amazon)}</div>`;
      })
      .join("")}`;
  }

  function nextFeaturedOrder() {
    const max = books.reduce((high, book) => {
      if (!book.featured) return high;
      return Math.max(high, Number(book.order) || 0);
    }, 0);
    return max + 1;
  }

  function searchQuery() {
    return (document.querySelector("[data-search]")?.value || "").trim().toLowerCase();
  }

  function queueCount(id) {
    if (id === "currently-reading") return books.filter((book) => book.status === "currently-reading").length;
    if (id === "featured") return books.filter((book) => book.featured).length;
    if (id === "five-star-no-note") return books.filter((book) => book.rating === 5 && !String(book.note || "").trim()).length;
    if (id === "no-note") return books.filter((book) => !String(book.note || "").trim()).length;
    if (id === "missing-isbn") return books.filter((book) => !book.isbn && !book.isbn10).length;
    return 0;
  }

  function queueBooks() {
    const q = searchQuery();
    if (q.length >= 2) {
      return books.filter((book) => `${book.title} ${book.author} ${book.slug}`.toLowerCase().includes(q));
    }
    if (currentQueue === "currently-reading") return books.filter((book) => book.status === "currently-reading");
    if (currentQueue === "featured") {
      return books.filter((book) => book.featured).sort((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
    }
    if (currentQueue === "five-star-no-note") {
      return books.filter((book) => book.rating === 5 && !String(book.note || "").trim());
    }
    if (currentQueue === "no-note") return books.filter((book) => !String(book.note || "").trim());
    if (currentQueue === "missing-isbn") return books.filter((book) => !book.isbn && !book.isbn10);
    return [];
  }

  function bookRow(book) {
    const selected = currentBook?.slug === book.slug;
    const badges = [];
    if (book.rating > 0) badges.push(`${book.rating}★`);
    badges.push(String(book.note || "").trim() ? "Note" : "No note");
    if (book.featured) badges.push("Home");
    if (!book.isbn && !book.isbn10) badges.push("No ISBN");
    const badgeHtml = badges
      .map((label) => {
        const accent = label === "No note" || label === "No ISBN";
        return `<span class="${accent ? "text-accent" : "text-muted-foreground"}">${escapeHtml(label)}</span>`;
      })
      .join(" · ");
    const cover = book.coverUrl
      ? `<img src="${escapeHtml(book.coverUrl)}" alt="" class="h-14 w-9 shrink-0 rounded object-cover bg-muted" />`
      : `<span class="h-14 w-9 shrink-0 rounded bg-muted"></span>`;
    const ring = selected ? "border-primary bg-muted" : "border-border hover:border-primary";
    return `<li><button type="button" class="flex w-full items-start gap-3 rounded-lg border px-2 py-2 text-left ${ring}" data-slug="${escapeHtml(book.slug)}">${cover}<span class="min-w-0 flex-1"><span class="font-medium text-foreground">${escapeHtml(book.title)}</span><span class="mt-0.5 block text-xs text-muted-foreground">${escapeHtml(book.author)}</span><span class="mt-1 block text-xs">${badgeHtml}</span></span></button></li>`;
  }

  function paintQueue() {
    document.querySelectorAll("[data-queue]").forEach((button) => {
      const on = button.dataset.queue === currentQueue && searchQuery().length < 2;
      button.classList.toggle("bg-primary", on);
      button.classList.toggle("text-primary-foreground", on);
      button.classList.toggle("border-border", !on);
    });
    document.querySelectorAll("[data-queue-n]").forEach((el) => {
      el.textContent = String(queueCount(el.getAttribute("data-queue-n") || ""));
    });
  }

  function renderQueue() {
    if (!results) return;
    paintQueue();
    const matches = queueBooks();
    const q = searchQuery();
    const searching = q.length >= 2;
    const cap = searching || currentQueue === "no-note" ? 40 : matches.length;
    const shown = matches.slice(0, cap);
    const count = document.querySelector("[data-queue-count]");
    if (count) {
      if (searching) {
        count.textContent =
          shown.length < matches.length
            ? `${shown.length} of ${matches.length} matches`
            : `${matches.length} match${matches.length === 1 ? "" : "es"}`;
      } else {
        count.textContent =
          shown.length < matches.length
            ? `Showing ${shown.length} of ${matches.length}`
            : `${matches.length} book${matches.length === 1 ? "" : "s"}`;
      }
    }
    results.innerHTML = shown.length
      ? shown.map(bookRow).join("")
      : `<li class="px-1 py-6 text-center text-muted-foreground">${searching ? "No titles match." : "Nothing in this list."}</li>`;
    updateNextButton();
  }

  function setQueue(queue) {
    if (!confirmLeave()) return;
    currentQueue = QUEUES.includes(queue) ? queue : defaultQueue();
    const search = document.querySelector("[data-search]");
    if (search) search.value = "";
    currentBook = null;
    bookEditor?.classList.add("hidden");
    document.querySelector("[data-book-empty]")?.classList.remove("hidden");
    renderQueue();
    syncUrl();
  }

  function nextInQueue() {
    if (!currentBook) return null;
    const list = queueBooks();
    const index = list.findIndex((book) => book.slug === currentBook.slug);
    if (index < 0) return list[0] || null;
    return list[index + 1] || null;
  }

  function updateNextButton() {
    const button = document.querySelector("[data-book-next]");
    if (!button) return;
    const next = nextInQueue();
    button.classList.toggle("hidden", !next);
    if (next) button.textContent = "Next →";
  }

  function featuredList() {
    return books
      .filter((book) => book.featured)
      .sort((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
  }

  function renderFeaturedBoard() {
    const list = document.querySelector("[data-featured-board]");
    const count = document.querySelector("[data-featured-count]");
    const featured = featuredList();
    if (count) {
      count.textContent =
        featured.length > 8
          ? `Featured ${featured.length} / target 6–8 — maybe rotate one off before adding.`
          : `Featured ${featured.length} / target 6–8`;
    }
    if (!list) return;
    if (!featured.length) {
      list.innerHTML = `<li class="text-muted-foreground">No featured books yet.</li>`;
      return;
    }
    list.innerHTML = featured
      .map((book, index) => {
        const cover = book.coverUrl
          ? `<img src="${escapeHtml(book.coverUrl)}" alt="" class="h-10 w-7 shrink-0 rounded object-cover bg-muted" />`
          : `<span class="h-10 w-7 shrink-0 rounded bg-muted"></span>`;
        return `<li class="flex items-center gap-2 rounded-lg border border-border px-2 py-1.5" data-featured-slug="${escapeHtml(book.slug)}">${cover}<span class="w-4 text-xs text-muted-foreground">${index + 1}</span><button type="button" class="min-w-0 flex-1 truncate text-left text-sm font-medium text-foreground" data-featured-open>${escapeHtml(book.title)}</button><button type="button" class="rounded border border-border px-2 py-1 text-xs" data-featured-up ${index === 0 ? "disabled" : ""}>↑</button><button type="button" class="rounded border border-border px-2 py-1 text-xs" data-featured-down ${index === featured.length - 1 ? "disabled" : ""}>↓</button><button type="button" class="rounded border border-border px-2 py-1 text-xs" data-featured-off>Remove</button></li>`;
      })
      .join("");
  }

  function bindDrop(kind) {
    const drop = document.querySelector(`[data-${kind}-drop]`);
    const input = document.querySelector(
      kind === "book" ? "[data-book-cover]" : kind === "supply" ? "[data-supply-image]" : "[data-art-image]",
    );
    const preview = document.querySelector(`[data-${kind}-preview]`);
    const label = document.querySelector(`[data-${kind}-drop-label]`);
    if (!drop || !input) return;

    function showFile(file) {
      if (!file) return;
      if (previewUrls[kind]) URL.revokeObjectURL(previewUrls[kind]);
      previewUrls[kind] = URL.createObjectURL(file);
      if (preview) {
        preview.src = previewUrls[kind];
        preview.classList.remove("hidden");
      }
      if (label) label.textContent = file.name;
    }

    drop.addEventListener("click", () => input.click());
    drop.addEventListener("dragover", (event) => {
      event.preventDefault();
      drop.classList.add("border-primary");
    });
    drop.addEventListener("dragleave", () => drop.classList.remove("border-primary"));
    drop.addEventListener("drop", (event) => {
      event.preventDefault();
      drop.classList.remove("border-primary");
      const file = event.dataTransfer?.files?.[0];
      if (!file) return;
      const transfer = new DataTransfer();
      transfer.items.add(file);
      input.files = transfer.files;
      showFile(file);
    });
    input.addEventListener("change", () => {
      if (input.files?.[0]) showFile(input.files[0]);
    });
  }

  function resetDrop(kind, existingSrc, existingLabel) {
    const input = document.querySelector(
      kind === "book" ? "[data-book-cover]" : kind === "supply" ? "[data-supply-image]" : "[data-art-image]",
    );
    const preview = document.querySelector(`[data-${kind}-preview]`);
    const label = document.querySelector(`[data-${kind}-drop-label]`);
    if (input) input.value = "";
    if (previewUrls[kind]) URL.revokeObjectURL(previewUrls[kind]);
    previewUrls[kind] = "";
    if (preview) {
      if (existingSrc) {
        preview.src = existingSrc;
        preview.classList.remove("hidden");
      } else {
        preview.removeAttribute("src");
        preview.classList.add("hidden");
      }
    }
    if (label) {
      label.textContent = existingLabel || (kind === "book" ? "Drop a cover here, or click to choose a photo" : "Drop a photo here, or click to choose");
    }
  }

  function renderArtList() {
    if (!artList) return;
    if (!artPieces.length) {
      artList.innerHTML = `<li class="text-muted-foreground">No paintings yet.</li>`;
      return;
    }
    const sorted = [...artPieces].sort((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
    artList.innerHTML = sorted
      .map((piece, index) => {
        const flags = [];
        if (!piece.image) flags.push("No image");
        if (!String(piece.note || "").trim()) flags.push("No note");
        if (piece.featured) flags.push("Home");
        if (piece.available) flags.push("For sale");
        const extra = flags.length
          ? `<span class="mt-1 block text-xs ${flags.includes("Home") && flags.length === 1 ? "text-muted-foreground" : "text-accent"}">${escapeHtml(flags.join(" · "))}</span>`
          : "";
        const thumb = piece.imageUrl
          ? `<img src="${escapeHtml(piece.imageUrl)}" alt="" class="h-12 w-12 shrink-0 rounded object-cover bg-muted" />`
          : `<span class="h-12 w-12 shrink-0 rounded bg-muted"></span>`;
        const selected = currentArt?.slug === piece.slug && !currentArt?.create;
        const ring = selected ? "border-primary bg-muted" : "border-border";
        return `<li class="flex items-center gap-2 rounded-lg border ${ring} px-2 py-2" draggable="false" data-art-slug="${escapeHtml(piece.slug)}"><button type="button" class="cursor-grab touch-none px-1 text-muted-foreground" data-drag aria-label="Drag to reorder">⋮⋮</button><span class="w-4 text-xs text-muted-foreground">${index + 1}</span>${thumb}<button type="button" class="min-w-0 flex-1 text-left" data-art-open><span class="font-medium text-foreground">${escapeHtml(piece.title)}</span><span class="mt-0.5 block text-xs text-muted-foreground">${escapeHtml(piece.medium)}</span>${extra}</button>${copyChip("Link", `${siteOrigin()}/art#${piece.slug}`)}<div class="flex flex-col gap-1"><button type="button" class="rounded border border-border px-1.5 py-0.5 text-xs" data-art-up ${index === 0 ? "disabled" : ""}>↑</button><button type="button" class="rounded border border-border px-1.5 py-0.5 text-xs" data-art-down ${index === sorted.length - 1 ? "disabled" : ""}>↓</button></div></li>`;
      })
      .join("");
  }

  function renderSupplyList() {
    if (!supplyList) return;
    if (!supplies.length) {
      supplyList.innerHTML = `<li class="text-muted-foreground">No tools yet.</li>`;
      return;
    }
    const sorted = [...supplies].sort((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
    supplyList.innerHTML = sorted
      .map((item, index) => {
        const flags = [];
        if (!item.amazon) flags.push("No Amazon URL");
        if (item.featured) flags.push("Home");
        const extra = flags.length
          ? `<span class="mt-1 block text-xs ${item.amazon ? "text-muted-foreground" : "text-accent"}">${escapeHtml(flags.join(" · "))}</span>`
          : "";
        const selected = currentSupply?.slug === item.slug && !currentSupply?.create;
        const ring = selected ? "border-primary bg-muted" : "border-border";
        return `<li class="flex items-center gap-2 rounded-lg border ${ring} px-2 py-2" data-supply-slug="${escapeHtml(item.slug)}"><button type="button" class="cursor-grab touch-none px-1 text-muted-foreground" data-drag aria-label="Drag to reorder">⋮⋮</button><span class="w-4 text-xs text-muted-foreground">${index + 1}</span><button type="button" class="min-w-0 flex-1 text-left" data-supply-open><span class="font-medium text-foreground">${escapeHtml(item.title)}</span><span class="mt-0.5 block text-xs text-muted-foreground">${escapeHtml(item.brand)}${item.category ? ` · ${escapeHtml(item.category)}` : ""}</span>${extra}</button>${copyChip("Amazon", item.amazon)}${copyChip("Link", `${siteOrigin()}/art#${item.slug}`)}<div class="flex flex-col gap-1"><button type="button" class="rounded border border-border px-1.5 py-0.5 text-xs" data-supply-up ${index === 0 ? "disabled" : ""}>↑</button><button type="button" class="rounded border border-border px-1.5 py-0.5 text-xs" data-supply-down ${index === sorted.length - 1 ? "disabled" : ""}>↓</button></div></li>`;
      })
      .join("");
  }

  function fillBook(book, options = {}) {
    if (currentBook && currentBook.slug !== book.slug && !confirmLeave()) return;
    currentBook = book;
    bookEditor?.classList.remove("hidden");
    document.querySelector("[data-book-empty]")?.classList.add("hidden");
    const heading = document.querySelector("[data-book-heading]");
    if (heading) heading.textContent = book.title;
    document.querySelector("[data-book-title]").value = book.title;
    document.querySelector("[data-book-author]").value = book.author;
    document.querySelector("[data-book-genre]").value = book.genre === "Read" || book.genre === "Currently reading" ? "" : book.genre;
    document.querySelector("[data-book-note]").value = book.note || "";
    document.querySelector("[data-book-featured]").checked = book.featured;
    document.querySelector("[data-book-isbn]").value = book.isbn || "";
    document.querySelector("[data-book-isbn10]").value = book.isbn10 || "";
