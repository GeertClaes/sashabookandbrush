---
import BaseLayout from "../layouts/BaseLayout.astro";
import live from "../data/goodreads-live.json";
import { getCollection } from "astro:content";

const isDev = import.meta.env.DEV;
const api = isDev ? import.meta.env.PUBLIC_ADMIN_URL || "http://127.0.0.1:8787" : "";
const books = (await getCollection("books"))
  .map((book) => ({
    slug: book.id,
    title: book.data.title,
    author: book.data.author,
    note: book.data.note || "",
    featured: Boolean(book.data.featured),
    cover: book.data.cover || "",
    genre: book.data.genre || "",
    bookshop: book.data.bookshop === "#" ? "" : book.data.bookshop || "",
    amazon: book.data.amazon === "#" ? "" : book.data.amazon || "",
    rating: book.data.rating || 0,
    status: book.data.status || "read",
    dateRead: book.data.dateRead || "",
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
const art = (await getCollection("art"))
  .map((piece) => ({
    slug: piece.id,
    title: piece.data.title,
    medium: piece.data.medium,
    note: piece.data.note || "",
    featured: Boolean(piece.data.featured),
    image: piece.data.image || "",
    order: piece.data.order || 0,
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
const supplies = (await getCollection("supplies"))
  .map((item) => ({
    slug: item.id,
    title: item.data.title,
    brand: item.data.brand,
    category: item.data.category,
    note: item.data.note || "",
    amazon: item.data.amazon === "#" ? "" : item.data.amazon || "",
    shop: item.data.shop || "",
    shopLabel: item.data.shopLabel || "",
    featured: Boolean(item.data.featured),
    order: item.data.order || 0,
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const syncedAt = live.updated
  ? new Date(live.updated).toLocaleString("en-GB", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "Europe/London",
    })
  : "never";
const stats = [
  { label: "Goodreads RSS", value: syncedAt },
  { label: "Currently reading", value: String(live.currentlyReading?.length || 0) },
  { label: "TBR teaser", value: String(live.upNext?.length || 0) },
  { label: "Books on site", value: String(books.length) },
  { label: "Featured books", value: String(books.filter((book) => book.featured).length) },
  { label: "Paintings", value: String(art.length) },
  { label: "Tools", value: String(supplies.length) },
];
---

<BaseLayout
  title="Library editor"
  description="Private editor for books, art, and tools."
  noindex={true}
>
  <div class="min-h-screen bg-background">
    <div class="mx-auto max-w-5xl px-6 py-12 md:px-12 md:py-16">
      <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">Private</p>
      <h1 class="font-display mb-3 text-3xl font-semibold text-foreground">Studio editor</h1>
      <p class="mb-8 max-w-xl text-sm leading-relaxed text-muted-foreground">
        Ratings and progress stay on Goodreads. Notes, covers, featured cards, paintings, and tools live here.
        {
          isDev ? (
            <>
              {" "}
              Locally, also run <code class="text-foreground">npm run admin</code>.
            </>
          ) : (
            <> Sign in with Google if Cloudflare asks.</>
          )
        }
      </p>

      <p data-status class="mb-6 text-sm text-muted-foreground">Checking the editor…</p>

      {
        isDev && (
          <form data-login class="mb-10 hidden rounded-xl border border-border bg-card p-5">
            <label class="block text-sm font-medium text-foreground">
              Password
              <input
                type="password"
                name="password"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2"
              />
            </label>
            <button type="submit" class="mt-4 rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
              Sign in
            </button>
          </form>
        )
      }

      <div data-app class="hidden space-y-8">
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            data-tab="overview"
            class="rounded-full bg-primary px-4 py-2 text-sm text-primary-foreground"
          >
            Overview
          </button>
          <button
            type="button"
            data-tab="book"
            class="rounded-full border border-border px-4 py-2 text-sm text-foreground"
          >
            Books
          </button>
          <button
            type="button"
            data-tab="art"
            class="rounded-full border border-border px-4 py-2 text-sm text-foreground"
          >
            Art
          </button>
          <button
            type="button"
            data-tab="supply"
            class="rounded-full border border-border px-4 py-2 text-sm text-foreground"
          >
            Tools
          </button>
        </div>

        <div data-panel="overview" class="space-y-6">
          <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {
              stats.map((item) => (
                <div class="rounded-xl border border-border bg-card px-4 py-3">
                  <dt class="text-xs tracking-widest text-muted-foreground uppercase">{item.label}</dt>
                  <dd class="font-display mt-1 text-lg font-semibold text-foreground">{item.value}</dd>
                </div>
              ))
            }
          </dl>

          <div class="grid gap-6 lg:grid-cols-2">
            <section class="rounded-xl border border-border bg-card p-5">
              <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h2 class="font-display text-xl font-semibold text-foreground">Goodreads &amp; live site</h2>
                  <p class="mt-1 text-sm text-muted-foreground">
                    Reload this status. It does not start a new Goodreads pull — that happens when the site rebuilds.
                  </p>
                </div>
                <button
                  type="button"
                  data-activity-refresh
                  class="cursor-pointer rounded border border-border px-3 py-1.5 text-sm text-foreground transition-colors hover:border-primary hover:bg-muted hover:text-primary disabled:pointer-events-none disabled:opacity-60"
                >
                  Refresh
                </button>
              </div>
              <p data-activity-site class="text-sm text-muted-foreground">Checking…</p>
              <p data-activity-checked class="mt-1 text-xs text-muted-foreground"></p>
              <div data-activity-sync class="mt-4 rounded-lg border border-border bg-background p-4 text-sm"></div>
            </section>

            <section class="rounded-xl border border-border bg-card p-5">
              <h2 class="font-display mb-1 text-xl font-semibold text-foreground">Recent activity</h2>
              <p class="mb-4 text-sm text-muted-foreground">Saves from this editor and Goodreads syncs.</p>
              <ol data-activity-log class="space-y-2 text-sm"></ol>
            </section>
          </div>
        </div>

        <div data-panel="book" class="hidden space-y-8">
          <section class="rounded-xl border border-border bg-card p-5">
            <h2 class="font-display mb-3 text-xl font-semibold text-foreground">Find a book</h2>
            <input
              type="search"
              data-search
              placeholder="Title or author"
              class="mb-4 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
            />
            <ul data-results class="space-y-2 text-sm"></ul>
          </section>

          <section data-book-editor class="hidden rounded-xl border border-border bg-card p-5">
            <p data-book-meta class="mb-4 text-xs text-muted-foreground"></p>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Title
              <input data-book-title class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
            </label>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Author
              <input data-book-author class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
            </label>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Genre on the site
              <input data-book-genre class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
            </label>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Public note
              <textarea
                data-book-note
                rows="6"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              ></textarea>
            </label>
            <label class="mb-4 flex items-center gap-2 text-sm text-foreground">
              <input type="checkbox" data-book-featured />
              Feature on the home page
            </label>
            <div class="mb-4 grid gap-4 sm:grid-cols-2">
              <label class="block text-sm font-medium text-foreground">
                Bookshop.org URL
                <input
                  data-book-bookshop
                  placeholder="Leave blank to use ISBN"
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
              <label class="block text-sm font-medium text-foreground">
                Amazon URL
                <input
                  data-book-amazon
                  placeholder="Leave blank to use ISBN"
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
            </div>
            <p class="mb-2 text-sm font-medium text-foreground">Cover</p>
            <button
              type="button"
              data-book-drop
              class="mb-4 flex min-h-40 w-full flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-border bg-background px-4 py-6 text-center text-sm text-muted-foreground hover:border-primary"
            >
              <img data-book-preview class="hidden max-h-40 rounded object-cover shadow" alt="" />
              <span data-book-drop-label>Drop a cover here, or click to choose a photo</span>
            </button>
            <input type="file" data-book-cover accept="image/jpeg,image/png,image/webp" class="hidden" />
            <button type="button" data-book-save class="rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
              Save book
            </button>
          </section>
        </div>

        <div data-panel="art" class="hidden space-y-8">
          <section class="rounded-xl border border-border bg-card p-5">
            <div class="mb-4 flex items-center justify-between gap-3">
              <h2 class="font-display text-xl font-semibold text-foreground">Paintings</h2>
              <button
                type="button"
                data-art-new
                class="rounded border border-border px-3 py-1.5 text-sm"
              >
                New painting
              </button>
            </div>
            <ul data-art-list class="space-y-2 text-sm"></ul>
          </section>

          <section data-art-editor class="hidden rounded-xl border border-border bg-card p-5">
            <label class="mb-4 block text-sm font-medium text-foreground">
              Title
              <input data-art-title class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
            </label>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Medium
              <input
                data-art-medium
                placeholder="Acrylic"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              />
            </label>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Note
              <textarea
                data-art-note
                rows="5"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              ></textarea>
            </label>
            <div class="mb-4 grid gap-4 sm:grid-cols-2">
              <label class="flex items-center gap-2 text-sm text-foreground">
                <input type="checkbox" data-art-featured />
                Feature on the home page
              </label>
              <label class="block text-sm font-medium text-foreground">
                Order
                <input
                  type="number"
                  data-art-order
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
            </div>
            <p class="mb-2 text-sm font-medium text-foreground">Photo</p>
            <button
              type="button"
              data-art-drop
              class="mb-4 flex min-h-40 w-full flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-border bg-background px-4 py-6 text-center text-sm text-muted-foreground hover:border-primary"
            >
              <img data-art-preview class="hidden max-h-48 rounded object-cover shadow" alt="" />
              <span data-art-drop-label>Drop a photo here, or click to choose. Large phone photos are resized.</span>
            </button>
            <input type="file" data-art-image accept="image/jpeg,image/png,image/webp,image/heic,image/heif" class="hidden" />
            <div class="flex flex-wrap gap-2">
              <button type="button" data-art-save class="rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
                Save painting
              </button>
              <button
                type="button"
                data-art-delete
                class="hidden rounded border border-border px-4 py-2 text-sm text-muted-foreground hover:border-primary hover:text-foreground"
              >
                Delete
              </button>
            </div>
          </section>
        </div>

        <div data-panel="supply" class="hidden space-y-8">
          <section class="rounded-xl border border-border bg-card p-5">
            <div class="mb-4 flex items-center justify-between gap-3">
              <h2 class="font-display text-xl font-semibold text-foreground">Tools I recommend</h2>
              <button
                type="button"
                data-supply-new
                class="rounded border border-border px-3 py-1.5 text-sm"
              >
                New tool
              </button>
            </div>
            <p class="mb-4 text-sm text-muted-foreground">
              These appear on the Art page. Featured tools also show on Home.
            </p>
            <ul data-supply-list class="space-y-2 text-sm"></ul>
          </section>

          <section data-supply-editor class="hidden rounded-xl border border-border bg-card p-5">
            <label class="mb-4 block text-sm font-medium text-foreground">
              Title
              <input data-supply-title class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
            </label>
            <div class="mb-4 grid gap-4 sm:grid-cols-2">
              <label class="block text-sm font-medium text-foreground">
                Brand
                <input data-supply-brand class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
              </label>
              <label class="block text-sm font-medium text-foreground">
                Category
                <input
                  data-supply-category
                  placeholder="Paint, Brushes, Paper…"
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
            </div>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Note
              <textarea
                data-supply-note
                rows="5"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              ></textarea>
            </label>
            <div class="mb-4 grid gap-4 sm:grid-cols-2">
              <label class="flex items-center gap-2 text-sm text-foreground">
                <input type="checkbox" data-supply-featured />
                Feature on the home page
              </label>
              <label class="block text-sm font-medium text-foreground">
                Order
                <input
                  type="number"
                  data-supply-order
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
            </div>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Amazon URL
              <input
                data-supply-amazon
                placeholder="Leave blank until you have an affiliate link"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              />
            </label>
            <div class="mb-4 grid gap-4 sm:grid-cols-2">
              <label class="block text-sm font-medium text-foreground">
                Other shop URL
                <input
                  data-supply-shop
                  placeholder="Jackson's, Cass Art…"
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
              <label class="block text-sm font-medium text-foreground">
                Shop button label
                <input
                  data-supply-shop-label
                  placeholder="Jackson's"
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
            </div>
            <div class="flex flex-wrap gap-2">
              <button type="button" data-supply-save class="rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
                Save tool
              </button>
              <button
                type="button"
                data-supply-delete
                class="hidden rounded border border-border px-4 py-2 text-sm text-muted-foreground hover:border-primary hover:text-foreground"
              >
                Delete
              </button>
            </div>
          </section>
        </div>

        <details class="rounded-xl border border-border bg-card px-5 py-4 text-sm">
          <summary class="cursor-pointer font-medium text-muted-foreground">
            Advanced: import a Goodreads CSV
          </summary>
          <p class="mt-3 text-muted-foreground">
            Only needed when ratings or new finished books should land on the site. Notes, covers, and featured
            flags are kept.
          </p>
          <input type="file" data-csv accept=".csv" class="mt-4 block text-sm" />
          <button type="button" data-import class="mt-3 rounded border border-border px-4 py-2 text-sm">
            Import CSV
          </button>
          <pre data-log class="mt-3 overflow-x-auto text-xs text-muted-foreground"></pre>
        </details>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="book-catalog" set:html={JSON.stringify(books).replace(/</g, "\\u003c")} />
  <script is:inline type="application/json" id="art-catalog" set:html={JSON.stringify(art).replace(/</g, "\\u003c")} />
  <script is:inline type="application/json" id="supply-catalog" set:html={JSON.stringify(supplies).replace(/</g, "\\u003c")} />

  <script define:vars={{ api, isDev }}>
  const status = document.querySelector("[data-status]");
  const login = document.querySelector("[data-login]");
  const app = document.querySelector("[data-app]");
  const results = document.querySelector("[data-results]");
  const bookEditor = document.querySelector("[data-book-editor]");
  const artEditor = document.querySelector("[data-art-editor]");
  const artList = document.querySelector("[data-art-list]");
  const supplyEditor = document.querySelector("[data-supply-editor]");
  const supplyList = document.querySelector("[data-supply-list]");
  const books = JSON.parse(document.getElementById("book-catalog")?.textContent || "[]");
  const artPieces = JSON.parse(document.getElementById("art-catalog")?.textContent || "[]");
  const supplies = JSON.parse(document.getElementById("supply-catalog")?.textContent || "[]");
  let currentBook = null;
  let currentArt = null;
  let currentSupply = null;
  let previewUrls = { book: "", art: "" };
  let activityTimer = 0;
  let activityLoading = false;

  function formatWhen(value) {
    if (!value) return "not yet";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleString("en-GB", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "Europe/London",
    });
  }

  function renderActivity(data) {
    const siteEl = document.querySelector("[data-activity-site]");
    const syncEl = document.querySelector("[data-activity-sync]");
    const logEl = document.querySelector("[data-activity-log]");
    const site = data.site || {};
    const sync = data.sync || {};
    if (siteEl) {
      if (site.deploymentsAvailable === false && !site.deploymentsError) {
        siteEl.textContent =
          "Saves are stored immediately. The public site usually updates within a minute after Cloudflare rebuilds. You do not need extra tokens for that.";
      } else {
        const when = site.at ? ` · ${formatWhen(site.at)}` : "";
        const trigger = site.trigger ? ` · ${site.trigger}` : "";
        siteEl.textContent = `${site.label || "Rebuild status unknown"}${when}${trigger}`;
      }
    }
    if (syncEl) {
      const reading = (sync.reading || [])
        .map((book) => {
          const pct = typeof book.progress === "number" ? ` (${book.progress}%)` : "";
          return escapeHtml(`${book.title}${pct}`);
        })
        .join("<br>");
      const changes = (sync.changes || []).map((item) => escapeHtml(item)).join("<br>");
      const tone = sync.ok ? "text-foreground" : "text-accent";
      const headline = sync.ok ? "Goodreads sync succeeded" : "Goodreads sync had a problem";
      const extra = sync.warning || sync.error || "";
      syncEl.innerHTML = `
        <p class="${tone} font-medium">${headline}</p>
        <p class="mt-1 text-xs text-muted-foreground">${escapeHtml(formatWhen(sync.at))} · ${escapeHtml(String(sync.readingCount || 0))} currently reading · ${escapeHtml(String(sync.upNextCount || 0))} up next</p>
        ${extra ? `<p class="mt-2 text-muted-foreground">${escapeHtml(extra)}</p>` : ""}
        ${reading ? `<p class="mt-3 text-muted-foreground"><span class="text-foreground">Now reading</span><br>${reading}</p>` : ""}
        ${changes ? `<p class="mt-3 text-muted-foreground"><span class="text-foreground">Changes</span><br>${changes}</p>` : `<p class="mt-3 text-muted-foreground">No currently-reading changes in that sync.</p>`}
        ${site.deploymentsError ? `<p class="mt-3 text-xs text-muted-foreground">${escapeHtml(site.deploymentsError)}</p>` : ""}
      `;
    }
    if (logEl) {
      const events = data.events || [];
      if (!events.length) {
        logEl.innerHTML = `<li class="text-muted-foreground">No admin or sync events recorded yet.</li>`;
      } else {
        logEl.innerHTML = events
          .slice(0, 20)
          .map((event) => {
            const mark = event.ok === false ? "Failed" : event.type === "goodreads" ? "Goodreads" : "Editor";
            return `<li class="rounded-lg border border-border px-3 py-2"><p class="font-medium text-foreground">${escapeHtml(event.title)}</p><p class="mt-0.5 text-xs text-muted-foreground">${escapeHtml(mark)} · ${escapeHtml(formatWhen(event.at))}${event.by ? ` · ${escapeHtml(event.by)}` : ""}</p>${event.detail ? `<p class="mt-1 text-muted-foreground">${escapeHtml(event.detail)}</p>` : ""}</li>`;
          })
          .join("");
      }
    }
  }

  async function loadActivity(options = {}) {
    if (activityLoading) return;
    activityLoading = true;
    const manual = Boolean(options.manual);
    const button = document.querySelector("[data-activity-refresh]");
    const checkedEl = document.querySelector("[data-activity-checked]");
    if (manual && button) {
      button.disabled = true;
      button.textContent = "Refreshing…";
    }
    try {
      const data = await call("/activity");
      renderActivity(data);
      if (checkedEl) checkedEl.textContent = `Checked ${formatWhen(new Date().toISOString())}`;
      if (activityTimer) window.clearInterval(activityTimer);
      activityTimer = window.setInterval(() => loadActivity(), data.site?.building ? 15000 : 60000);
    } catch (error) {
      const siteEl = document.querySelector("[data-activity-site]");
      if (siteEl) siteEl.textContent = error instanceof Error ? error.message : "Could not load activity.";
      if (checkedEl) checkedEl.textContent = "";
    } finally {
      activityLoading = false;
      if (button) {
        button.disabled = false;
        button.textContent = "Refresh";
      }
    }
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/"/g, "&quot;");
  }

  function toBase64(buffer) {
    const bytes = new Uint8Array(buffer);
    let binary = "";
    const chunk = 0x8000;
    for (let i = 0; i < bytes.length; i += chunk) {
      binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
    }
    return btoa(binary);
  }

  async function blobToJpeg(file, maxBytes = 2 * 1024 * 1024) {
    let bitmap;
    try {
      bitmap = await createImageBitmap(file);
    } catch {
      const name = `${file.type} ${file.name}`.toLowerCase();
      throw new Error(
        name.includes("heic") || name.includes("heif")
          ? "This iPhone photo is HEIC. Save it as JPG, or try Safari."
          : "Use a JPG, PNG, or WebP photo.",
      );
    }
    const maxEdge = 2000;
    const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.max(1, Math.round(bitmap.width * scale));
    canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    canvas.getContext("2d").drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close?.();
    let quality = 0.88;
    let blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", quality));
    while (blob && blob.size > maxBytes && quality > 0.5) {
      quality -= 0.08;
      blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", quality));
    }
    if (!blob || blob.size > maxBytes) throw new Error("Photo is still too large after shrinking (2 MB max).");
    return blob;
  }

  async function preparePhoto(file) {
    const ext = `.${(file.name.split(".").pop() || "jpg").toLowerCase()}`;
    const allowed = new Set([".jpg", ".jpeg", ".png", ".webp"]);
    const blob = file.size <= 2 * 1024 * 1024 && allowed.has(ext) ? file : await blobToJpeg(file);
    const filename = blob === file ? file.name : "photo.jpg";
    return { filename, contentBase64: toBase64(await blob.arrayBuffer()) };
  }

  function displayUrl(value) {
    return value && value !== "#" ? value : "";
  }

  async function call(path, options = {}) {
    const response = await fetch(`${api}/admin/api${path}`, {
      credentials: "include",
      cache: "no-store",
      headers: { "Content-Type": "application/json", ...(options.headers || {}) },
      ...options,
    });
    const type = response.headers.get("content-type") || "";
    if (!type.includes("json")) {
      throw new Error(
        response.status === 404
          ? "The editor API is not deployed. Confirm the Pages project includes the functions/ folder, then retry the deploy."
          : "Cloudflare Access is still blocking /admin/api. Path must be /admin* and you must be signed in.",
      );
    }
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
    return data;
  }

  function showApp(email) {
    login?.classList.add("hidden");
    app?.classList.remove("hidden");
    renderArtList();
    renderSupplyList();
    if (status) {
      if (email && email !== "local") {
        status.textContent = `Signed in as ${email}. Saves go live after the site rebuilds (usually a minute).`;
      } else if (isDev) {
        status.textContent = "Editor is connected on this computer.";
      } else {
        status.textContent = "Editor is connected. Saves go live after the site rebuilds (usually a minute).";
      }
    }
    loadActivity();
    setTab("overview");
  }

  function setTab(kind) {
    document.querySelectorAll("[data-tab]").forEach((button) => {
      const on = button.dataset.tab === kind;
      button.classList.toggle("bg-primary", on);
      button.classList.toggle("text-primary-foreground", on);
      button.classList.toggle("border", !on);
      button.classList.toggle("border-border", !on);
      button.classList.toggle("rounded-full", true);
    });
    document.querySelectorAll("[data-panel]").forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.panel !== kind);
    });
  }

  function bindDrop(kind) {
    const drop = document.querySelector(`[data-${kind}-drop]`);
    const input = document.querySelector(kind === "book" ? "[data-book-cover]" : "[data-art-image]");
    const preview = document.querySelector(`[data-${kind}-preview]`);
    const label = document.querySelector(`[data-${kind}-drop-label]`);
    if (!drop || !input) return;

    function showFile(file) {
      if (!file) return;
      if (previewUrls[kind]) URL.revokeObjectURL(previewUrls[kind]);
      previewUrls[kind] = URL.createObjectURL(file);
      if (preview) {
        preview.src = previewUrls[kind];
        preview.classList.remove("hidden");
      }
      if (label) label.textContent = file.name;
    }

    drop.addEventListener("click", () => input.click());
    drop.addEventListener("dragover", (event) => {
      event.preventDefault();
      drop.classList.add("border-primary");
    });
    drop.addEventListener("dragleave", () => drop.classList.remove("border-primary"));
    drop.addEventListener("drop", (event) => {
      event.preventDefault();
      drop.classList.remove("border-primary");
      const file = event.dataTransfer?.files?.[0];
      if (!file) return;
      const transfer = new DataTransfer();
      transfer.items.add(file);
      input.files = transfer.files;
      showFile(file);
    });
    input.addEventListener("change", () => {
      if (input.files?.[0]) showFile(input.files[0]);
    });
  }

  function resetDrop(kind, existingSrc, existingLabel) {
    const input = document.querySelector(kind === "book" ? "[data-book-cover]" : "[data-art-image]");
    const preview = document.querySelector(`[data-${kind}-preview]`);
    const label = document.querySelector(`[data-${kind}-drop-label]`);
    if (input) input.value = "";
    if (previewUrls[kind]) URL.revokeObjectURL(previewUrls[kind]);
    previewUrls[kind] = "";
    if (preview) {
      if (existingSrc) {
        preview.src = existingSrc;
        preview.classList.remove("hidden");
      } else {
        preview.removeAttribute("src");
        preview.classList.add("hidden");
      }
    }
    if (label) {
      label.textContent = existingLabel || (kind === "book" ? "Drop a cover here, or click to choose a photo" : "Drop a photo here, or click to choose");
    }
  }

  function renderArtList() {
    if (!artList) return;
    if (!artPieces.length) {
      artList.innerHTML = `<li class="text-muted-foreground">No paintings yet.</li>`;
      return;
    }
    artList.innerHTML = artPieces
      .map(
        (piece) =>
          `<li><button type="button" class="w-full rounded-lg border border-border px-3 py-2 text-left hover:border-primary" data-art-slug="${escapeHtml(piece.slug)}">${escapeHtml(piece.title)} <span class="text-muted-foreground">· ${escapeHtml(piece.medium)}</span></button></li>`,
      )
      .join("");
  }

  function renderSupplyList() {
    if (!supplyList) return;
    if (!supplies.length) {
      supplyList.innerHTML = `<li class="text-muted-foreground">No tools yet.</li>`;
      return;
    }
    supplyList.innerHTML = supplies
      .map(
        (item) =>
          `<li><button type="button" class="w-full rounded-lg border border-border px-3 py-2 text-left hover:border-primary" data-supply-slug="${escapeHtml(item.slug)}">${escapeHtml(item.title)} <span class="text-muted-foreground">· ${escapeHtml(item.brand)}</span></button></li>`,
      )
      .join("");
  }

  function fillBook(book) {
    currentBook = book;
    bookEditor?.classList.remove("hidden");
    document.querySelector("[data-book-title]").value = book.title;
    document.querySelector("[data-book-author]").value = book.author;
    document.querySelector("[data-book-genre]").value = book.genre === "Read" || book.genre === "Currently reading" ? "" : book.genre;
    document.querySelector("[data-book-note]").value = book.note;
    document.querySelector("[data-book-featured]").checked = book.featured;
    document.querySelector("[data-book-bookshop]").value = displayUrl(book.bookshop);
    document.querySelector("[data-book-amazon]").value = displayUrl(book.amazon);
    const bits = [];
    if (book.rating) bits.push(`${book.rating}★ on Goodreads`);
    if (book.status === "currently-reading") bits.push("Currently reading");
    else if (book.dateRead) bits.push(`Read ${book.dateRead}`);
    document.querySelector("[data-book-meta]").textContent = bits.join(" · ");
    resetDrop("book", "", book.cover ? `Current cover: ${book.cover}. Drop a new photo to replace it.` : "");
  }

  function fillArt(piece) {
    currentArt = piece;
    artEditor?.classList.remove("hidden");
    document.querySelector("[data-art-title]").value = piece.title || "";
    document.querySelector("[data-art-medium]").value = piece.medium || "Acrylic";
    document.querySelector("[data-art-note]").value = piece.note || "";
    document.querySelector("[data-art-featured]").checked = Boolean(piece.featured);
    document.querySelector("[data-art-order]").value = piece.order || 0;
    document.querySelector("[data-art-delete]")?.classList.toggle("hidden", Boolean(piece.create) || !piece.slug);
    resetDrop("art", piece.image || "", piece.image ? "Drop a new photo to replace it" : "");
  }

  function fillSupply(item) {
    currentSupply = item;
    supplyEditor?.classList.remove("hidden");
    document.querySelector("[data-supply-title]").value = item.title || "";
    document.querySelector("[data-supply-brand]").value = item.brand || "";
    document.querySelector("[data-supply-category]").value = item.category || "";
    document.querySelector("[data-supply-note]").value = item.note || "";
    document.querySelector("[data-supply-featured]").checked = Boolean(item.featured);
    document.querySelector("[data-supply-order]").value = item.order || 0;
    document.querySelector("[data-supply-amazon]").value = displayUrl(item.amazon);
    document.querySelector("[data-supply-shop]").value = item.shop || "";
    document.querySelector("[data-supply-shop-label]").value = item.shopLabel || "";
    document.querySelector("[data-supply-delete]")?.classList.toggle("hidden", Boolean(item.create) || !item.slug);
  }

  async function boot() {
    try {
      const health = await call("/health");
      if (isDev) {
        try {
          await call("/books?q=");
        } catch {
          login?.classList.remove("hidden");
          if (status) status.textContent = "Sign in to edit the library.";
          return;
        }
      }
      showApp(health.email);
    } catch (error) {
      if (isDev) {
        if (status) {
          status.textContent = "The editor API is not running. On this computer: npm run admin — then refresh.";
        }
        return;
      }
      if (status) status.textContent = error instanceof Error ? error.message : "Could not reach the editor.";
    }
  }

  document.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest("[data-activity-refresh]") : null;
    if (!button || button.disabled) return;
    event.preventDefault();
    loadActivity({ manual: true });
  });

  document.querySelectorAll("[data-tab]").forEach((button) => {
    button.addEventListener("click", () => setTab(button.dataset.tab));
  });

  bindDrop("book");
  bindDrop("art");

  login?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const password = new FormData(login).get("password") || "";
    try {
      await call("/login", { method: "POST", body: JSON.stringify({ password }) });
      showApp("local");
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-search]")?.addEventListener("input", (event) => {
    const q = event.target.value.trim().toLowerCase();
    if (!results) return;
    if (q.length < 2) {
      results.innerHTML = "";
      return;
    }
    const matches = books
      .filter((book) => `${book.title} ${book.author} ${book.slug}`.toLowerCase().includes(q))
      .slice(0, 40);
    results.innerHTML = matches
      .map(
        (book) =>
          `<li><button type="button" class="w-full rounded-lg border border-border px-3 py-2 text-left hover:border-primary" data-slug="${escapeHtml(book.slug)}">${escapeHtml(book.title)} <span class="text-muted-foreground">· ${escapeHtml(book.author)}</span></button></li>`,
      )
      .join("");
  });

  results?.addEventListener("click", (event) => {
    const button = event.target.closest("[data-slug]");
    if (!button) return;
    const book = books.find((item) => item.slug === button.dataset.slug);
    if (book) fillBook(book);
  });

  artList?.addEventListener("click", (event) => {
    const button = event.target.closest("[data-art-slug]");
    if (!button) return;
    const piece = artPieces.find((item) => item.slug === button.dataset.artSlug);
    if (piece) fillArt({ ...piece, create: false });
  });

  document.querySelector("[data-art-new]")?.addEventListener("click", () => {
    fillArt({
      slug: "",
      title: "",
      medium: "Acrylic",
      note: "",
      featured: false,
      image: "",
      order: artPieces.length + 1,
      create: true,
    });
    document.querySelector("[data-art-title]")?.focus();
  });

  supplyList?.addEventListener("click", (event) => {
    const button = event.target.closest("[data-supply-slug]");
    if (!button) return;
    const item = supplies.find((entry) => entry.slug === button.dataset.supplySlug);
    if (item) fillSupply({ ...item, create: false });
  });

  document.querySelector("[data-supply-new]")?.addEventListener("click", () => {
    const nextOrder = supplies.reduce((max, item) => Math.max(max, Number(item.order) || 0), 0) + 1;
    fillSupply({
      slug: "",
      title: "",
      brand: "",
      category: "",
      note: "",
      amazon: "",
      shop: "",
      shopLabel: "",
      featured: false,
      order: nextOrder,
      create: true,
    });
    document.querySelector("[data-supply-title]")?.focus();
  });

  document.querySelector("[data-book-save]")?.addEventListener("click", async () => {
    if (!currentBook) return;
    try {
      currentBook.title = document.querySelector("[data-book-title]").value;
      currentBook.author = document.querySelector("[data-book-author]").value;
      currentBook.genre = document.querySelector("[data-book-genre]").value;
      currentBook.note = document.querySelector("[data-book-note]").value;
      currentBook.featured = document.querySelector("[data-book-featured]").checked;
      currentBook.bookshop = document.querySelector("[data-book-bookshop]").value;
      currentBook.amazon = document.querySelector("[data-book-amazon]").value;
      await call("/book", {
        method: "POST",
        body: JSON.stringify({
          slug: currentBook.slug,
          title: currentBook.title,
          author: currentBook.author,
          genre: currentBook.genre,
          note: currentBook.note,
          featured: currentBook.featured,
          bookshop: currentBook.bookshop,
          amazon: currentBook.amazon,
        }),
      });
      const file = document.querySelector("[data-book-cover]").files[0];
      if (file) {
        if (file.size > 2 * 1024 * 1024) throw new Error("Cover is too large (2 MB max)");
        await call("/cover", {
          method: "POST",
          body: JSON.stringify({
            kind: "book",
            slug: currentBook.slug,
            filename: file.name,
            contentBase64: toBase64(await file.arrayBuffer()),
          }),
        });
        currentBook.cover = file.name;
        resetDrop("book", "", `Saved ${file.name}`);
      }
      if (status) {
        status.textContent = isDev
          ? `Saved ${currentBook.title}. Refresh the site to see it.`
          : `Saved ${currentBook.title}. It will show on the site after the rebuild.`;
      }
      loadActivity();
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-art-save]")?.addEventListener("click", async () => {
    if (!currentArt) return;
    try {
      currentArt.title = document.querySelector("[data-art-title]").value;
      currentArt.medium = document.querySelector("[data-art-medium]").value;
      currentArt.note = document.querySelector("[data-art-note]").value;
      currentArt.featured = document.querySelector("[data-art-featured]").checked;
      currentArt.order = Number(document.querySelector("[data-art-order]").value || 0);
      const file = document.querySelector("[data-art-image]").files[0];
      const photo = file ? await preparePhoto(file) : null;
      const created = await call("/art", {
        method: "POST",
        body: JSON.stringify({
          create: Boolean(currentArt.create),
          slug: currentArt.slug,
          title: currentArt.title,
          medium: currentArt.medium,
          note: currentArt.note,
          featured: currentArt.featured,
          order: currentArt.order,
          ...(photo || {}),
        }),
      });
      currentArt.slug = created.slug || currentArt.slug;
      currentArt.create = false;
      if (created.image) currentArt.image = created.image;
      document.querySelector("[data-art-delete]")?.classList.remove("hidden");
      const existing = artPieces.find((item) => item.slug === currentArt.slug);
      if (existing) Object.assign(existing, currentArt);
      else artPieces.push({ ...currentArt });
      renderArtList();
      if (file) {
        const preview = document.querySelector("[data-art-preview]");
        const label = document.querySelector("[data-art-drop-label]");
        if (preview && previewUrls.art) {
          preview.src = previewUrls.art;
          preview.classList.remove("hidden");
        }
        if (label) {
          label.textContent = isDev
            ? "Photo saved. Refresh the Art page to see it."
            : "Photo saved. It shows on the site after the rebuild.";
        }
      }
      if (status) {
        status.textContent = isDev
          ? `Saved ${currentArt.title}. Refresh the site to see it.`
          : `Saved ${currentArt.title}. It will show on the site after the rebuild.`;
      }
      loadActivity();
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-art-delete]")?.addEventListener("click", async () => {
    if (!currentArt?.slug || currentArt.create) return;
    const title = currentArt.title || currentArt.slug;
    if (!confirm(`Delete "${title}"? It will leave the Art page after the next rebuild.`)) return;
    try {
      await call("/art", {
        method: "POST",
        body: JSON.stringify({ delete: true, slug: currentArt.slug }),
      });
      const index = artPieces.findIndex((item) => item.slug === currentArt.slug);
      if (index >= 0) artPieces.splice(index, 1);
      renderArtList();
      artEditor?.classList.add("hidden");
      currentArt = null;
      if (status) {
        status.textContent = isDev
          ? `Deleted ${title}. Refresh the site to see it gone.`
          : `Deleted ${title}. It will leave the site after the rebuild.`;
      }
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-supply-save]")?.addEventListener("click", async () => {
    if (!currentSupply) return;
    try {
      currentSupply.title = document.querySelector("[data-supply-title]").value;
      currentSupply.brand = document.querySelector("[data-supply-brand]").value;
      currentSupply.category = document.querySelector("[data-supply-category]").value;
      currentSupply.note = document.querySelector("[data-supply-note]").value;
      currentSupply.featured = document.querySelector("[data-supply-featured]").checked;
      currentSupply.order = Number(document.querySelector("[data-supply-order]").value || 0);
      currentSupply.amazon = document.querySelector("[data-supply-amazon]").value;
      currentSupply.shop = document.querySelector("[data-supply-shop]").value;
      currentSupply.shopLabel = document.querySelector("[data-supply-shop-label]").value;
      const created = await call("/supply", {
        method: "POST",
        body: JSON.stringify({
          create: Boolean(currentSupply.create),
          slug: currentSupply.slug,
          title: currentSupply.title,
          brand: currentSupply.brand,
          category: currentSupply.category,
          note: currentSupply.note,
          featured: currentSupply.featured,
          order: currentSupply.order,
          amazon: currentSupply.amazon,
          shop: currentSupply.shop,
          shopLabel: currentSupply.shopLabel,
        }),
      });
      currentSupply.slug = created.slug || currentSupply.slug;
      currentSupply.create = false;
      document.querySelector("[data-supply-delete]")?.classList.remove("hidden");
      const existing = supplies.find((item) => item.slug === currentSupply.slug);
      if (existing) Object.assign(existing, currentSupply);
      else supplies.push({ ...currentSupply });
      supplies.sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
      renderSupplyList();
      if (status) {
        status.textContent = isDev
          ? `Saved ${currentSupply.title}. Refresh the site to see it.`
          : `Saved ${currentSupply.title}. It will show on the site after the rebuild.`;
      }
      loadActivity();
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-supply-delete]")?.addEventListener("click", async () => {
    if (!currentSupply?.slug || currentSupply.create) return;
    const title = currentSupply.title || currentSupply.slug;
    if (!confirm(`Delete "${title}"? It will leave the Art page after the next rebuild.`)) return;
    try {
      await call("/supply", {
        method: "POST",
        body: JSON.stringify({ delete: true, slug: currentSupply.slug }),
      });
      const index = supplies.findIndex((item) => item.slug === currentSupply.slug);
      if (index >= 0) supplies.splice(index, 1);
      renderSupplyList();
      supplyEditor?.classList.add("hidden");
      currentSupply = null;
      if (status) {
        status.textContent = isDev
          ? `Deleted ${title}. Refresh the site to see it gone.`
          : `Deleted ${title}. It will leave the site after the rebuild.`;
      }
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-import]")?.addEventListener("click", async () => {
    const file = document.querySelector("[data-csv]").files[0];
    const log = document.querySelector("[data-log]");
    if (!file) return;
    try {
      if (log) log.textContent = "Importing…";
      const data = await call("/csv", {
        method: "POST",
        body: JSON.stringify({ filename: file.name, contentBase64: toBase64(await file.arrayBuffer()) }),
      });
      if (log) log.textContent = data.log || "Done.";
      loadActivity();
    } catch (error) {
      if (log) log.textContent = error.message;
    }
  });

  boot();
</script>
</BaseLayout>
