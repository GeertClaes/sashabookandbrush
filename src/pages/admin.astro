    const row = event.target.closest("[data-featured-slug]");
    if (!row) return;
    const slug = row.dataset.featuredSlug;
    const featured = featuredList();
    const index = featured.findIndex((book) => book.slug === slug);
    if (index < 0) return;
    if (event.target.closest("[data-featured-up]") && index > 0) {
      const swap = featured[index - 1];
      featured[index - 1] = featured[index];
      featured[index] = swap;
      featured.forEach((book, i) => {
        book.order = i + 1;
      });
      renderFeaturedBoard();
      return;
    }
    if (event.target.closest("[data-featured-down]") && index < featured.length - 1) {
      const swap = featured[index + 1];
      featured[index + 1] = featured[index];
      featured[index] = swap;
      featured.forEach((book, i) => {
        book.order = i + 1;
      });
      renderFeaturedBoard();
      return;
    }
    if (event.target.closest("[data-featured-off]")) {
      unfeatureBook(featured[index]);
      return;
    }
    if (event.target.closest("[data-featured-open]")) {
      fillBook(featured[index]);
    }
  });

