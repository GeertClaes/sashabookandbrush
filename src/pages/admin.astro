---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ImageMetadata } from "astro";
import live from "../data/goodreads-live.json";
import site from "../data/site.json";
import { affiliateLinks, realUrl } from "../lib/affiliates";
import { coverModule } from "../lib/covers";
import { getCollection } from "astro:content";

const artImages = import.meta.glob<{ default: ImageMetadata }>("../assets/art/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const supplyImages = import.meta.glob<{ default: ImageMetadata }>("../assets/supplies/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const artImageUrl = (imagePath: string) => {
  const filename = (imagePath || "").split("/").pop() || "";
  const match = filename ? Object.entries(artImages).find(([key]) => key.endsWith(`/${filename}`)) : undefined;
  return match?.[1].default.src || "";
};
const supplyImageUrl = (imagePath: string) => {
  const filename = (imagePath || "").split("/").pop() || "";
  const match = filename ? Object.entries(supplyImages).find(([key]) => key.endsWith(`/${filename}`)) : undefined;
  return match?.[1].default.src || "";
};

const isDev = import.meta.env.DEV;
const api = isDev ? import.meta.env.PUBLIC_ADMIN_URL || "http://127.0.0.1:8787" : "";
const books = (await getCollection("books"))
  .map((book) => ({
    slug: book.id,
    title: book.data.title,
    author: book.data.author,
    note: book.data.note || "",
    featured: Boolean(book.data.featured),
    cover: book.data.cover || "",
    coverUrl: coverModule(book.data.cover)?.src || "",
    genre: book.data.genre || "",
    bookshop: book.data.bookshop === "#" ? "" : book.data.bookshop || "",
    amazon: book.data.amazon === "#" ? "" : book.data.amazon || "",
    isbn: book.data.isbn || "",
    isbn10: book.data.isbn10 || "",
    rating: book.data.rating || 0,
    status: book.data.status || "read",
    dateRead: book.data.dateRead || "",
    order: book.data.order || 0,
    buy: affiliateLinks(book.data),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
const art = (await getCollection("art"))
  .map((piece) => ({
    slug: piece.id,
    title: piece.data.title,
    medium: piece.data.medium,
    note: piece.data.note || "",
    featured: Boolean(piece.data.featured),
    image: piece.data.image || "",
    imageUrl: artImageUrl(piece.data.image || ""),
    order: piece.data.order || 0,
    available: Boolean(piece.data.available),
    shop: piece.data.shop || "",
    shopLabel: piece.data.shopLabel || "",
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
const supplies = (await getCollection("supplies"))
  .map((item) => ({
    slug: item.id,
    title: item.data.title,
    brand: item.data.brand,
    category: item.data.category,
    note: item.data.note || "",
    amazon: realUrl(item.data.amazon),
    shop: item.data.shop || "",
    shopLabel: item.data.shopLabel || "",
    image: item.data.image || "",
    imageUrl: supplyImageUrl(item.data.image || ""),
    featured: Boolean(item.data.featured),
    order: item.data.order || 0,
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const syncedAt = live.updated
  ? new Date(live.updated).toLocaleString("en-GB", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "Europe/London",
    })
  : "never";
const stats = [
  { label: "Goodreads RSS", value: syncedAt },
  { label: "Currently reading", value: String(live.currentlyReading?.length || 0) },
  { label: "TBR teaser", value: String(live.upNext?.length || 0) },
  { label: "Books on site", value: String(books.length) },
  { label: "Featured books", value: String(books.filter((book) => book.featured).length) },
  { label: "Paintings", value: String(art.length) },
  { label: "Tools", value: String(supplies.length) },
];
const health = [
  {
    label: "Public notes",
    value: `${books.filter((book) => book.note.trim()).length} / ${books.length}`,
    tab: "book",
    queue: "no-note",
  },
  {
    label: "Featured",
    value: `${books.filter((book) => book.featured).length} / target 6–8`,
    tab: "book",
    queue: "featured",
  },
  {
    label: "Currently reading",
    value: String(books.filter((book) => book.status === "currently-reading").length),
    tab: "book",
    queue: "currently-reading",
  },
  {
    label: "Five-star, no note",
    value: String(books.filter((book) => book.rating === 5 && !book.note.trim()).length),
    tab: "book",
    queue: "five-star-no-note",
  },
  {
    label: "Missing ISBN",
    value: String(books.filter((book) => !book.isbn && !book.isbn10).length),
    tab: "book",
    queue: "missing-isbn",
  },
  {
    label: "Tools without Amazon",
    value: `${supplies.filter((item) => !item.amazon).length} / ${supplies.length}`,
    tab: "supply",
  },
  {
    label: "Art missing image",
    value: String(art.filter((piece) => !piece.image).length),
    tab: "art",
  },
  {
    label: "Art empty note",
    value: String(art.filter((piece) => !piece.note.trim()).length),
    tab: "art",
  },
];
const affiliateConfig = {
  amazonTag: site.affiliates?.amazonTag || "",
  bookshopUkId: site.affiliates?.bookshopUkId || "",
  siteOrigin: "https://sashabookandbrush.com",
};
---

<BaseLayout
  title="Library editor"
  description="Private editor for books, art, and tools."
  noindex={true}
>
  <div class="min-h-screen bg-background">
    <div class="mx-auto max-w-6xl px-6 py-12 md:px-12 md:py-16">
      <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">Private</p>
      <h1 class="font-display mb-3 text-3xl font-semibold text-foreground">Studio editor</h1>
      <p class="mb-8 max-w-xl text-sm leading-relaxed text-muted-foreground">
        Ratings and progress stay on Goodreads. Notes, covers, featured cards, paintings, and tools live here.
        {
          isDev ? (
            <>
              {" "}
              Locally, also run <code class="text-foreground">npm run admin</code>.
            </>
          ) : (
            <> Sign in with Google if Cloudflare asks.</>
          )
        }
      </p>

      <p
        data-status
        role="status"
        aria-live="polite"
        class="sticky top-16 z-40 mb-6 rounded-lg border border-transparent bg-background/95 px-3 py-2 text-sm text-muted-foreground backdrop-blur-sm"
      >
        Checking the editor…
      </p>

      {
        isDev && (
          <form data-login class="mb-10 hidden rounded-xl border border-border bg-card p-5">
            <label class="block text-sm font-medium text-foreground">
              Password
              <input
                type="password"
                name="password"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2"
              />
            </label>
            <button type="submit" class="mt-4 rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
              Sign in
            </button>
          </form>
        )
      }

      <div data-app class="hidden space-y-8">
        <div class="sticky top-28 z-30 -mx-2 flex flex-wrap gap-2 bg-background/95 px-2 py-2 backdrop-blur-sm">
          <button
            type="button"
            data-tab="overview"
            class="rounded-full bg-primary px-4 py-2 text-sm text-primary-foreground"
          >
            Overview
          </button>
          <button
            type="button"
            data-tab="book"
            class="rounded-full border border-border px-4 py-2 text-sm text-foreground"
          >
            Books
          </button>
          <button
            type="button"
            data-tab="art"
            class="rounded-full border border-border px-4 py-2 text-sm text-foreground"
          >
            Art
          </button>
          <button
            type="button"
            data-tab="supply"
            class="rounded-full border border-border px-4 py-2 text-sm text-foreground"
          >
            Tools
          </button>
        </div>

        <div data-panel="overview" class="space-y-6">
          <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {
              stats.map((item) => (
                <div class="rounded-xl border border-border bg-card px-4 py-3">
                  <dt class="text-xs tracking-widest text-muted-foreground uppercase">{item.label}</dt>
                  <dd class="font-display mt-1 text-lg font-semibold text-foreground">{item.value}</dd>
                </div>
              ))
            }
          </dl>

          <section class="rounded-xl border border-border bg-card p-5">
            <h2 class="font-display mb-1 text-xl font-semibold text-foreground">Content health</h2>
            <p class="mb-4 text-sm text-muted-foreground">
              Queues for notes, featured cards, and missing links. Counts refresh after the next rebuild.
            </p>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              {
                health.map((item) => (
                  <button
                    type="button"
                    data-health-tab={item.tab}
                    data-health-queue={item.queue || ""}
                    class="rounded-lg border border-border bg-background px-3 py-3 text-left hover:border-primary"
                  >
                    <span class="block text-xs tracking-widest text-muted-foreground uppercase">{item.label}</span>
                    <span class="font-display mt-1 block text-lg font-semibold text-foreground">{item.value}</span>
                  </button>
                ))
              }
            </div>
          </section>

          <section class="rounded-xl border border-border bg-card p-5">
            <h2 class="font-display mb-1 text-xl font-semibold text-foreground">For Instagram</h2>
            <p class="mb-4 text-sm text-muted-foreground">
              Copy a page or shop link for a Story sticker or the bio. These always go to the live site.
            </p>
            <div class="mb-4 flex flex-wrap gap-2" data-ig-pages></div>
            <div data-ig-reading class="space-y-2"></div>
          </section>

          <div class="grid gap-6 lg:grid-cols-2">
            <section class="rounded-xl border border-border bg-card p-5">
              <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h2 class="font-display text-xl font-semibold text-foreground">Goodreads &amp; live site</h2>
                  <p class="mt-1 text-sm text-muted-foreground">
                    Reload this status. It does not start a new Goodreads pull — that happens when the site rebuilds.
                  </p>
                </div>
                <button
                  type="button"
                  data-activity-refresh
                  class="cursor-pointer rounded border border-border px-3 py-1.5 text-sm text-foreground transition-colors hover:border-primary hover:bg-muted hover:text-primary disabled:pointer-events-none disabled:opacity-60"
                >
                  Refresh
                </button>
              </div>
              <p data-activity-site class="text-sm text-muted-foreground">Checking…</p>
              <p data-activity-checked class="mt-1 text-xs text-muted-foreground"></p>
              <div data-activity-sync class="mt-4 rounded-lg border border-border bg-background p-4 text-sm"></div>
            </section>

            <section class="rounded-xl border border-border bg-card p-5">
              <h2 class="font-display mb-1 text-xl font-semibold text-foreground">Recent activity</h2>
              <p class="mb-4 text-sm text-muted-foreground">Saves from this editor and Goodreads syncs.</p>
              <ol data-activity-log class="space-y-2 text-sm"></ol>
            </section>
          </div>

          <details class="rounded-xl border border-border bg-card px-5 py-4 text-sm">
            <summary class="cursor-pointer font-medium text-muted-foreground">
              Advanced: import a Goodreads CSV
            </summary>
            <p class="mt-3 text-muted-foreground">
              Only needed when ratings or new finished books should land on the site. Notes, covers, and featured
              flags are kept.
            </p>
            <input type="file" data-csv accept=".csv" class="mt-4 block text-sm" />
            <button type="button" data-import class="mt-3 rounded border border-border px-4 py-2 text-sm">
              Import CSV
            </button>
            <pre data-log class="mt-3 overflow-x-auto text-xs text-muted-foreground"></pre>
          </details>
        </div>

        <div data-panel="book" class="hidden">
          <div class="grid items-start gap-6 lg:grid-cols-[minmax(17rem,22rem)_minmax(0,1fr)]">
          <div class="space-y-4 lg:sticky lg:top-40">
          <details class="rounded-xl border border-border bg-card p-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-foreground">
              <span>Home featured</span>
              <span class="text-xs font-normal text-muted-foreground" data-featured-count></span>
            </summary>
            <div class="mt-3 flex flex-wrap items-center justify-end gap-2">
              <button
                type="button"
                data-featured-save
                class="rounded border border-border px-3 py-1.5 text-xs text-foreground hover:border-primary"
              >
                Save order
              </button>
            </div>
            <ol data-featured-board class="mt-3 space-y-2 text-sm"></ol>
          </details>

          <section class="rounded-xl border border-border bg-card p-4">
            <h2 class="font-display mb-3 text-lg font-semibold text-foreground">Find a book</h2>
            <input
              type="search"
              data-search
              placeholder="Search any title or author…"
              class="mb-3 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
            />
            <div class="mb-3 flex flex-wrap gap-1.5" data-queues role="tablist" aria-label="Book queues">
              <button type="button" data-queue="currently-reading" class="rounded-full border border-border px-2.5 py-1 text-xs">Reading <span data-queue-n="currently-reading" class="text-muted-foreground"></span></button>
              <button type="button" data-queue="featured" class="rounded-full border border-border px-2.5 py-1 text-xs">Featured <span data-queue-n="featured" class="text-muted-foreground"></span></button>
              <button type="button" data-queue="five-star-no-note" class="rounded-full border border-border px-2.5 py-1 text-xs">5★ no note <span data-queue-n="five-star-no-note" class="text-muted-foreground"></span></button>
              <button type="button" data-queue="no-note" class="rounded-full border border-border px-2.5 py-1 text-xs">No note <span data-queue-n="no-note" class="text-muted-foreground"></span></button>
              <button type="button" data-queue="missing-isbn" class="rounded-full border border-border px-2.5 py-1 text-xs">No ISBN <span data-queue-n="missing-isbn" class="text-muted-foreground"></span></button>
            </div>
            <p data-queue-count class="mb-2 text-xs text-muted-foreground"></p>
            <ul data-results class="max-h-[min(70vh,40rem)] space-y-1.5 overflow-y-auto text-sm"></ul>
          </section>
          </div>

          <div>
          <p data-book-empty class="rounded-xl border border-dashed border-border bg-card px-5 py-16 text-center text-sm text-muted-foreground">
            Pick a book to write a note, drop a cover, or feature it on Home.
          </p>
          <section data-book-editor class="hidden rounded-xl border border-border bg-card p-5 lg:sticky lg:top-40">
            <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 data-book-heading class="font-display text-xl font-semibold text-foreground"></h2>
                <p data-book-meta class="mt-1 text-xs text-muted-foreground"></p>
              </div>
              <div class="flex flex-wrap gap-2">
                <a
                  data-book-view
                  class="rounded border border-border px-3 py-1.5 text-sm font-medium text-foreground hover:border-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View on site
                </a>
                <button
                  type="button"
                  data-book-next
                  class="hidden rounded border border-border px-3 py-1.5 text-sm text-foreground hover:border-primary"
                >
                  Next in list
                </button>
              </div>
            </div>
            <div class="mb-4 rounded-lg border border-border bg-background p-3">
              <p class="mb-1 text-xs font-medium tracking-widest text-accent uppercase">For Instagram</p>
              <p class="mb-2 text-xs text-muted-foreground">Paste into a Story link sticker.</p>
              <div class="flex flex-wrap gap-2">
                <button type="button" data-copy="page" class="rounded border border-border px-3 py-1.5 text-xs text-foreground hover:border-primary">
                  Copy page link
                </button>
                <button type="button" data-copy="bookshop" class="rounded border border-border px-3 py-1.5 text-xs text-foreground hover:border-primary">
                  Copy Bookshop
                </button>
                <button type="button" data-copy="amazon" class="rounded border border-border px-3 py-1.5 text-xs text-foreground hover:border-primary">
                  Copy Amazon
                </button>
              </div>
            </div>
            <label class="mb-1 block text-sm font-medium text-foreground">
              Public note
              <textarea
                data-book-note
                rows="7"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              ></textarea>
            </label>
            <p data-book-note-count class="mb-4 text-xs text-muted-foreground"></p>
            <label class="mb-4 flex items-center gap-2 text-sm text-foreground">
              <input type="checkbox" data-book-featured />
              Feature on the home page
            </label>
            <p class="mb-2 text-sm font-medium text-foreground">Cover</p>
            <button
              type="button"
              data-book-drop
              class="mb-4 flex min-h-36 w-full flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-border bg-background px-4 py-5 text-center text-sm text-muted-foreground hover:border-primary"
            >
              <img data-book-preview class="hidden max-h-40 rounded object-cover shadow" alt="" />
              <span data-book-drop-label>Drop a cover here, or click to choose a photo</span>
            </button>
            <input type="file" data-book-cover accept="image/jpeg,image/png,image/webp" class="hidden" />
            <details class="mb-4 rounded-lg border border-border bg-background px-4 py-3">
              <summary class="cursor-pointer text-sm font-medium text-foreground">Title, ISBN, and buy links</summary>
              <div class="mt-4 space-y-4">
                <label class="block text-sm font-medium text-foreground">
                  Title
                  <input data-book-title class="mt-2 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm" />
                </label>
                <label class="block text-sm font-medium text-foreground">
                  Author
                  <input data-book-author class="mt-2 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm" />
                </label>
                <label class="block text-sm font-medium text-foreground">
                  Genre on the site
                  <input data-book-genre class="mt-2 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm" />
                </label>
                <div class="grid gap-4 sm:grid-cols-2">
                  <label class="block text-sm font-medium text-foreground">
                    ISBN-13
                    <input data-book-isbn class="mt-2 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm" />
                  </label>
                  <label class="block text-sm font-medium text-foreground">
                    ISBN-10
                    <input data-book-isbn10 class="mt-2 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm" />
                  </label>
                </div>
                <div>
                  <p class="mb-2 text-sm font-medium text-foreground">Generated buy links</p>
                  <p data-book-buy class="text-sm text-muted-foreground"></p>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  <label class="block text-sm font-medium text-foreground">
                    Bookshop.org URL
                    <input
                      data-book-bookshop
                      placeholder="Leave blank to use ISBN"
                      class="mt-2 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"
                    />
                  </label>
                  <label class="block text-sm font-medium text-foreground">
                    Amazon URL
                    <input
                      data-book-amazon
                      placeholder="Leave blank to use ISBN"
                      class="mt-2 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"
                    />
                  </label>
                </div>
              </div>
            </details>
            <button type="button" data-book-save class="rounded bg-primary px-4 py-2 text-sm text-primary-foreground">
              Save book
            </button>
          </section>
          </div>
          </div>
        </div>

        <div data-panel="art" class="hidden">
          <div class="grid items-start gap-6 lg:grid-cols-[minmax(17rem,22rem)_minmax(0,1fr)]">
          <section class="rounded-xl border border-border bg-card p-4 lg:sticky lg:top-40">
            <div class="mb-4 flex items-center justify-between gap-3">
              <h2 class="font-display text-lg font-semibold text-foreground">Paintings</h2>
              <button
                type="button"
                data-art-new
                class="rounded border border-border px-3 py-1.5 text-sm"
              >
                New
              </button>
            </div>
            <p class="mb-3 text-xs text-muted-foreground">
              Drag the handle, or use the arrows. Order saves in one go and is the order on the Art page. Most pieces stay display-only — tick For sale only on originals she wants to sell.
            </p>
            <ul data-art-list class="space-y-2 text-sm"></ul>
          </section>
          <div>
          <p data-art-empty class="rounded-xl border border-dashed border-border bg-card px-5 py-16 text-center text-sm text-muted-foreground">
            Pick a painting, or add a new one.
          </p>
          <section data-art-editor class="hidden rounded-xl border border-border bg-card p-5 lg:sticky lg:top-40">
            <label class="mb-4 block text-sm font-medium text-foreground">
              Title
              <input data-art-title class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
            </label>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Medium
              <input
                data-art-medium
                placeholder="Acrylic"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              />
            </label>
            <label class="mb-4 block text-sm font-medium text-foreground">
              Note
              <textarea
                data-art-note
                rows="5"
                class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
              ></textarea>
            </label>
            <label class="mb-4 flex items-center gap-2 text-sm text-foreground">
              <input type="checkbox" data-art-featured />
              Feature on the home page
            </label>
            <label class="mb-1 flex items-center gap-2 text-sm text-foreground">
              <input type="checkbox" data-art-available />
              For sale
            </label>
            <p class="mb-4 text-xs text-muted-foreground">
              Off by default. Fan pieces and anything she is not selling stay on the wall — no buy button, no sale link.
            </p>
            <input type="hidden" data-art-order />
            <div data-art-sale-fields class="hidden">
              <label class="mb-4 block text-sm font-medium text-foreground">
                Sale link (optional)
                <input
                  data-art-shop
                  placeholder="Etsy, Gumroad… leave blank to send people to Instagram"
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
              <label class="mb-4 block text-sm font-medium text-foreground">
                Button label
                <input
                  data-art-shop-label
                  placeholder="Available — DM me"
                  class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
                />
              </label>
            </div>
            <div class="mb-4 flex flex-wrap gap-2">
              <button type="button" data-copy="art-page" class="rounded border border-border px-3 py-1.5 text-xs text-foreground hover:border-primary">
                Copy painting link
              </button>
              <button type="button" data-copy="art-shop" class="hidden rounded border border-border px-3 py-1.5 text-xs text-foreground hover:border-primary">
                Copy sale link
              </button>
              <button type="button" data-copy="art-index" class="rounded border border-border px-3 py-1.5 text-xs text-foreground hover:border-primary">
                Copy Art page
