  function sortedArt() {
    return artPieces.toSorted((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
  }

  function sortedSupply() {
    return supplies.toSorted((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
  }

  async function persistKindOrder(kind) {
    const items = kind === "art" ? sortedArt() : sortedSupply();
    items.forEach((item, index) => {
      item.order = index + 1;
    });
    await call("/order", {
      method: "POST",
      body: JSON.stringify({ kind, slugs: items.map((item) => item.slug) }),
    });
    if (kind === "art") renderArtList();
    else renderSupplyList();
    if (status) {
      status.textContent = isDev
        ? `Saved ${kind === "art" ? "painting" : "tool"} order. Refresh the site to see it.`
        : `Saved ${kind === "art" ? "painting" : "tool"} order. It will show after the rebuild.`;
    }
    loadActivity();
  }

  function applyDomOrder(listEl, kind) {
    const attr = kind === "art" ? "artSlug" : "supplySlug";
    const items = kind === "art" ? artPieces : supplies;
    const slugs = [...listEl.querySelectorAll("li[data-art-slug], li[data-supply-slug]")].map(
      (row) => row.dataset[attr],
    );
    slugs.forEach((slug, index) => {
      const item = items.find((entry) => entry.slug === slug);
      if (item) item.order = index + 1;
    });
  }

  function bindSortable(listEl, kind) {
    if (!listEl) return;
    let dragging = null;

    listEl.addEventListener("pointerdown", (event) => {
      const handle = event.target.closest("[data-drag]");
      const row = handle?.closest("li");
      if (!row) return;
      row.draggable = true;
    });

    listEl.addEventListener("dragstart", (event) => {
      const row = event.target.closest("li");
      if (!row || !event.target.closest("[data-drag]")) {
        event.preventDefault();
        return;
      }
      dragging = row;
      row.classList.add("opacity-60");
      event.dataTransfer.effectAllowed = "move";
      event.dataTransfer.setData("text/plain", row.dataset.artSlug || row.dataset.supplySlug || "");
    });

    listEl.addEventListener("dragover", (event) => {
      event.preventDefault();
      const over = event.target.closest("li");
      if (!dragging || !over || over === dragging) return;
      const rect = over.getBoundingClientRect();
      const before = event.clientY < rect.top + rect.height / 2;
      listEl.insertBefore(dragging, before ? over : over.nextSibling);
    });

    listEl.addEventListener("drop", (event) => {
      event.preventDefault();
    });

    listEl.addEventListener("dragend", () => {
      if (!dragging) return;
      dragging.classList.remove("opacity-60");
      dragging.draggable = false;
      dragging = null;
      applyDomOrder(listEl, kind);
      persistKindOrder(kind).catch((error) => {
        if (status) status.textContent = error.message;
      });
    });
  }

  async function boot() {
    try {
      const health = await call("/health");
      if (isDev) {
        try {
          await call("/books?q=");
        } catch {
          login?.classList.remove("hidden");
          if (status) status.textContent = "Sign in to edit the library.";
          return;
        }
      }
      showApp(health.email);
    } catch (error) {
      if (isDev) {
        if (status) {
          status.textContent = "The editor API is not running. On this computer: npm run admin — then refresh.";
        }
        return;
      }
      if (status) status.textContent = error instanceof Error ? error.message : "Could not reach the editor.";
    }
  }

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;
    const refresh = target.closest("[data-activity-refresh]");
    if (refresh && !refresh.disabled) {
      event.preventDefault();
      loadActivity({ manual: true });
      return;
    }
    const valued = target.closest("[data-copy-value]");
    if (valued) {
      event.preventDefault();
      copyText(valued.dataset.copyLabel || "link", valued.dataset.copyValue || "");
      return;
    }
    const copy = target.closest("[data-copy]");
    if (!copy) return;
    event.preventDefault();
    const origin = siteOrigin();
    const which = copy.dataset.copy;
    if (which === "page" && currentBook) copyText("page link", `${origin}/books/${currentBook.slug}`);
    if (which === "bookshop" && currentBook) copyText("Bookshop link", previewBuy(readBookBuyFields()).bookshop);
    if (which === "amazon" && currentBook) copyText("Amazon link", previewBuy(readBookBuyFields()).amazon);
    if (which === "art-page" && currentArt?.slug) copyText("painting link", `${origin}/art#${currentArt.slug}`);
    if (which === "art-shop") {
      const onSale = Boolean(document.querySelector("[data-art-available]")?.checked ?? currentArt?.available);
      const shop = displayUrl(document.querySelector("[data-art-shop]")?.value || currentArt?.shop || "");
      copyText("sale link", onSale ? shop || "https://instagram.com/sashabookandbrush" : "");
    }
    if (which === "art-index") copyText("Art page", `${origin}/art`);
    if (which === "tool-page" && currentSupply?.slug) copyText("tool link", `${origin}/art#${currentSupply.slug}`);
    if (which === "tool-amazon") copyText("Amazon link", taggedAmazon(document.querySelector("[data-supply-amazon]")?.value || currentSupply?.amazon || ""));
    if (which === "tools-index") copyText("tools page", `${origin}/art#supplies`);
  });

  function readBookBuyFields() {
    return {
      isbn: document.querySelector("[data-book-isbn]")?.value,
      isbn10: document.querySelector("[data-book-isbn10]")?.value,
      bookshop: document.querySelector("[data-book-bookshop]")?.value,
      amazon: document.querySelector("[data-book-amazon]")?.value,
    };
  }

  document.querySelector("[data-tabs]")?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
    const tabs = [...document.querySelectorAll("[data-tabs] [data-tab]")];
    const index = tabs.findIndex((button) => button.getAttribute("aria-selected") === "true");
    if (index < 0) return;
    const next = event.key === "ArrowRight" ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
    event.preventDefault();
    tabs[next].focus();
    setTab(tabs[next].dataset.tab);
  });

  document.querySelectorAll("[data-tab]").forEach((button) => {
    button.addEventListener("click", () => setTab(button.dataset.tab));
  });

  document.querySelector("[data-sync-now]")?.addEventListener("click", async () => {
    const button = document.querySelector("[data-sync-now]");
    if (!button || button.disabled) return;
    button.disabled = true;
    const idle = button.textContent;
    button.textContent = "Syncing…";
    syncWatchMark = latestMark(lastActivity);
    syncPendingAt = new Date().toISOString();
    syncPending = true;
    if (lastActivity) renderActivity(lastActivity);
    setBanner(
      "busy",
      syncSteps({
        title: "Starting the Goodreads sync…",
        request: "busy",
        requestDetail: "Asking GitHub to run the sync.",
        github: "wait",
        githubDetail: "Will fetch the shelf and commit any changes.",
        live: "wait",
        liveDetail: "Rebuilds only if the shelf changed.",
      }),
    );
    try {
      await call("/sync-goodreads", { method: "POST", body: "{}" });
      const data = await watchSyncProgress(syncWatchMark);
      syncPending = false;
      if (data) renderActivity(data);
    } catch (error) {
      syncPending = false;
      setBanner("error", escapeHtml(error instanceof Error ? error.message : "Sync failed."));
      const data = await loadActivity({ manual: true });
      if (data) renderActivity(data);
    } finally {
      syncPending = false;
      button.disabled = false;
      button.textContent = idle;
    }
  });

