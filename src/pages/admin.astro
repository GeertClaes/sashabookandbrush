    const slug = row.dataset.featuredSlug;
    const featured = featuredList();
    const index = featured.findIndex((book) => book.slug === slug);
    if (index < 0) return;
    if (event.target.closest("[data-featured-up]") && index > 0) {
      const swap = featured[index - 1];
      featured[index - 1] = featured[index];
      featured[index] = swap;
      featured.forEach((book, i) => {
        book.order = i + 1;
      });
      renderFeaturedBoard();
      return;
    }
    if (event.target.closest("[data-featured-down]") && index < featured.length - 1) {
      const swap = featured[index + 1];
      featured[index + 1] = featured[index];
      featured[index] = swap;
      featured.forEach((book, i) => {
        book.order = i + 1;
      });
      renderFeaturedBoard();
      return;
    }
    if (event.target.closest("[data-featured-off]")) {
      unfeatureBook(featured[index]);
      return;
    }
    if (event.target.closest("[data-featured-open]")) {
      fillBook(featured[index]);
    }
  });

  async function unfeatureBook(book) {
    try {
      await call("/featured", { method: "POST", body: JSON.stringify({ books: [{ slug: book.slug, featured: false }] }) });
      book.featured = false;
      featuredBaseline = featuredBaseline.filter((slug) => slug !== book.slug);
      renderFeaturedBoard();
      renderQueue();
      if (status) status.textContent = `Removed ${book.title} from Home. Live after rebuild.`;
      loadActivity();
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  }

  document.querySelector("[data-featured-save]")?.addEventListener("click", async () => {
    const button = document.querySelector("[data-featured-save]");
    const payload = featuredList().map((book) => ({ slug: book.slug, featured: true }));
    if (!payload.length) return;
    if (button) {
      button.disabled = true;
      button.textContent = "Saving…";
    }
    try {
      await call("/featured", { method: "POST", body: JSON.stringify({ books: payload.slice(0, 20) }) });
      featuredList().forEach((book, index) => {
        book.order = index + 1;
      });
      featuredBaseline = featuredList().map((book) => book.slug);
      renderFeaturedBoard();
      if (status) {
        status.textContent = isDev
          ? "Featured order saved. Refresh the site to see it."
          : "Featured order saved. It will show on the site after the rebuild.";
      }
      loadActivity();
    } catch (error) {
      if (status) status.textContent = error.message;
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = "Save order";
      }
    }
  });

  results?.addEventListener("click", (event) => {
    const button = event.target.closest("[data-slug]");
    if (!button) return;
    const book = books.find((item) => item.slug === button.dataset.slug);
    if (book) fillBook(book);
  });

  artList?.addEventListener("click", (event) => {
    if (event.target.closest("[data-copy-value], [data-drag]")) return;
    const row = event.target.closest("[data-art-slug]");
    if (!row) return;
    const sorted = artPieces.toSorted((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
    const index = sorted.findIndex((item) => item.slug === row.dataset.artSlug);
    if (index < 0) return;
    if (event.target.closest("[data-art-up]") || event.target.closest("[data-art-down]")) {
      event.preventDefault();
      const dir = event.target.closest("[data-art-up]") ? -1 : 1;
      const next = index + dir;
      if (!sorted[next]) return;
      const moved = sorted[index];
      sorted[index] = sorted[next];
      sorted[next] = moved;
      sorted.forEach((item, i) => {
        item.order = i + 1;
      });
      renderArtList();
      persistKindOrder("art").catch((error) => {
        if (status) status.textContent = error.message;
      });
      return;
    }
    fillArt({ ...sorted[index], create: false });
  });

  document.querySelector("[data-art-available]")?.addEventListener("change", syncArtSaleFields);

  document.querySelector("[data-art-new]")?.addEventListener("click", () => {
    fillArt({
      slug: "",
      title: "",
      medium: "Acrylic",
      note: "",
      featured: false,
      available: false,
      shop: "",
      shopLabel: "",
      image: "",
      order: artPieces.length + 1,
      create: true,
    });
    document.querySelector("[data-art-title]")?.focus();
  });

  supplyList?.addEventListener("click", (event) => {
    if (event.target.closest("[data-copy-value], [data-drag]")) return;
    const row = event.target.closest("[data-supply-slug]");
    if (!row) return;
    const sorted = supplies.toSorted((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
    const index = sorted.findIndex((item) => item.slug === row.dataset.supplySlug);
    if (index < 0) return;
    if (event.target.closest("[data-supply-up]") || event.target.closest("[data-supply-down]")) {
      event.preventDefault();
      const dir = event.target.closest("[data-supply-up]") ? -1 : 1;
      const next = index + dir;
      if (!sorted[next]) return;
      const moved = sorted[index];
      sorted[index] = sorted[next];
      sorted[next] = moved;
      sorted.forEach((item, i) => {
        item.order = i + 1;
      });
      renderSupplyList();
      persistKindOrder("supply").catch((error) => {
        if (status) status.textContent = error.message;
      });
      return;
    }
    fillSupply({ ...sorted[index], create: false });
  });

  document.querySelector("[data-supply-new]")?.addEventListener("click", () => {
    const nextOrder = supplies.reduce((max, item) => Math.max(max, Number(item.order) || 0), 0) + 1;
    fillSupply({
      slug: "",
      title: "",
      brand: "",
      category: "",
      note: "",
      amazon: "",
      shop: "",
      shopLabel: "",
      image: "",
      featured: false,
      order: nextOrder,
      create: true,
    });
    document.querySelector("[data-supply-title]")?.focus();
  });

  document.querySelector("[data-book-save]")?.addEventListener("click", async () => {
    if (!currentBook) {
      setBanner("error", "Pick a book first.");
      return;
    }
    await withSave(document.querySelector("[data-book-save]"), "Save book", async () => {
      const wasFeatured = Boolean(currentBook.featured);
      currentBook.title = document.querySelector("[data-book-title]").value;
      currentBook.author = document.querySelector("[data-book-author]").value;
      currentBook.genre = document.querySelector("[data-book-genre]").value;
      currentBook.note = document.querySelector("[data-book-note]").value;
      currentBook.featured = document.querySelector("[data-book-featured]").checked;
      currentBook.isbn = document.querySelector("[data-book-isbn]").value;
      currentBook.isbn10 = document.querySelector("[data-book-isbn10]").value;
      currentBook.bookshop = document.querySelector("[data-book-bookshop]").value;
      currentBook.amazon = document.querySelector("[data-book-amazon]").value;
      if (currentBook.featured && !wasFeatured) currentBook.order = nextFeaturedOrder();
      await call("/book", {
        method: "POST",
        body: JSON.stringify({
          slug: currentBook.slug,
          title: currentBook.title,
          author: currentBook.author,
          genre: currentBook.genre,
          note: currentBook.note,
          featured: currentBook.featured,
          order: currentBook.featured ? currentBook.order : undefined,
          isbn: currentBook.isbn,
          isbn10: currentBook.isbn10,
          bookshop: currentBook.bookshop,
          amazon: currentBook.amazon,
        }),
      });
      const file = document.querySelector("[data-book-cover]").files[0];
      if (file) {
        if (file.size > 2 * 1024 * 1024) throw new Error("Cover is too large (2 MB max)");
        await call("/cover", {
          method: "POST",
          body: JSON.stringify({
            kind: "book",
            slug: currentBook.slug,
            filename: file.name,
            contentBase64: toBase64(await file.arrayBuffer()),
          }),
        });
        currentBook.cover = file.name;
        resetDrop("book", previewUrls.book || currentBook.coverUrl || "", `Saved ${file.name}`);
      }
      const catalog = books.find((item) => item.slug === currentBook.slug);
      if (catalog) Object.assign(catalog, currentBook);
      featuredBaseline = books.filter((book) => book.featured).map((book) => book.slug);
      bookSnapshot = bookFormState();
      renderFeaturedBoard();
      renderQueue();
      updateNextButton();
      return { label: currentBook.title };
    });
  });

  document.querySelector("[data-art-save]")?.addEventListener("click", async () => {
    if (!currentArt) {
      setBanner("error", "Pick a painting first.");
      return;
    }
    await withSave(document.querySelector("[data-art-save]"), "Save painting", async () => {
      currentArt.title = document.querySelector("[data-art-title]").value;
      currentArt.medium = document.querySelector("[data-art-medium]").value;
      currentArt.note = document.querySelector("[data-art-note]").value;
      currentArt.featured = document.querySelector("[data-art-featured]").checked;
      currentArt.available = document.querySelector("[data-art-available]").checked;
      currentArt.shop = currentArt.available ? document.querySelector("[data-art-shop]").value : "";
      currentArt.shopLabel = currentArt.available ? document.querySelector("[data-art-shop-label]").value : "";
      currentArt.order = Number(document.querySelector("[data-art-order]").value || 0);
      const file = document.querySelector("[data-art-image]").files[0];
      const photo = file ? await preparePhoto(file) : null;
      const created = await call("/art", {
        method: "POST",
        body: JSON.stringify({
          create: Boolean(currentArt.create),
          slug: currentArt.slug,
          title: currentArt.title,
          medium: currentArt.medium,
          note: currentArt.note,
          featured: currentArt.featured,
          available: currentArt.available,
          shop: currentArt.shop,
          shopLabel: currentArt.shopLabel,
          order: currentArt.order,
          ...photo,
        }),
      });
      currentArt.slug = created.slug || currentArt.slug;
      currentArt.create = false;
      if (created.image) currentArt.image = created.image;
      document.querySelector("[data-art-delete]")?.classList.remove("hidden");
      const existing = artPieces.find((item) => item.slug === currentArt.slug);
      if (existing) Object.assign(existing, currentArt);
      else artPieces.push({ ...currentArt });
      renderArtList();
      if (file) {
        const preview = document.querySelector("[data-art-preview]");
        const label = document.querySelector("[data-art-drop-label]");
        if (preview && previewUrls.art) {
          preview.src = previewUrls.art;
          preview.classList.remove("hidden");
        }
        if (label) label.textContent = "Photo saved with the painting.";
      }
      return { label: currentArt.title };
    });
  });

  document.querySelector("[data-art-delete]")?.addEventListener("click", async () => {
    if (!currentArt?.slug || currentArt.create) return;
    const title = currentArt.title || currentArt.slug;
    if (!confirm(`Delete "${title}"? It will leave the Art page after the next rebuild.`)) return;
    try {
      await call("/art", {
        method: "POST",
        body: JSON.stringify({ delete: true, slug: currentArt.slug }),
      });
      const index = artPieces.findIndex((item) => item.slug === currentArt.slug);
      if (index >= 0) artPieces.splice(index, 1);
      currentArt = null;
      renderArtList();
      artEditor?.classList.add("hidden");
      document.querySelector("[data-art-empty]")?.classList.remove("hidden");
      if (status) {
        status.textContent = isDev
          ? `Deleted ${title}. Refresh the site to see it gone.`
          : `Deleted ${title}. It will leave the site after the rebuild.`;
      }
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-supply-save]")?.addEventListener("click", async () => {
    if (!currentSupply) {
      setBanner("error", "Pick a tool first, or click New.");
      return;
    }
    await withSave(document.querySelector("[data-supply-save]"), "Save tool", async () => {
      currentSupply.title = document.querySelector("[data-supply-title]").value;
      currentSupply.brand = document.querySelector("[data-supply-brand]").value;
      currentSupply.category = document.querySelector("[data-supply-category]").value;
      currentSupply.note = document.querySelector("[data-supply-note]").value;
      currentSupply.featured = document.querySelector("[data-supply-featured]").checked;
      currentSupply.order = Number(document.querySelector("[data-supply-order]").value || 0);
      const pasted = document.querySelector("[data-supply-amazon]").value;
      const cleaned = taggedAmazon(pasted);
      if (String(pasted || "").replace(/[\u200B-\u200D\uFEFF\u00AD]/g, "").trim() && pasted.trim() !== "#" && !cleaned) {
        throw new Error("That doesn't look like an Amazon product link. Paste the address from the product page.");
      }
      currentSupply.amazon = cleaned;
      currentSupply.shop = document.querySelector("[data-supply-shop]").value;
      currentSupply.shopLabel = document.querySelector("[data-supply-shop-label]").value;
      const file = document.querySelector("[data-supply-image]")?.files?.[0];
      const photo = file ? await preparePhoto(file) : null;
      const created = await call("/supply", {
        method: "POST",
        body: JSON.stringify({
          create: Boolean(currentSupply.create),
          slug: currentSupply.slug,
          title: currentSupply.title,
          brand: currentSupply.brand,
          category: currentSupply.category,
          note: currentSupply.note,
          featured: currentSupply.featured,
          order: currentSupply.order,
          amazon: currentSupply.amazon,
          shop: currentSupply.shop,
          shopLabel: currentSupply.shopLabel,
          ...photo,
        }),
      });
      currentSupply.slug = created.slug || currentSupply.slug;
      currentSupply.create = false;
      currentSupply.amazon = created.amazon ?? currentSupply.amazon;
      document.querySelector("[data-supply-amazon]").value = currentSupply.amazon || "";
      updateAmazonPreview();
      if (created.image) currentSupply.image = created.image;
      document.querySelector("[data-supply-delete]")?.classList.remove("hidden");
      const existing = supplies.find((item) => item.slug === currentSupply.slug);
      if (existing) Object.assign(existing, currentSupply);
      else supplies.push({ ...currentSupply });
      supplies.sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
      renderSupplyList();
      if (file) {
        const preview = document.querySelector("[data-supply-preview]");
        const label = document.querySelector("[data-supply-drop-label]");
        if (preview && previewUrls.supply) {
          preview.src = previewUrls.supply;
          preview.classList.remove("hidden");
        }
        if (label) label.textContent = "Photo saved with the tool.";
      }
      return { label: currentSupply.title };
    });
  });

  document.querySelector("[data-supply-delete]")?.addEventListener("click", async () => {
    if (!currentSupply?.slug || currentSupply.create) return;
    const title = currentSupply.title || currentSupply.slug;
    if (!confirm(`Delete "${title}"? It will leave the Art page after the next rebuild.`)) return;
    try {
      await call("/supply", {
        method: "POST",
        body: JSON.stringify({ delete: true, slug: currentSupply.slug }),
      });
      const index = supplies.findIndex((item) => item.slug === currentSupply.slug);
      if (index >= 0) supplies.splice(index, 1);
      currentSupply = null;
      renderSupplyList();
      supplyEditor?.classList.add("hidden");
      document.querySelector("[data-supply-empty]")?.classList.remove("hidden");
      if (status) {
        status.textContent = isDev
          ? `Deleted ${title}. Refresh the site to see it gone.`
          : `Deleted ${title}. It will leave the site after the rebuild.`;
      }
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  document.querySelector("[data-import]")?.addEventListener("click", async () => {
    const file = document.querySelector("[data-csv]").files[0];
    const log = document.querySelector("[data-log]");
    if (!file) return;
    try {
      if (log) log.textContent = "Importing…";
      const data = await call("/csv", {
        method: "POST",
        body: JSON.stringify({ filename: file.name, contentBase64: toBase64(await file.arrayBuffer()) }),
      });
      if (log) log.textContent = data.log || "Done.";
      loadActivity();
    } catch (error) {
      if (log) log.textContent = error.message;
    }
  });

  bindSortable(artList, "art");
  bindSortable(supplyList, "supply");
  boot();
</script>
<script>
  import { libraryCsv, libraryCsvFilename } from "../lib/library-csv.js";

  document.querySelector("[data-export-csv]")?.addEventListener("click", () => {
    const books = JSON.parse(document.getElementById("book-catalog")?.textContent || "[]");
    const csv = libraryCsv(books);
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = libraryCsvFilename();
    document.body.append(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    const status = document.querySelector("[data-status]");
    if (status) {
      const count = books.length;
      status.textContent = `Downloaded ${count} ${count === 1 ? "book" : "books"}. Compare My Rating with a Goodreads export.`;
    }
  });
</script>
</BaseLayout>
