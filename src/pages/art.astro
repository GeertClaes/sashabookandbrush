---
import ArtCard from "../components/ArtCard.astro";
import SupplyCard from "../components/SupplyCard.astro";
import site from "../data/site.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pieces = (await getCollection("art")).sort((a, b) => a.data.order - b.data.order);
const forSale = pieces.filter((piece) => piece.data.available);
const gallery = pieces.filter((piece) => !piece.data.available);
const supplies = (await getCollection("supplies")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Art" description={site.art.lede}>
  <div class="min-h-screen bg-background">
    <div class="mx-auto max-w-5xl px-6 py-16 md:px-12">
      <div class="mb-12 max-w-2xl">
        <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">{site.art.eyebrow}</p>
        <h1 class="font-display mb-4 text-3xl font-semibold leading-tight text-foreground sm:text-4xl md:text-5xl">{site.art.headline}</h1>
        <p class="leading-relaxed text-muted-foreground">{site.art.lede}</p>
      </div>

      {
        forSale.length > 0 && (
          <section class="mb-16">
            <h2 class="font-display mb-2 text-xl font-semibold text-foreground">Originals for sale</h2>
            <p class="mb-6 max-w-xl text-sm leading-relaxed text-muted-foreground">
              Only these. Everything else on this page is display-only.
            </p>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {forSale.map((piece) => (
                <div id={piece.id} class="scroll-mt-24">
                  <ArtCard {...piece.data} />
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        gallery.length > 0 && (
          <section>
            {forSale.length > 0 && (
              <h2 class="font-display mb-6 text-xl font-semibold text-foreground">On the wall</h2>
            )}
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {gallery.map((piece) => (
                <div id={piece.id} class="scroll-mt-24">
                  <ArtCard {...piece.data} />
                </div>
              ))}
            </div>
          </section>
        )
      }

      <p class="mt-8 mb-20 max-w-xl text-sm leading-relaxed text-muted-foreground">
        More paintings as they come off the easel. Until the photos are up, this is the work already
        living on Instagram.
      </p>

      <div id="supplies" class="scroll-mt-24 border-t border-border pt-16">
        <div class="mb-10 max-w-2xl">
          <p class="mb-3 text-xs font-medium tracking-widest text-accent uppercase">
            {site.art.suppliesEyebrow}
          </p>
          <h2 class="font-display mb-4 text-3xl font-semibold leading-tight text-foreground md:text-4xl">
            {site.art.suppliesHeadline}
          </h2>
          <p class="leading-relaxed text-muted-foreground">{site.art.suppliesLede}</p>
          <p class="mt-3 text-[11px] leading-snug text-muted-foreground">
            Affiliate links. I earn a small commission at no extra cost to you.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {
            supplies.map((item) => (
              <div id={item.id} class="h-full scroll-mt-24">
                <SupplyCard {...item.data} slug={item.id} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
