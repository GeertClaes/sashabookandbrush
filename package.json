{
  "name": "sashabookandbrush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-goodreads.mjs --allow-fail && astro build",
    "build:ci": "astro build",
    "preview": "astro preview",
    "import:goodreads": "node scripts/import-goodreads.mjs",
    "sync:goodreads": "node scripts/sync-goodreads.mjs",
    "admin": "node scripts/admin-server.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt \"src/**/*.{astro,ts,js}\" \"scripts/**/*.{js,mjs}\" \"functions/**/*.js\"",
    "format:check": "oxfmt --check \"src/**/*.{astro,ts,js}\" \"scripts/**/*.{js,mjs}\" \"functions/**/*.js\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.8",
    "astro": "^7.4.11",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
